+constexpr size_t MAX_REGISTERED = 4;
+std::array<RegisteredThread, MAX_REGISTERED> registered{};
+std::atomic<size_t> registered_count{0};
+
+template <size_t N>
+std::array<std::uint64_t, N> TakeAll(std::array<std::atomic<std::uint64_t>, N>& values) {
+    std::array<std::uint64_t, N> result{};
+    for (size_t i = 0; i < N; ++i) {
+        result[i] = values[i].exchange(0, std::memory_order_relaxed);
+    }
+    return result;
+}
+
+// Counters and waits only ever grow; readers keep their own previous reading (the report every
+// 10 seconds, the hitch check every frame) and take the difference.
+template <size_t N>
+std::array<std::uint64_t, N> ReadAll(const std::array<std::atomic<std::uint64_t>, N>& values) {
+    std::array<std::uint64_t, N> result{};
+    for (size_t i = 0; i < N; ++i) {
+        result[i] = values[i].load(std::memory_order_relaxed);
+    }
+    return result;
+}
+
+template <size_t N>
+std::array<std::uint64_t, N> Since(const std::array<std::uint64_t, N>& now,
+                                   std::array<std::uint64_t, N>& previous) {
+    std::array<std::uint64_t, N> result{};
+    for (size_t i = 0; i < N; ++i) {
+        result[i] = now[i] - previous[i];
+    }
+    previous = now;
+    return result;
+}
+
+/// A frame that took much longer than it should, and what happened during it.
+struct Hitch {
+    Clock::time_point end;
+    double frame_ms{};
+    /// CPU time the GPU emulation thread used during the frame. Close to frame_ms: that thread
+    /// was the bottleneck. Far below it (and few waits): it sat idle waiting for the game.
+    double gpu_thread_cpu_ms{};
+    /// CPU time the game's own threads (emulated CPU cores) used during the frame, all together.
+    double game_cpu_ms{};
+    std::array<std::uint64_t, static_cast<size_t>(Count::Max)> counts{};
+    std::array<std::uint64_t, static_cast<size_t>(Wait::Max)> waits_ns{};
+};
+constexpr double HITCH_MS = 50.0;
+constexpr size_t MAX_HITCHES = 64;
+constexpr size_t HITCHES_SHOWN = 6;
+/// Guarded by frame_mutex. The longest hitches of the current report window.
+std::vector<Hitch> hitches;
+size_t hitch_count = 0;
+
+/// State of the frame in progress; only the GPU emulation thread touches it (OnGameFrame).
+struct FrameState {
+    bool valid{false};
+    Clock::time_point start;
+    std::uint64_t gpu_thread_cpu_ns{};
+    std::uint64_t game_cpu_ns{};
+    std::array<std::uint64_t, static_cast<size_t>(Count::Max)> counts{};
+    std::array<std::uint64_t, static_cast<size_t>(Wait::Max)> waits_ns{};
+};
+FrameState frame_state;
+
+/// Threads running the game's code (emulated CPU cores).
+constexpr size_t MAX_GAME_THREADS = 8;
+std::array<std::atomic<int>, MAX_GAME_THREADS> game_thread_ids{};
+std::atomic<size_t> game_thread_count{0};
+
+std::uint64_t ThreadCpuNs() {
+#if defined(__linux__) || defined(__ANDROID__)
+    timespec now{};
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &now) == 0) {
+        return static_cast<std::uint64_t>(now.tv_sec) * 1'000'000'000ULL +
+               static_cast<std::uint64_t>(now.tv_nsec);
+    }
+#endif
+    return 0;
+}
+
+/// CPU time used so far by all the game's threads together (ns).
+std::uint64_t GameThreadsCpuNs() {
+    std::uint64_t total = 0;
+#if defined(__linux__) || defined(__ANDROID__)
+    const size_t count = std::min(game_thread_count.load(std::memory_order_relaxed),
+                                  MAX_GAME_THREADS);
+    for (size_t i = 0; i < count; ++i) {
+        const int tid = game_thread_ids[i].load(std::memory_order_acquire);
+        if (tid <= 0) {
+            continue;
+        }
+        // The kernel's per-thread CPU clock of another thread in this process
+        // (MAKE_THREAD_CPUCLOCK(tid, CPUCLOCK_SCHED)).
+        const clockid_t clock = static_cast<clockid_t>((~static_cast<unsigned>(tid) << 3) | 6U);
+        timespec now{};
+        if (clock_gettime(clock, &now) == 0) {
+            total += static_cast<std::uint64_t>(now.tv_sec) * 1'000'000'000ULL +
+                     static_cast<std::uint64_t>(now.tv_nsec);
+        }
+    }
+#endif
+    return total;
+}
+
+std::string ReadFirstLine(const std::string& path) {
+    std::ifstream file(path);
+    std::string line;
+    if (file) {
+        std::getline(file, line);
+    }
+    return line;
+}
+
+#ifdef DORIS_PERF_PROCFS
+struct ThreadTimes {
+    std::string name;
+    unsigned long long ticks{};
+    int cpu{-1};
+};
+
+/// CPU time of every thread of this process, from /proc/self/task/<tid>/stat.
+std::map<int, ThreadTimes> ReadThreads() {
+    std::map<int, ThreadTimes> result;
+    DIR* dir = opendir("/proc/self/task");
+    if (dir == nullptr) {
+        return result;
+    }
+    while (const dirent* entry = readdir(dir)) {
+        if (entry->d_name[0] < '0' || entry->d_name[0] > '9') {
+            continue;
+        }
+        const int tid = std::atoi(entry->d_name);
+        const std::string stat = ReadFirstLine(fmt::format("/proc/self/task/{}/stat", tid));
+        const size_t open = stat.find('(');
+        const size_t close = stat.rfind(')');
+        if (open == std::string::npos || close == std::string::npos || close < open) {
+            continue;
+        }
+        ThreadTimes times;
+        times.name = stat.substr(open + 1, close - open - 1);
+        // Fields after the name, starting with field 3 (state): utime is field 14, stime 15,
+        // processor 39.
+        std::istringstream rest(stat.substr(close + 2));
+        std::vector<std::string> fields;
+        for (std::string field; rest >> field;) {
+            fields.push_back(std::move(field));
+        }
+        if (fields.size() > 36) {
+            times.ticks = std::stoull(fields[11]) + std::stoull(fields[12]);
+            times.cpu = std::atoi(fields[36].c_str());
+        }
+        result.emplace(tid, std::move(times));
+    }
+    closedir(dir);
+    return result;
+}
+
+/// "cpu0-2 1.2/1.8 GHz, ..." for every cpufreq policy (cluster).
+std::string ReadClusters() {
+    std::string out;
+    for (int policy = 0; policy < 16; ++policy) {
+        const std::string base = fmt::format("/sys/devices/system/cpu/cpufreq/policy{}/", policy);
+        const std::string cur = ReadFirstLine(base + "scaling_cur_freq");
+        if (cur.empty()) {
+            continue;
+        }
+        const std::string max = ReadFirstLine(base + "scaling_max_freq");
+        const std::string cpus = ReadFirstLine(base + "related_cpus");
+        const double cur_ghz = std::atof(cur.c_str()) / 1e6;
+        const double max_ghz = std::atof(max.c_str()) / 1e6;
+        out += fmt::format("{}[cpu {}] {:.2f}/{:.2f} GHz", out.empty() ? "" : ", ", cpus, cur_ghz,
+                           max_ghz);
+    }
+    return out.empty() ? "n/a" : out;
+}
+
+/// Adreno load and clock, if the kernel lets apps read them.
+std::string ReadGpu() {
+    std::string out;
+    const std::string busy = ReadFirstLine("/sys/class/kgsl/kgsl-3d0/gpu_busy_percentage");
+    if (!busy.empty()) {
+        out += fmt::format("busy {}", busy);
+    } else {
+        unsigned long long busy_time{}, total_time{};
+        const std::string raw = ReadFirstLine("/sys/class/kgsl/kgsl-3d0/gpubusy");
+        if (std::sscanf(raw.c_str(), "%llu %llu", &busy_time, &total_time) == 2 && total_time) {
+            out += fmt::format("busy {}%", busy_time * 100 / total_time);
+        }
+    }
+    std::string clock = ReadFirstLine("/sys/class/kgsl/kgsl-3d0/gpuclk");
+    if (clock.empty()) {
+        clock = ReadFirstLine("/sys/class/kgsl/kgsl-3d0/devfreq/cur_freq");
+    }
+    if (!clock.empty()) {
+        out += fmt::format("{}{} MHz", out.empty() ? "" : ", ",
+                           static_cast<long long>(std::atof(clock.c_str()) / 1e6));
+    }
+    return out.empty() ? "n/a" : out;
+}
+
+std::string ReadBatteryTemperature() {
+    const std::string raw = ReadFirstLine("/sys/class/power_supply/battery/temp");
+    if (raw.empty()) {
+        return "n/a";
+    }
+    return fmt::format("{:.1f} C", std::atof(raw.c_str()) / 10.0);
+}
+
+/// Kind of every CPU: 0 little, 1 middle, 2 prime (by each cluster's highest clock).
+std::vector<int> ReadCoreKinds() {
+    struct Cluster {
+        std::vector<int> cpus;
+        long long max_khz{};
+    };
+    std::vector<Cluster> clusters;
+    for (int policy = 0; policy < 16; ++policy) {
+        const std::string base = fmt::format("/sys/devices/system/cpu/cpufreq/policy{}/", policy);
+        const std::string max = ReadFirstLine(base + "cpuinfo_max_freq");
+        if (max.empty()) {
+            continue;
+        }
+        Cluster cluster;
+        cluster.max_khz = std::atoll(max.c_str());
+        std::istringstream list(ReadFirstLine(base + "related_cpus"));
+        for (std::string item; list >> item;) {
+            const size_t dash = item.find('-');
+            if (dash == std::string::npos) {
+                cluster.cpus.push_back(std::atoi(item.c_str()));
+            } else {
+                for (int cpu = std::atoi(item.substr(0, dash).c_str());
+                     cpu <= std::atoi(item.substr(dash + 1).c_str()); ++cpu) {
+                    cluster.cpus.push_back(cpu);
+                }
+            }
+        }
+        clusters.push_back(std::move(cluster));
+    }
+    std::vector<int> kinds(64, 1);
+    if (clusters.size() < 2) {
+        return kinds;
+    }
+    long long lowest = clusters.front().max_khz;
+    long long highest = clusters.front().max_khz;
+    for (const auto& cluster : clusters) {
+        lowest = std::min(lowest, cluster.max_khz);
+        highest = std::max(highest, cluster.max_khz);
+    }
+    for (const auto& cluster : clusters) {
+        const int kind = cluster.max_khz == highest ? 2 : (cluster.max_khz == lowest ? 0 : 1);
+        for (const int cpu : cluster.cpus) {
+            if (cpu >= 0 && cpu < static_cast<int>(kinds.size())) {
+                kinds[cpu] = kind;
+            }
+        }
+    }
+    return kinds;
+}
+
+/// The CPU a thread of this process last ran on, or -1.
+int ReadThreadCpu(int tid) {
+    const std::string stat = ReadFirstLine(fmt::format("/proc/self/task/{}/stat", tid));
+    const size_t close = stat.rfind(')');
+    if (close == std::string::npos || close + 2 >= stat.size()) {
+        return -1;
+    }
+    std::istringstream rest(stat.substr(close + 2));
+    std::string field;
+    for (int index = 0; index <= 36 && (rest >> field); ++index) {
+        if (index == 36) {
+            return std::atoi(field.c_str());
+        }
+    }
+    return -1;
+}
+#endif
+
+void ReportLoop() {
+    Common::SetCurrentThreadName("DorisPerf");
+    Common::SetCurrentThreadPriority(Common::ThreadPriority::Low);
+    // Eden (Doris): measuring must never take a big core from the emulator.
+    Common::SetCurrentThreadToEfficiencyCores();
+#ifdef DORIS_PERF_PROCFS
+    const double ticks_per_second = static_cast<double>(sysconf(_SC_CLK_TCK));
+    auto previous_threads = ReadThreads();
+    const std::vector<int> core_kinds = ReadCoreKinds();
+#endif
+    // Work done while the game was loading is not part of any frame.
+    auto counters_seen = ReadAll(counters);
+    auto waits_seen = ReadAll(wait_ns);
+    TakeAll(gpu_ns);
+    auto previous_time = Clock::now();
+    while (true) {
+        // Sample which kind of core the registered threads are on, ten times a second.
+        std::array<std::array<int, 3>, MAX_REGISTERED> placement{};
+        constexpr auto SAMPLE_INTERVAL = std::chrono::milliseconds{100};
+        for (auto waited = Clock::duration{}; waited < REPORT_INTERVAL;
+             waited += SAMPLE_INTERVAL) {
+            std::this_thread::sleep_for(SAMPLE_INTERVAL);
+#ifdef DORIS_PERF_PROCFS
+            const size_t count = std::min(registered_count.load(), MAX_REGISTERED);
+            for (size_t i = 0; i < count; ++i) {
+                const int tid = registered[i].tid.load(std::memory_order_relaxed);
+                const int cpu = tid != 0 ? ReadThreadCpu(tid) : -1;
+                if (cpu >= 0 && cpu < static_cast<int>(core_kinds.size())) {
+                    ++placement[i][core_kinds[cpu]];
+                }
+            }
+#endif
+        }
+        const auto counted = Since(ReadAll(counters), counters_seen);
+        const auto waited = Since(ReadAll(wait_ns), waits_seen);
+        const auto gpu = TakeAll(gpu_ns);
+        const auto gauges_max = TakeAll(gauge_max);
+        std::vector<Clock::time_point> stamps;
+        std::vector<Hitch> window_hitches;
+        size_t window_hitch_count = 0;
+        {
+            std::scoped_lock lock{frame_mutex};
+            stamps.swap(frames);
+            window_hitches.swap(hitches);
+            window_hitch_count = std::exchange(hitch_count, 0);
+        }
+        const auto now = Clock::now();
+        const double seconds = std::chrono::duration<double>(now - previous_time).count();
+        previous_time = now;
+#ifdef DORIS_PERF_PROCFS
+        auto threads = ReadThreads();
+#endif
+        if (stamps.size() < 2 || !kReportOn) {
+#ifdef DORIS_PERF_PROCFS
+            previous_threads = std::move(threads);
+#endif
+            continue;
+        }
+
+        std::vector<double> frame_ms;
+        frame_ms.reserve(stamps.size() - 1);
+        for (size_t i = 1; i < stamps.size(); ++i) {
+            frame_ms.push_back(
+                std::chrono::duration<double, std::milli>(stamps[i] - stamps[i - 1]).count());
+        }
+        const double span_s =
+            std::chrono::duration<double>(stamps.back() - stamps.front()).count();
+        const double fps = span_s > 0 ? static_cast<double>(frame_ms.size()) / span_s : 0.0;
+        const auto slow = std::ranges::count_if(frame_ms, [](double ms) { return ms > 40.0; });
+        std::ranges::sort(frame_ms);
+        const auto pct = [&](double p) {
+            return frame_ms[std::min(frame_ms.size() - 1,
+                                     static_cast<size_t>(p * static_cast<double>(frame_ms.size())))];
+        };
+        // The device's clock time, to match the report with videos of the screen.
+        char clock_text[16] = "?";
+        {
+            const std::time_t now_time = std::time(nullptr);
+            std::tm local{};
+            if (localtime_r(&now_time, &local) != nullptr) {
+                std::strftime(clock_text, sizeof(clock_text), "%H:%M:%S", &local);
+            }
+        }
+        LOG_INFO(Frontend,
+                 "Doris perf: {:.1f} fps | frame ms p50 {:.1f} p95 {:.1f} p99 {:.1f} max {:.1f} | "
+                 "frames over 40 ms: {} | clock {}",
+                 fps, pct(0.50), pct(0.95), pct(0.99), frame_ms.back(), slow, clock_text);
+
+#ifdef DORIS_PERF_PROCFS
+        // CPU time per thread name over the interval, as % of one core; last core it ran on.
+        struct Usage {
+            double percent{};
+            int threads{};
+            int cpu{-1};
+        };
+        std::map<std::string, Usage> usage;
+        double total = 0.0;
+        for (const auto& [tid, times] : threads) {
+            const auto previous = previous_threads.find(tid);
+            const unsigned long long before =
+                previous != previous_threads.end() ? previous->second.ticks : 0ULL;
+            const double percent = static_cast<double>(times.ticks - std::min(times.ticks, before)) /
+                                   ticks_per_second / seconds * 100.0;
+            auto& entry = usage[times.name];
+            entry.percent += percent;
+            entry.threads++;
+            entry.cpu = times.cpu;
+            total += percent;
+        }
+        previous_threads = std::move(threads);
+        std::vector<std::pair<std::string, Usage>> sorted(usage.begin(), usage.end());
+        std::ranges::sort(sorted, [](const auto& a, const auto& b) {
+            return a.second.percent > b.second.percent;
+        });
+        std::string list;
+        for (size_t i = 0; i < sorted.size() && i < 14; ++i) {
+            const auto& [name, use] = sorted[i];
+            if (use.percent < 1.0) {
+                break;
+            }
+            list += fmt::format("{}{}{} {:.0f}% (cpu{})", list.empty() ? "" : ", ", name,
+                                use.threads > 1 ? fmt::format(" x{}", use.threads) : "",
+                                use.percent, use.cpu);
+        }
+        LOG_INFO(Frontend, "Doris perf: CPU total {:.0f}% of one core | {}", total, list);
+        LOG_INFO(Frontend, "Doris perf: clusters {} | GPU {} | battery {}", ReadClusters(),
+                 ReadGpu(), ReadBatteryTemperature());
+#endif
+        const double frame_count = static_cast<double>(stamps.size());
+        const auto per_frame = [&](std::uint64_t value) {
+            return static_cast<double>(value) / frame_count;
+        };
+        const auto ms_per_frame = [&](std::uint64_t ns) {
+            return static_cast<double>(ns) / 1e6 / frame_count;
+        };
+        LOG_INFO(Frontend,
+                 "Doris perf: per frame {:.0f} draws, {:.0f} dispatches, {:.0f} render passes, "
+                 "{:.1f} submits | new pipelines {} | held up per frame: GPU thread by presentation "
+                 "{:.1f} ms and GPU fences {:.1f} ms, Vulkan worker by shader builds {:.1f} ms",
+                 per_frame(counted[static_cast<size_t>(Count::Draws)]),
+                 per_frame(counted[static_cast<size_t>(Count::Dispatches)]),
+                 per_frame(counted[static_cast<size_t>(Count::RenderPasses)]),
+                 per_frame(counted[static_cast<size_t>(Count::Submits)]),
+                 counted[static_cast<size_t>(Count::NewPipelines)],
+                 ms_per_frame(waited[static_cast<size_t>(Wait::PresentFrame)]),
+                 ms_per_frame(waited[static_cast<size_t>(Wait::GpuFence)]),
+                 ms_per_frame(waited[static_cast<size_t>(Wait::Shaders)]));
+        std::string cores;
+        const size_t registered_threads = std::min(registered_count.load(), MAX_REGISTERED);
+        for (size_t i = 0; i < registered_threads; ++i) {
+            const auto& [little, middle, prime] = placement[i];
+            const int samples = std::max(1, little + middle + prime);
+            cores += fmt::format("{}{} prime {}% / middle {}% / little {}%",
+                                 cores.empty() ? "" : ", ", registered[i].label,
+                                 prime * 100 / samples, middle * 100 / samples,
+                                 little * 100 / samples);
+        }
+        LOG_INFO(Frontend,
+                 "Doris perf: per frame {:.2f} MiB uploaded, {:.2f} new staging buffers ({:.2f} "
+                 "MiB), {:.2f} MiB new GPU memory, GPU thread {:.2f} ms getting/freeing GPU "
+                 "memory, {:.1f} ms waiting for the game's commands and {:.2f} ms for the cache "
+                 "locks (held {:.2f} ms by fence handling) | game wrote to pages with GPU-written "
+                 "bytes {} times (copied back first; the game waited {:.1f} ms in all) | NCE "
+                 "pages kept unreadable for GPU drawings {}, the game's reads there {} and "
+                 "writes {} (the drawing copied in first; the game waited {:.1f} ms in all)",
+                 static_cast<double>(counted[static_cast<size_t>(Count::UploadBytes)]) /
+                     (1024.0 * 1024.0) / frame_count,
+                 per_frame(counted[static_cast<size_t>(Count::StagingCreated)]),
+                 static_cast<double>(counted[static_cast<size_t>(Count::StagingCreatedBytes)]) /
+                     (1024.0 * 1024.0) / frame_count,
+                 static_cast<double>(
+                     counted[static_cast<size_t>(Count::GpuMemoryAllocatedBytes)]) /
+                     (1024.0 * 1024.0) / frame_count,
+                 ms_per_frame(waited[static_cast<size_t>(Wait::GpuMemory)]),
+                 ms_per_frame(waited[static_cast<size_t>(Wait::GameCommands)]),
+                 ms_per_frame(waited[static_cast<size_t>(Wait::CacheLock)]),
+                 ms_per_frame(waited[static_cast<size_t>(Wait::FenceFlushes)]),
+                 counted[static_cast<size_t>(Count::GpuWritesKept)],
+                 static_cast<double>(waited[static_cast<size_t>(Wait::KeepGpuWrites)]) / 1e6,
+                 counted[static_cast<size_t>(Count::NceReadProtectedPages)],
+                 counted[static_cast<size_t>(Count::NceGpuPageReads)],
+                 counted[static_cast<size_t>(Count::NceGpuPageWrites)],
+                 static_cast<double>(waited[static_cast<size_t>(Wait::NceGpuReads)]) / 1e6);
+        LOG_INFO(Frontend,
+                 "Doris perf: GPU work per frame {:.1f} ms (frame generation {:.1f} ms, output "
+                 "scaling {:.1f} ms) | cores: {}",
+                 ms_per_frame(gpu[static_cast<size_t>(GpuPart::Total)]),
+                 ms_per_frame(gpu[static_cast<size_t>(GpuPart::FrameGen)]),
+                 ms_per_frame(gpu[static_cast<size_t>(GpuPart::Output)]),
+                 cores.empty() ? "n/a" : cores);
+        const auto count_of = [&](Count counter) {
+            return counted[static_cast<size_t>(counter)];
+        };
+        const auto gauge_of = [&](Gauge gauge) {
+            return gauge_now[static_cast<size_t>(gauge)].load(std::memory_order_relaxed);
+        };
+        LOG_INFO(Frontend,
+                 "Doris perf: per frame {:.0f} worker wake-ups, {:.1f} render passes cut by a "
+                 "submit, {:.1f} protection changes, {:.1f} wait-for-idles ({:.1f} redundant "
+                 "barriers skipped, {:.1f} in an open render pass, {:.1f} with no storage writes by "
+                 "draws since the previous one), {:.1f} tiled-cache barriers | textures: {} "
+                 "uploads ({} over GPU-drawn contents), game writes next to GPU-drawn ones {} "
+                 "(contents kept {}, changed {}), garbage collector removed {} ({} copies back "
+                 "started, {} "
+                 "removals called off, {} with GPU-drawn contents lost) | GPU memory {} MiB (max "
+                 "{}), collection from {} MiB, aggressive from {} MiB",
+                 per_frame(count_of(Count::WorkerWakeups)),
+                 per_frame(count_of(Count::RenderPassSplits)),
+                 per_frame(count_of(Count::ProtectCalls)),
+                 per_frame(count_of(Count::WaitForIdle)),
+                 per_frame(count_of(Count::BarriersSkipped)),
+                 per_frame(count_of(Count::WaitForIdleInRenderPass)),
+                 per_frame(count_of(Count::WaitForIdleNoDrawWrites)),
+                 per_frame(count_of(Count::TiledCacheBarriers)), count_of(Count::TextureUploads),
+                 count_of(Count::TextureUploadsOverGpuData),
+                 count_of(Count::TextureNeighbourWrites), count_of(Count::TextureNeighbourKept),
+                 count_of(Count::TextureNeighbourChanged), count_of(Count::GcRemoved),
+                 count_of(Count::GcDownloaded), count_of(Count::GcCancelled),
+                 count_of(Count::GcDroppedGpuData),
+                 gauge_of(Gauge::TextureCacheMemory),
+                 gauges_max[static_cast<size_t>(Gauge::TextureCacheMemory)],
+                 gauge_of(Gauge::TextureCacheExpected), gauge_of(Gauge::TextureCacheCritical));
+
+        // Which textures lost GPU-drawn contents, and how.
+        {
+            std::array<std::map<std::string, std::uint32_t>, static_cast<size_t>(Note::Max)> taken;
+            {
+                std::scoped_lock lock{note_mutex};
+                taken.swap(notes);
+            }
+            static constexpr std::array<const char*, static_cast<size_t>(Note::Max)> NOTE_NAMES{
+                "uploaded again over GPU-drawn contents",
+                "own bytes changed by the game's code",
+                "removed with GPU-drawn contents lost",
+            };
+            for (size_t kind = 0; kind < taken.size(); ++kind) {
+                if (taken[kind].empty()) {
+                    continue;
+                }
+                std::vector<std::pair<std::string, std::uint32_t>> sorted(taken[kind].begin(),
+                                                                          taken[kind].end());
+                std::ranges::sort(sorted, [](const auto& a, const auto& b) {
+                    return a.second > b.second;
+                });
+                std::string list;
+                for (size_t i = 0; i < sorted.size() && i < 8; ++i) {
+                    list += fmt::format("{}{} x{}", list.empty() ? "" : ", ", sorted[i].first,
+                                        sorted[i].second);
+                }
+                LOG_INFO(Frontend, "Doris textures {}: {}", NOTE_NAMES[kind], list);
+            }
+        }
+
+        // The longest hitches, in the order they happened.
+        std::ranges::sort(window_hitches,
+                          [](const Hitch& a, const Hitch& b) { return a.frame_ms > b.frame_ms; });
+        if (window_hitches.size() > HITCHES_SHOWN) {
+            window_hitches.resize(HITCHES_SHOWN);
+        }
+        std::ranges::sort(window_hitches,
+                          [](const Hitch& a, const Hitch& b) { return a.end < b.end; });
+        for (const Hitch& hitch : window_hitches) {
+            const auto c = [&](Count counter) { return hitch.counts[static_cast<size_t>(counter)]; };
+            const auto w = [&](Wait kind) {
+                return static_cast<double>(hitch.waits_ns[static_cast<size_t>(kind)]) / 1e6;
+            };
+            const auto mib = [&](Count counter) {
+                return static_cast<double>(c(counter)) / (1024.0 * 1024.0);
+            };
+            LOG_INFO(Frontend,
+                     "Doris hitch: {:.0f} ms frame ({:.1f} s before this line; {} over {:.0f} ms "
+                     "in this window) | GPU thread busy {:.0f} ms, waited for the game's "
+                     "commands {:.0f} ms, for the GPU {:.1f} ms, for presentation {:.1f} ms, "
+                     "getting/freeing GPU memory {:.1f} ms, for the cache locks {:.1f} ms (fence "
+                     "handling held them {:.1f} ms); game threads busy {:.0f} ms, waited {:.1f} ms "
+                     "for {} copies of GPU-written bytes; "
+                     "Vulkan worker waited for shaders {:.1f} ms | {} new pipelines, {} texture "
+                     "uploads, "
+                     "{:.1f} MiB uploaded, {} new staging buffers ({:.0f} MiB), {:.0f} MiB new "
+                     "GPU memory, {} textures removed ({} copies back started), {} draws, {} "
+                     "dispatches, {} render passes, {} submits, {} wait-for-idles, {} protection "
+                     "changes, {} worker wake-ups",
+                     hitch.frame_ms, std::chrono::duration<double>(now - hitch.end).count(),
+                     window_hitch_count, HITCH_MS, hitch.gpu_thread_cpu_ms, w(Wait::GameCommands),
+                     w(Wait::GpuFence), w(Wait::PresentFrame), w(Wait::GpuMemory),
+                     w(Wait::CacheLock), w(Wait::FenceFlushes), hitch.game_cpu_ms,
+                     w(Wait::KeepGpuWrites),
+                     c(Count::GpuWritesKept), w(Wait::Shaders), c(Count::NewPipelines),
+                     c(Count::TextureUploads), mib(Count::UploadBytes), c(Count::StagingCreated),
+                     mib(Count::StagingCreatedBytes), mib(Count::GpuMemoryAllocatedBytes),
+                     c(Count::GcRemoved), c(Count::GcDownloaded), c(Count::Draws),
+                     c(Count::Dispatches), c(Count::RenderPasses), c(Count::Submits),
+                     c(Count::WaitForIdle), c(Count::ProtectCalls), c(Count::WorkerWakeups));
+        }
+    }
+}
+
+} // Anonymous namespace
+
+bool Enabled() {
+    return kReportOn;
+}
+
+void Add(Count counter, std::uint64_t amount) {
+    if (!Enabled()) {
+        return;
+    }
+    counters[static_cast<size_t>(counter)].fetch_add(amount, std::memory_order_relaxed);
+}
+
+ScopedWait::ScopedWait(Wait kind_, bool any_thread)
+    : kind{kind_}, active{(any_thread || is_gpu_thread) && Enabled()} {
+    if (active) {
+        start = Clock::now();
+    }
+}
+
+ScopedWait::~ScopedWait() {
+    if (!active) {
+        return;
+    }
+    const auto ns =
+        std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count();
+    wait_ns[static_cast<size_t>(kind)].fetch_add(static_cast<std::uint64_t>(ns),
+                                                std::memory_order_relaxed);
+}
+
+void NoteTexture(Note kind, std::string description) {
+    if (!Enabled()) {
+        return;
+    }
+    std::scoped_lock lock{note_mutex};
+    auto& map = notes[static_cast<size_t>(kind)];
+    if (map.size() < 256 || map.contains(description)) {
+        ++map[std::move(description)];
+    }
+}
+
+void SetGauge(Gauge gauge, std::uint64_t value) {
+    const auto index = static_cast<size_t>(gauge);
+    gauge_now[index].store(value, std::memory_order_relaxed);
+    std::uint64_t seen = gauge_max[index].load(std::memory_order_relaxed);
+    while (value > seen &&
+           !gauge_max[index].compare_exchange_weak(seen, value, std::memory_order_relaxed)) {
+    }
+}
+
+void AddGpuTime(GpuPart part, std::uint64_t nanoseconds) {
+    gpu_ns[static_cast<size_t>(part)].fetch_add(nanoseconds, std::memory_order_relaxed);
+}
+
+void RegisterGameThread() {
+#ifdef DORIS_PERF_PROCFS
+    const size_t index = game_thread_count.fetch_add(1);
+    if (index >= MAX_GAME_THREADS) {
+        return;
+    }
+    game_thread_ids[index].store(static_cast<int>(syscall(SYS_gettid)), std::memory_order_release);
+#endif
+}
+
+void RegisterThread(const char* label) {
+    if (std::strcmp(label, "GPU") == 0) {
+        is_gpu_thread = true;
+    }
+#ifdef DORIS_PERF_PROCFS
+    const size_t index = registered_count.fetch_add(1);
+    if (index >= MAX_REGISTERED) {
+        return;
+    }
+    std::snprintf(registered[index].label, sizeof(registered[index].label), "%s", label);
+    registered[index].tid.store(static_cast<int>(syscall(SYS_gettid)));
+#endif
+}
+
+void OnGameFrame() {
+    if (!kReportOn) {
+        frame_state.valid = false;
+        return;
+    }
+    std::call_once(start_flag, [] { std::thread(ReportLoop).detach(); });
+    // On the GPU emulation thread (this function runs there); does nothing once started for it.
+    Doris::Profiler::StartHitchSampler();
+    const auto now = Clock::now();
+    const auto counts_now = ReadAll(counters);
+    const auto waits_now = ReadAll(wait_ns);
+    const std::uint64_t cpu_now = ThreadCpuNs();
+    const std::uint64_t game_cpu_now = GameThreadsCpuNs();
+    std::optional<Hitch> hitch;
+    double frame_ms = 0.0;
+    if (frame_state.valid) {
+        frame_ms = std::chrono::duration<double, std::milli>(now - frame_state.start).count();
+        if (frame_ms >= HITCH_MS) {
+            hitch.emplace();
+            hitch->end = now;
+            hitch->frame_ms = frame_ms;
+            hitch->gpu_thread_cpu_ms =
+                static_cast<double>(cpu_now - std::min(cpu_now, frame_state.gpu_thread_cpu_ns)) /
+                1e6;
+            hitch->game_cpu_ms =
+                static_cast<double>(game_cpu_now -
+                                    std::min(game_cpu_now, frame_state.game_cpu_ns)) /
+                1e6;
+            hitch->counts = Since(counts_now, frame_state.counts);
+            hitch->waits_ns = Since(waits_now, frame_state.waits_ns);
+        }
+    }
+    Doris::Profiler::HitchFrameBoundary(frame_ms);
+    frame_state.valid = true;
+    frame_state.start = now;
+    frame_state.gpu_thread_cpu_ns = cpu_now;
+    frame_state.game_cpu_ns = game_cpu_now;
+    frame_state.counts = counts_now;
+    frame_state.waits_ns = waits_now;
+
+    std::scoped_lock lock{frame_mutex};
+    if (frames.size() < MAX_FRAMES) {
+        frames.push_back(now);
+    }
+    if (hitch) {
+        ++hitch_count;
+        if (hitches.size() < MAX_HITCHES) {
+            hitches.push_back(*hitch);
+        } else {
+            // Keep the longest ones.
+            auto shortest = std::ranges::min_element(
+                hitches, [](const Hitch& a, const Hitch& b) { return a.frame_ms < b.frame_ms; });
+            if (shortest->frame_ms < hitch->frame_ms) {
+                *shortest = *hitch;
+            }
+        }
+    }
+}
+
+} // namespace Doris::Perf
