+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+namespace Doris::Profiler {
+
+/// Starts sampling the calling thread, if the "CPU profiler" setting is on: about once per
+/// millisecond of CPU time the thread uses (never while it sleeps), its program counter, return
+/// address and call stack (frame-pointer chain, checked against the thread's stack bounds) are
+/// recorded. Every 20 seconds the totals so far are written to doris_profile.txt in the log
+/// folder, as module + offset (plus the nearest exported symbol for system libraries), for
+/// symbolizing against the build's unstripped library.
+/// Only for host threads (GPU, Vulkan worker); never for threads that run guest code.
+void RegisterCurrentThread(const char* label);
+
+/// Hitch sampler, for the GPU emulation thread (called on it): whenever one of its frames has
+/// lasted 40 ms, its call stack is sampled every 2 ms until the frame ends. The stacks of every
+/// frame that ends up longer than 50 ms are written to doris_hitches.txt in the log folder (the
+/// latest 60 hitches), to be symbolized like doris_profile.txt. Costs nothing between hitches.
+void StartHitchSampler();
+/// Called on the same thread before it exits.
+void StopHitchSampler();
+/// Called on the same thread at every frame boundary, with the length of the frame that ended.
+void HitchFrameBoundary(double frame_ms);
+
+} // namespace Doris::Profiler
