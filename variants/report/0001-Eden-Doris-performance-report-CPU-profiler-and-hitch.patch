+// SPDX-FileCopyrightText: Copyright 2026 Eden (Doris)
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "common/doris_profiler.h"
+
+#if (defined(__linux__) || defined(__ANDROID__)) && defined(__aarch64__)
+#define DORIS_PROFILER_ENABLED 1
+#endif
+
+#ifdef DORIS_PROFILER_ENABLED
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <ctime>
+#include <deque>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#include <dlfcn.h>
+#include <pthread.h>
+#include <signal.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#include <fmt/format.h>
+
+#include "common/fs/path_util.h"
+#include "common/logging.h"
+#include "common/settings.h"
+#include "common/thread.h"
+
+namespace Doris::Profiler {
+namespace {
+
+constexpr int MAX_THREADS = 4;
+constexpr uint32_t CAPACITY = 1u << 14;             // samples per buffer
+constexpr long PERIOD_NS = 1'000'000;                // 1 ms of the thread's CPU time
+constexpr auto DRAIN_INTERVAL = std::chrono::seconds{10};
+constexpr int DRAINS_PER_WRITE = 2;                  // write the file every 20 seconds
+constexpr int MAX_DEPTH = 14;                        // pc, lr and up to 12 frame-pointer frames
+constexpr size_t MAX_STACK_ROWS = 8000;
+
+struct Sample {
+    uintptr_t pc;
+    uintptr_t lr;
+    uint32_t depth;                                  // valid entries in frames
+    std::array<uintptr_t, MAX_DEPTH - 2> frames;     // return addresses from the frame chain
+};
+
+struct Slot {
+    char label[32]{};
+    uintptr_t stack_low{};                           // the thread's stack, for safe unwinding
+    uintptr_t stack_high{};
+    std::atomic<uint32_t> active{0};                 // buffer the signal handler writes to
+    std::array<std::atomic<uint32_t>, 2> count{};
+    std::array<std::array<Sample, CAPACITY>, 2> samples{};
+};
+
+std::array<Slot, MAX_THREADS> slots;
+std::atomic<int> slot_count{0};
+std::once_flag start_flag;
+
+void HitchHandler(const ucontext_t* context);
+
+void Handler(int, siginfo_t* info, void* raw_context) {
+    if (info->si_code == SI_TKILL) {
+        // Sent by the hitch sampler's watchdog (pthread_kill), not by a profiler timer.
+        HitchHandler(static_cast<const ucontext_t*>(raw_context));
+        return;
+    }
+    if (info->si_code != SI_TIMER) {
+        return;
+    }
+    const int index = info->si_value.sival_int;
+    if (index < 0 || index >= MAX_THREADS) {
+        return;
+    }
+    const auto* context = static_cast<const ucontext_t*>(raw_context);
+    Slot& slot = slots[index];
+    const uint32_t buffer = slot.active.load(std::memory_order_relaxed) & 1;
+    const uint32_t position = slot.count[buffer].fetch_add(1, std::memory_order_relaxed);
+    if (position >= CAPACITY) {
+        return;
+    }
+    Sample& sample = slot.samples[buffer][position];
+    sample.pc = static_cast<uintptr_t>(context->uc_mcontext.pc);
+    sample.lr = static_cast<uintptr_t>(context->uc_mcontext.regs[30]);
+    // Walk the frame-pointer chain (x29), only through 16-byte aligned records that lie inside
+    // this thread's stack and move strictly upwards, so a bad frame pointer can't fault.
+    uint32_t depth = 0;
+    uintptr_t fp = static_cast<uintptr_t>(context->uc_mcontext.regs[29]);
+    while (depth < sample.frames.size()) {
+        if ((fp & 15) != 0 || fp < slot.stack_low || fp + 16 > slot.stack_high) {
+            break;
+        }
+        const auto* record = reinterpret_cast<const uintptr_t*>(fp);
+        const uintptr_t next = record[0];
+        const uintptr_t ret = record[1];
+        if (ret == 0) {
+            break;
+        }
+        sample.frames[depth++] = ret;
+        if (next <= fp) {
+            break;
+        }
+        fp = next;
+    }
+    sample.depth = depth;
+}
+
+struct Location {
+    std::string module;
+    uintptr_t offset;
+    std::string symbol; // nearest exported symbol, for libraries without our debug info
+};
+
+Location Resolve(uintptr_t address, std::unordered_map<uintptr_t, Location>& cache) {
+    if (const auto it = cache.find(address); it != cache.end()) {
+        return it->second;
+    }
+    Location location{"?", address, {}};
+    Dl_info info{};
+    if (address != 0 && dladdr(reinterpret_cast<void*>(address), &info) != 0 &&
+        info.dli_fname != nullptr) {
+        const std::string path = info.dli_fname;
+        location.module = path.substr(path.find_last_of('/') + 1);
+        location.offset = address - reinterpret_cast<uintptr_t>(info.dli_fbase);
+        if (info.dli_sname != nullptr && location.module.rfind("libyuzu", 0) != 0) {
+            location.symbol = fmt::format("{}+{:#x}", info.dli_sname,
+                                          address - reinterpret_cast<uintptr_t>(info.dli_saddr));
+        }
+    }
+    cache.emplace(address, location);
+    return location;
+}
+
+std::string Describe(uintptr_t address, std::unordered_map<uintptr_t, Location>& cache) {
+    const Location location = Resolve(address, cache);
+    if (!location.symbol.empty()) {
+        return fmt::format("{}:{}", location.module, location.symbol);
+    }
+    return fmt::format("{}+{:#x}", location.module, location.offset);
+}
+
+/// Hash for a call stack (a vector of addresses).
+struct StackHash {
+    size_t operator()(const std::vector<uintptr_t>& stack) const noexcept {
+        size_t hash = 1469598103934665603ULL;
+        for (const uintptr_t address : stack) {
+            hash = (hash ^ address) * 1099511628211ULL;
+        }
+        return hash;
+    }
+};
+
+void WriterLoop() {
+    Common::SetCurrentThreadName("DorisProfiler");
+    Common::SetCurrentThreadPriority(Common::ThreadPriority::Low);
+    // Eden (Doris): measuring must never take a big core from the emulator.
+    Common::SetCurrentThreadToEfficiencyCores();
+    const auto start = std::chrono::steady_clock::now();
+    // Totals since the profiler started, per thread: address -> count, and stack -> count.
+    std::array<std::unordered_map<uintptr_t, uint64_t>, MAX_THREADS> pc_totals, lr_totals;
+    std::array<std::unordered_map<std::vector<uintptr_t>, uint64_t, StackHash>, MAX_THREADS>
+        stack_totals;
+    std::array<uint64_t, MAX_THREADS> sample_totals{};
+    std::unordered_map<uintptr_t, Location> cache;
+    const std::string path =
+        Common::FS::GetEdenPathString(Common::FS::EdenPath::LogDir) + "/doris_profile.txt";
+
+    std::vector<uintptr_t> stack;
+    for (int drains = 1;; ++drains) {
+        std::this_thread::sleep_for(DRAIN_INTERVAL);
+        const int threads = std::min(slot_count.load(), MAX_THREADS);
+        for (int index = 0; index < threads; ++index) {
+            Slot& slot = slots[index];
+            const uint32_t old = slot.active.fetch_xor(1) & 1;
+            std::this_thread::sleep_for(std::chrono::milliseconds{2});
+            const uint32_t taken = std::min(slot.count[old].load(), CAPACITY);
+            for (uint32_t i = 0; i < taken; ++i) {
+                const Sample& sample = slot.samples[old][i];
+                ++pc_totals[index][sample.pc];
+                ++lr_totals[index][sample.lr];
+                // Stack, innermost first: pc, lr (unless the frame chain already starts with
+                // it), then the frame chain.
+                stack.clear();
+                stack.push_back(sample.pc);
+                const uint32_t depth = std::min<uint32_t>(sample.depth, MAX_DEPTH - 2);
+                if (depth == 0 || sample.frames[0] != sample.lr) {
+                    stack.push_back(sample.lr);
+                }
+                for (uint32_t frame = 0; frame < depth; ++frame) {
+                    stack.push_back(sample.frames[frame]);
+                }
+                ++stack_totals[index][stack];
+            }
+            sample_totals[index] += taken;
+            slot.count[old].store(0);
+        }
+        if (drains % DRAINS_PER_WRITE != 0) {
+            continue;
+        }
+
+        std::ofstream file(path, std::ios::trunc);
+        if (!file) {
+            LOG_WARNING(Frontend, "Doris profiler: could not write {}", path);
+            continue;
+        }
+        const auto seconds =
+            std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now() -
+                                                             start)
+                .count();
+        file << fmt::format("# Doris profile v2: {} s, one sample per ms of CPU time\n", seconds);
+        for (int index = 0; index < threads; ++index) {
+            const auto write_table = [&](const char* kind,
+                                         const std::unordered_map<uintptr_t, uint64_t>& totals) {
+                // Fold addresses into module + offset, then sort by count.
+                std::map<std::pair<std::string, uintptr_t>, uint64_t> folded;
+                std::map<std::pair<std::string, uintptr_t>, std::string> symbols;
+                for (const auto& [address, count] : totals) {
+                    const Location location = Resolve(address, cache);
+                    folded[{location.module, location.offset}] += count;
+                    if (!location.symbol.empty()) {
+                        symbols[{location.module, location.offset}] = location.symbol;
+                    }
+                }
+                std::vector<std::pair<uint64_t, std::pair<std::string, uintptr_t>>> rows;
+                rows.reserve(folded.size());
+                for (const auto& [key, count] : folded) {
+                    rows.emplace_back(count, key);
+                }
+                std::ranges::sort(rows, [](const auto& a, const auto& b) { return a.first > b.first; });
+                file << fmt::format("[{} {}] samples {}\n", slots[index].label, kind,
+                                    sample_totals[index]);
+                for (size_t i = 0; i < rows.size() && i < 4000; ++i) {
+                    const auto symbol = symbols.find(rows[i].second);
+                    file << fmt::format("{} {:#x} {}{}{}\n", rows[i].second.first,
+                                        rows[i].second.second, rows[i].first,
+                                        symbol != symbols.end() ? " " : "",
+                                        symbol != symbols.end() ? symbol->second : "");
+                }
+            };
+            write_table("pc", pc_totals[index]);
+            write_table("lr", lr_totals[index]);
+
+            // Call stacks, innermost first, most frequent first.
+            std::vector<std::pair<uint64_t, const std::vector<uintptr_t>*>> stacks;
+            stacks.reserve(stack_totals[index].size());
+            for (const auto& [frames, count] : stack_totals[index]) {
+                stacks.emplace_back(count, &frames);
+            }
+            std::ranges::sort(stacks, [](const auto& a, const auto& b) { return a.first > b.first; });
+            file << fmt::format("[{} stacks] samples {} unique {}\n", slots[index].label,
+                                sample_totals[index], stacks.size());
+            for (size_t i = 0; i < stacks.size() && i < MAX_STACK_ROWS; ++i) {
+                std::string line = std::to_string(stacks[i].first);
+                for (const uintptr_t address : *stacks[i].second) {
+                    line += ' ';
+                    line += Describe(address, cache);
+                }
+                file << line << '\n';
+            }
+        }
+        LOG_INFO(Frontend, "Doris profiler: wrote {} ({} s)", path, seconds);
+    }
+}
+
+
+std::once_flag handler_flag;
+
+void InstallHandler() {
+    std::call_once(handler_flag, [] {
+        struct sigaction action {};
+        action.sa_sigaction = Handler;
+        action.sa_flags = SA_SIGINFO | SA_RESTART;
+        sigemptyset(&action.sa_mask);
+        sigaction(SIGPROF, &action, nullptr);
+    });
+}
+
+// ---- Hitch sampler -------------------------------------------------------------------------
+
+constexpr auto HITCH_ARM_AFTER = std::chrono::milliseconds{40};
+constexpr auto HITCH_SAMPLE_EVERY = std::chrono::milliseconds{2};
+constexpr double HITCH_MIN_MS = 50.0;
+constexpr uint32_t HITCH_CAPACITY = 4096;   // samples in the ring (8 s of sampling)
+constexpr size_t HITCHES_KEPT = 60;
+constexpr auto HITCH_WRITE_INTERVAL = std::chrono::seconds{10};
+
+struct HitchSampler {
+    /// The sampled thread (the current GPU emulation thread) while active.
+    std::atomic<int> tid{0};
+    uintptr_t stack_low{};
+    uintptr_t stack_high{};
+    std::atomic<bool> active{false};
+    /// Start of the frame in progress (steady clock, ns) and its number.
+    std::atomic<int64_t> frame_start_ns{0};
+    std::atomic<uint32_t> frame_id{0};
+    /// Ring of samples; written only by the signal handler on the sampled thread.
+    std::array<Sample, HITCH_CAPACITY> samples{};
+    std::atomic<uint32_t> write_pos{0};
+    uint32_t frame_first_pos{0}; // sampled thread only
+};
+HitchSampler hitch;
+
+struct FinishedHitch {
+    double frame_ms;
+    std::chrono::steady_clock::time_point when;
+    std::vector<Sample> samples;
+};
+std::mutex finished_mutex;
+std::deque<FinishedHitch> finished_hitches;
+bool finished_dirty = false;
+
+int64_t NowNs() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+int CurrentTid() {
+    // bionic keeps the thread id in thread-local storage (no system call, signal safe).
+    return static_cast<int>(gettid());
+}
+
+void HitchHandler(const ucontext_t* context) {
+    // Only ever sample the thread the sampler was started on (its stack bounds are known).
+    if (!hitch.active.load(std::memory_order_acquire) ||
+        CurrentTid() != hitch.tid.load(std::memory_order_relaxed)) {
+        return;
+    }
+    const uint32_t position = hitch.write_pos.load(std::memory_order_relaxed);
+    Sample& sample = hitch.samples[position % HITCH_CAPACITY];
+    sample.pc = static_cast<uintptr_t>(context->uc_mcontext.pc);
+    sample.lr = static_cast<uintptr_t>(context->uc_mcontext.regs[30]);
+    uint32_t depth = 0;
+    uintptr_t fp = static_cast<uintptr_t>(context->uc_mcontext.regs[29]);
+    while (depth < sample.frames.size()) {
+        if ((fp & 15) != 0 || fp < hitch.stack_low || fp + 16 > hitch.stack_high) {
+            break;
+        }
+        const auto* record = reinterpret_cast<const uintptr_t*>(fp);
+        const uintptr_t next = record[0];
+        const uintptr_t ret = record[1];
+        if (ret == 0) {
+            break;
+        }
+        sample.frames[depth++] = ret;
+        if (next <= fp) {
+            break;
+        }
+        fp = next;
+    }
+    sample.depth = depth;
+    hitch.write_pos.store(position + 1, std::memory_order_release);
+}
+
+/// Wakes up when the current frame turns 40 ms old, then samples the thread every 2 ms until
+/// the frame ends. Between hitches it wakes about once per frame and does nothing else.
+void HitchWatchdogLoop() {
+    Common::SetCurrentThreadName("DorisHitches");
+    Common::SetCurrentThreadToEfficiencyCores();
+    std::unordered_map<uintptr_t, Location> cache;
+    const std::string path =
+        Common::FS::GetEdenPathString(Common::FS::EdenPath::LogDir) + "/doris_hitches.txt";
+    auto last_write = std::chrono::steady_clock::now();
+    std::deque<FinishedHitch> kept;
+    size_t total_hitches = 0;
+    const auto start = std::chrono::steady_clock::now();
+    std::vector<uintptr_t> stack;
+    while (true) {
+        if (!hitch.active.load(std::memory_order_acquire)) {
+            std::this_thread::sleep_for(std::chrono::milliseconds{100});
+            continue;
+        }
+        const uint32_t id = hitch.frame_id.load(std::memory_order_acquire);
+        const int64_t frame_start = hitch.frame_start_ns.load(std::memory_order_acquire);
+        const auto armed_at = std::chrono::steady_clock::time_point{
+            std::chrono::nanoseconds{frame_start}} + HITCH_ARM_AFTER;
+        if (std::chrono::steady_clock::now() < armed_at) {
+            std::this_thread::sleep_until(armed_at);
+        }
+        // Sample while the same frame is still running (for at most 2 seconds: longer means
+        // emulation is paused or loading, not a hitch).
+        constexpr int64_t SAMPLE_AT_MOST_NS = 2'000'000'000;
+        while (hitch.frame_id.load(std::memory_order_acquire) == id &&
+               hitch.active.load(std::memory_order_acquire)) {
+            if (NowNs() - frame_start > SAMPLE_AT_MOST_NS) {
+                std::this_thread::sleep_for(std::chrono::milliseconds{50});
+                continue;
+            }
+            // tgkill, not pthread_kill: if the thread has just exited this fails harmlessly.
+            syscall(SYS_tgkill, static_cast<int>(getpid()), hitch.tid.load(), SIGPROF);
+            std::this_thread::sleep_for(HITCH_SAMPLE_EVERY);
+        }
+        // Collect finished hitches and write them out now and then.
+        {
+            std::scoped_lock lock{finished_mutex};
+            while (!finished_hitches.empty()) {
+                kept.push_back(std::move(finished_hitches.front()));
+                finished_hitches.pop_front();
+                ++total_hitches;
+                if (kept.size() > HITCHES_KEPT) {
+                    kept.pop_front();
+                }
+            }
+            if (!finished_dirty ||
+                std::chrono::steady_clock::now() - last_write < HITCH_WRITE_INTERVAL) {
+                continue;
+            }
+            finished_dirty = false;
+        }
+        last_write = std::chrono::steady_clock::now();
+        std::ofstream file(path, std::ios::trunc);
+        if (!file) {
+            continue;
+        }
+        file << fmt::format("# Doris hitch stacks v1: GPU emulation thread, one sample every {} "
+                            "ms once a frame has lasted {} ms; {} hitches so far, the latest {} "
+                            "below (seconds since the game started)\n",
+                            HITCH_SAMPLE_EVERY.count(), HITCH_ARM_AFTER.count(), total_hitches,
+                            kept.size());
+        for (const FinishedHitch& finished : kept) {
+            std::unordered_map<std::vector<uintptr_t>, uint64_t, StackHash> stacks;
+            for (const Sample& sample : finished.samples) {
+                stack.clear();
+                stack.push_back(sample.pc);
+                const uint32_t depth = std::min<uint32_t>(sample.depth, MAX_DEPTH - 2);
+                if (depth == 0 || sample.frames[0] != sample.lr) {
+                    stack.push_back(sample.lr);
+                }
+                for (uint32_t frame = 0; frame < depth; ++frame) {
+                    stack.push_back(sample.frames[frame]);
+                }
+                ++stacks[stack];
+            }
+            std::vector<std::pair<uint64_t, const std::vector<uintptr_t>*>> sorted;
+            for (const auto& [frames, count] : stacks) {
+                sorted.emplace_back(count, &frames);
+            }
+            std::ranges::sort(sorted, [](const auto& a, const auto& b) { return a.first > b.first; });
+            file << fmt::format(
+                "[hitch {:.0f} ms at {:.1f} s] samples {}\n", finished.frame_ms,
+                std::chrono::duration<double>(finished.when - start).count(),
+                finished.samples.size());
+            for (size_t i = 0; i < sorted.size() && i < 40; ++i) {
+                std::string line = std::to_string(sorted[i].first);
+                for (const uintptr_t address : *sorted[i].second) {
+                    line += ' ';
+                    line += Describe(address, cache);
+                }
+                file << line << '\n';
+            }
+        }
+    }
+}
+
+std::once_flag hitch_watchdog_flag;
+
+} // Anonymous namespace
+
+void StartHitchSampler() {
+    const int me = CurrentTid();
+    if (hitch.active.load() && hitch.tid.load() == me) {
+        return;
+    }
+    hitch.active.store(false);
+    pthread_attr_t attributes;
+    if (pthread_getattr_np(pthread_self(), &attributes) == 0) {
+        void* stack_address = nullptr;
+        size_t stack_size = 0;
+        if (pthread_attr_getstack(&attributes, &stack_address, &stack_size) == 0) {
+            hitch.stack_low = reinterpret_cast<uintptr_t>(stack_address);
+            hitch.stack_high = hitch.stack_low + stack_size;
+        }
+        pthread_attr_destroy(&attributes);
+    }
+    InstallHandler();
+    hitch.frame_first_pos = hitch.write_pos.load();
+    hitch.frame_start_ns.store(NowNs(), std::memory_order_release);
+    hitch.frame_id.fetch_add(1);
+    hitch.tid.store(me);
+    hitch.active.store(true, std::memory_order_release);
+    std::call_once(hitch_watchdog_flag, [] { std::thread(HitchWatchdogLoop).detach(); });
+    LOG_INFO(Frontend, "Doris: hitch sampler on (doris_hitches.txt)");
+}
+
+void StopHitchSampler() {
+    if (hitch.tid.load() == CurrentTid()) {
+        hitch.active.store(false, std::memory_order_release);
+    }
+}
+
+void HitchFrameBoundary(double frame_ms) {
+    if (!hitch.active.load(std::memory_order_relaxed) ||
+        hitch.tid.load(std::memory_order_relaxed) != CurrentTid()) {
+        return;
+    }
+    // A new frame starts: the watchdog stops sampling the old one.
+    hitch.frame_start_ns.store(NowNs(), std::memory_order_release);
+    hitch.frame_id.fetch_add(1, std::memory_order_acq_rel);
+    const uint32_t end = hitch.write_pos.load(std::memory_order_acquire);
+    const uint32_t first = hitch.frame_first_pos;
+    hitch.frame_first_pos = end;
+    if (frame_ms < HITCH_MIN_MS || end == first || end - first > HITCH_CAPACITY) {
+        return;
+    }
+    FinishedHitch finished{frame_ms, std::chrono::steady_clock::now(), {}};
+    finished.samples.reserve(end - first);
+    for (uint32_t position = first; position != end; ++position) {
+        finished.samples.push_back(hitch.samples[position % HITCH_CAPACITY]);
+    }
+    std::scoped_lock lock{finished_mutex};
+    finished_hitches.push_back(std::move(finished));
+    if (finished_hitches.size() > HITCHES_KEPT) {
+        finished_hitches.pop_front();
+    }
+    finished_dirty = true;
+}
+
+void RegisterCurrentThread(const char* label) {
+    if (false) { // Eden (Doris): this build always runs the CPU profiler (no setting).
+        return;
+    }
+    InstallHandler();
+    std::call_once(start_flag, [] { std::thread(WriterLoop).detach(); });
+    const int index = slot_count.fetch_add(1);
+    if (index >= MAX_THREADS) {
+        return;
+    }
+    std::snprintf(slots[index].label, sizeof(slots[index].label), "%s", label);
+    pthread_attr_t attributes;
+    if (pthread_getattr_np(pthread_self(), &attributes) == 0) {
+        void* stack_address = nullptr;
+        size_t stack_size = 0;
+        if (pthread_attr_getstack(&attributes, &stack_address, &stack_size) == 0) {
+            slots[index].stack_low = reinterpret_cast<uintptr_t>(stack_address);
+            slots[index].stack_high = slots[index].stack_low + stack_size;
+        }
+        pthread_attr_destroy(&attributes);
+    }
+
+    clockid_t clock{};
+    if (pthread_getcpuclockid(pthread_self(), &clock) != 0) {
+        LOG_WARNING(Frontend, "Doris profiler: no CPU clock for {}", label);
+        return;
+    }
+    sigevent event{};
+    event.sigev_notify = SIGEV_THREAD_ID;
+    event.sigev_signo = SIGPROF;
+    event.sigev_value.sival_int = index;
+#ifdef sigev_notify_thread_id
+    event.sigev_notify_thread_id = static_cast<pid_t>(syscall(SYS_gettid));
+#else
+    event._sigev_un._tid = static_cast<pid_t>(syscall(SYS_gettid));
+#endif
+    timer_t timer{};
+    if (timer_create(clock, &event, &timer) != 0) {
+        LOG_WARNING(Frontend, "Doris profiler: could not create the timer for {}", label);
+        return;
+    }
+    itimerspec spec{};
+    spec.it_interval.tv_nsec = PERIOD_NS;
+    spec.it_value.tv_nsec = PERIOD_NS;
+    timer_settime(timer, 0, &spec, nullptr);
+    LOG_INFO(Frontend, "Doris profiler: sampling thread {}", label);
+}
+
+} // namespace Doris::Profiler
+
+#else
+
+namespace Doris::Profiler {
+void RegisterCurrentThread(const char*) {}
+void StartHitchSampler() {}
+void StopHitchSampler() {}
+void HitchFrameBoundary(double) {}
+} // namespace Doris::Profiler
+
+#endif
