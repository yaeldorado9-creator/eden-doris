+++ b/src/common/doris_perf.h
@@ -0,0 +1,179 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden (Doris)
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <chrono>
+#include <string>
+#include <cstdint>
+
+namespace Doris::Perf {
+
+/// Called once for every frame the game renders. When the "Performance report" setting is on,
+/// the first call starts a low-priority thread that writes a summary to the log every 10 seconds:
+/// frame times, CPU time per emulator thread (and the core it last ran on), CPU cluster and GPU
+/// clocks, GPU load and battery temperature, plus the counters and timers below, and the longest
+/// hitches (frames over 50 ms) with what happened in each. Called on the GPU emulation thread.
+void OnGameFrame();
+
+/// True while the "Performance report" setting is on.
+bool Enabled();
+
+/// Work counted per game frame.
+enum class Count : int {
+    Draws,
+    Dispatches,
+    RenderPasses,
+    Submits,
+    NewPipelines,
+    /// The Vulkan worker had to be woken up for new work.
+    WorkerWakeups,
+    /// A submission had to end an open render pass (costly on tiled GPUs).
+    RenderPassSplits,
+    /// Textures uploaded from guest memory (new, or written by the game's CPU code).
+    TextureUploads,
+    /// ... of which the GPU had drawn into the texture before (the upload replaces that).
+    TextureUploadsOverGpuData,
+    /// Textures the texture cache's garbage collector removed.
+    GcRemoved,
+    /// ... that it first copied back to guest memory (each one waits for the GPU to finish).
+    GcDownloaded,
+    /// ... that the GPU had drawn into but could not be copied back (their contents are lost).
+    GcDroppedGpuData,
+    /// The game's code wrote to a page shared with a GPU-drawn texture (NCE write fault).
+    TextureNeighbourWrites,
+    /// ... and at the texture's next use its own bytes were unchanged (GPU contents kept).
+    TextureNeighbourKept,
+    /// ... or changed (uploaded again from guest memory, as Eden always did).
+    TextureNeighbourChanged,
+    /// Doris cleanup: removals called off because the texture was used or changed meanwhile.
+    GcCancelled,
+    /// Full barriers skipped because nothing was recorded since the previous one.
+    BarriersSkipped,
+    /// Bytes handed to the GPU through upload staging memory (textures, buffers).
+    UploadBytes,
+    /// Staging buffers newly created (each one is fresh memory the kernel has to provide).
+    StagingCreated,
+    StagingCreatedBytes,
+    /// GPU memory allocated for textures and buffers.
+    GpuMemoryAllocatedBytes,
+    /// The game's code wrote to a page holding GPU-written bytes, which were copied back first.
+    GpuWritesKept,
+    /// Memory protection changes for CPU write tracking.
+    ProtectCalls,
+    /// The game's "wait for idle" GPU commands.
+    WaitForIdle,
+    /// ... that came while a render pass was open (it has to be ended for the barrier).
+    WaitForIdleInRenderPass,
+    /// ... with no draw since the previous one that wrote storage buffers or images, or used
+    /// transform feedback (compute, uploads and copies have barriers of their own).
+    WaitForIdleNoDrawWrites,
+    /// The game's tiled-cache barriers.
+    TiledCacheBarriers,
+    /// NCE: pages made unreadable because a GPU drawing covers them (doris_nce_gpu_reads).
+    NceReadProtectedPages,
+    /// ... reads by the game's code that stopped there (the drawing was copied in first).
+    NceGpuPageReads,
+    /// ... and writes (copied in, then the usual invalidation).
+    NceGpuPageWrites,
+    Max,
+};
+
+/// Values that are sampled rather than counted.
+enum class Gauge : int {
+    /// GPU memory in use, as the texture cache sees it (MiB).
+    TextureCacheMemory,
+    /// The texture cache starts removing old textures above this (MiB).
+    TextureCacheExpected,
+    /// ... and removes them aggressively above this (MiB).
+    TextureCacheCritical,
+    Max,
+};
+
+/// Sets a gauge (the report shows the latest and the highest value of each window).
+void SetGauge(Gauge gauge, std::uint64_t value);
+
+/// Adds to a counter. Cheap (one relaxed atomic add); does nothing while the report is off.
+void Add(Count counter, std::uint64_t amount = 1);
+
+/// Places where the GPU emulation thread can be held up.
+enum class Wait : int {
+    /// Waiting for a free presentation frame (the display or frame generation is behind).
+    PresentFrame,
+    /// Vulkan worker waiting for a shader/pipeline the frame needs to finish building (the GPU
+    /// gets no new work meanwhile).
+    Shaders,
+    /// Waiting for the GPU to reach a point (fences, synchronization with the game).
+    GpuFence,
+    /// Getting or freeing GPU memory (textures, buffers, staging memory).
+    GpuMemory,
+    /// The GPU emulation thread waiting for the texture and buffer cache locks (another thread
+    /// holds them).
+    CacheLock,
+    /// The game's code waiting (any thread) while GPU-written bytes on a page it writes to are
+    /// copied back first (Eden #4490/#4531).
+    KeepGpuWrites,
+    /// Finished GPU-to-guest copies being written out (fence thread) while holding the texture and
+    /// buffer cache locks.
+    FenceFlushes,
+    /// The game's code waiting (any thread) while a GPU drawing it reads is copied into guest
+    /// memory (NCE, doris_nce_gpu_reads).
+    NceGpuReads,
+    /// The GPU emulation thread waiting for the game to send GPU commands.
+    GameCommands,
+    Max,
+};
+
+/// Kinds of texture events the report names textures for (size and format, most frequent first).
+enum class Note : int {
+    /// Uploaded again from guest memory over contents the GPU had drawn.
+    UploadOverGpuData,
+    /// The game's code changed bytes of a GPU-drawn texture (on a page it wrote to).
+    NeighbourChanged,
+    /// Removed by the garbage collector with GPU-drawn contents that could not be copied back.
+    GcLostGpuData,
+    Max,
+};
+
+/// Notes a texture event (does nothing while the report is off).
+void NoteTexture(Note kind, std::string description);
+
+/// Measures wall time spent in a scope: on the GPU emulation thread only, or on any thread when
+/// any_thread is true.
+class ScopedWait {
+public:
+    explicit ScopedWait(Wait kind, bool any_thread = false);
+    ~ScopedWait();
+
+    ScopedWait(const ScopedWait&) = delete;
+    ScopedWait& operator=(const ScopedWait&) = delete;
+
+private:
+    Wait kind;
+    bool active;
+    std::chrono::steady_clock::time_point start;
+};
+
+/// Parts of the GPU's own work, measured with GPU timestamps.
+enum class GpuPart : int {
+    /// Every command buffer (all GPU work).
+    Total,
+    /// Scaling the game's image to the screen (FSR etc.).
+    Output,
+    /// Frame generation (Lossless Scaling).
+    FrameGen,
+    Max,
+};
+
+/// Adds measured GPU time.
+void AddGpuTime(GpuPart part, std::uint64_t nanoseconds);
+
+/// Remembers the calling thread (GPU emulation thread or Vulkan worker) so the report can say
+/// which kind of core it mostly ran on.
+void RegisterThread(const char* label);
+
+/// Remembers a thread that runs the game's code (emulated CPU core), so a hitch can say how
+/// busy the game's own threads were during it.
+void RegisterGameThread();
+
+} // namespace Doris::Perf
