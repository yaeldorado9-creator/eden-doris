From e49e3ba86ab7babe8ecf7914aaf89cfe388bdb86 Mon Sep 17 00:00:00 2001
From: alvindimas05 <alvin.dimas.praditya@gmail.com>
Date: Fri, 23 Oct 2026 00:11:29 +0700
Subject: [PATCH 03/15] memoize last sampler variant in HandleFor

(cherry picked from commit 0ae08024640438802703c666c4625260c95c82a8)
---
 src/video_core/renderer_vulkan/vk_texture_cache.cpp | 10 +++++++++-
 src/video_core/renderer_vulkan/vk_texture_cache.h   |  2 ++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/video_core/renderer_vulkan/vk_texture_cache.cpp b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
index c3f56408b5..e2dac0fc66 100644
--- a/src/video_core/renderer_vulkan/vk_texture_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
@@ -2948,10 +2948,18 @@ VkSampler Sampler::HandleFor(const ImageView& image_view, bool is_depth) {
         key.srgb_border = false;
         key.swizzle = {};
     }
+    if (last_sampler != VK_NULL_HANDLE && key == last_key) [[likely]] {
+        return last_sampler;
+    }
     if (const VkSampler existing = Find(key); existing != VK_NULL_HANDLE) {
+        last_key = key;
+        last_sampler = existing;
         return existing;
     }
-    return Emplace(key);
+    const VkSampler created = Emplace(key);
+    last_key = key;
+    last_sampler = created;
+    return created;
 }
 
 Framebuffer::Framebuffer(TextureCacheRuntime& runtime, std::span<ImageView*, NUM_RT> color_buffers,
diff --git a/src/video_core/renderer_vulkan/vk_texture_cache.h b/src/video_core/renderer_vulkan/vk_texture_cache.h
index 1b1e35aa45..f8a8488d5d 100644
--- a/src/video_core/renderer_vulkan/vk_texture_cache.h
+++ b/src/video_core/renderer_vulkan/vk_texture_cache.h
@@ -562,6 +562,8 @@ private:
 
     CustomBorderColorBudget custom_border_color_budget;
     std::vector<Variant> variants;
+    VariantKey last_key{};
+    VkSampler last_sampler{VK_NULL_HANDLE};
 
     const Device* device_ptr{nullptr};
     VkSamplerCreateInfo base_ci{};
-- 
