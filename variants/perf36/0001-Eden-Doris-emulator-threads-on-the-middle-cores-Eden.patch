@@ -0,0 +1,22 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden (Doris)
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+namespace Doris::Cores {
+
+enum class Role {
+    /// Eden's main GPU emulation thread.
+    Gpu,
+    /// Other heavy emulator threads (emulated CPU cores, Vulkan worker, presentation, fences,
+    /// timing).
+    Worker,
+};
+
+/// Keeps the calling thread on the middle cores (the big cores other than the prime one): off the
+/// little cores, where the busy emulator threads would be slow, and off the prime core, which runs
+/// hotter (Yael's Thor already gets hot). Nothing changes on a single-cluster CPU or without
+/// sched_setaffinity.
+void PinCurrentThread(Role role);
+
+} // namespace Doris::Cores
