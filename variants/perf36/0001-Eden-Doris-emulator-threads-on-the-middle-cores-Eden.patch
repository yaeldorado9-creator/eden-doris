+            mask = &state.efficiency;
+            break;
+        case CoreGroup::Prime:
+            mask = tiers ? &state.prime : &state.performance;
+            break;
+        case CoreGroup::Middle:
+            mask = tiers ? &state.middle : &state.performance;
