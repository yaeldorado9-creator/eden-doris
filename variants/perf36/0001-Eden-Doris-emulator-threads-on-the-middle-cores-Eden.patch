+void SetCurrentThreadToDorisCores(bool fastest) {
+#if defined(__ANDROID__)
+    SetCurrentThreadCoreGroup(fastest ? CoreGroup::Prime : CoreGroup::Middle);
+#else
+    (void)fastest;
+#endif
+}
+
+void SetCurrentThreadToPerformanceCoresOnly() {
+#if defined(__ANDROID__)
+    SetCurrentThreadCoreGroup(CoreGroup::Performance);
+#endif
+}
+
