@@ -0,0 +1,25 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden (Doris)
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "common/doris_cores.h"
+
+#include <atomic>
+
+#include "common/logging.h"
+#include "common/thread.h"
+
+namespace Doris::Cores {
+
+void PinCurrentThread(Role role) {
+    // Goes through Eden's own core groups, so its periodic policy refresh keeps the placement
+    // instead of undoing it. Every role goes to the middle cores: no extra heat from the prime core.
+    Common::SetCurrentThreadToDorisCores(false);
+    static std::atomic<unsigned> logged{0};
+    const unsigned bit = 1u << static_cast<unsigned>(role);
+    if ((logged.fetch_or(bit) & bit) == 0) {
+        LOG_INFO(Frontend, "Doris cores: {} threads placed on the middle cores",
+                 role == Role::Gpu ? "GPU" : "other emulator");
+    }
+}
+
+} // namespace Doris::Cores
