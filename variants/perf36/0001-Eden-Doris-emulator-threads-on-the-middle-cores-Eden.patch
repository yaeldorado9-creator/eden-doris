@@ -295,6 +306,20 @@ void ComputeTopologyLocked(CpuTopologyState& state) {
         return;
     }
 
+    // Eden (Doris): split the performance cores into the fastest ones and the rest.
+    for (const auto& core : cores) {
+        if (core.weight == fastest && CPU_ISSET(core.cpu, &state.performance)) {
+            CPU_SET(core.cpu, &state.prime);
+        }
+    }
+    for (s32 cpu = 0; cpu < total; ++cpu) {
+        if (CPU_ISSET(cpu, &state.performance) && !CPU_ISSET(cpu, &state.prime)) {
+            CPU_SET(cpu, &state.middle);
+        }
+    }
+    LOG_INFO(Common, "CPU topology: {} prime cores, {} middle cores", CPU_COUNT(&state.prime),
+             CPU_COUNT(&state.middle));
