From 743920562d1719e436bfe9460489325148bdc654 Mon Sep 17 00:00:00 2001
From: Eden-Doris <doris@localhost>
Date: Sun, 1 Nov 2026 00:53:04 -0500
Subject: [PATCH 4/4] Eden (Doris): texture cleanup waits for the GPU once per
 pass, not once per texture

Eden's texture garbage collector copies textures the GPU drew into back to guest memory before
removing them, and waited for the GPU to finish everything queued for each one: in a TotK report,
up to 2059 of those waits in 10 seconds when entering a busy area, 19.5 ms of every frame spent
waiting. Now those textures are copied together and the pass waits once; they are written back and
removed in the same order and in the same pass, with Eden's collection rules unchanged. Backends whose
staging maps own a resource (OpenGL) keep Eden's per-texture path. (From Doris build 15, without its
profiler setting change.)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014Ps8wnhVXtSU7d88gGtyHX
---
 src/video_core/texture_cache/texture_cache.h | 94 +++++++++++++++++---
 1 file changed, 81 insertions(+), 13 deletions(-)

diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index c4bef9fc2e..e56cfd86ee 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -6,6 +6,9 @@
 
 #pragma once
 
+#include <algorithm>
+#include <type_traits>
+#include <vector>
 #include <limits>
 #include <optional>
 #include <bit>
@@ -115,20 +118,47 @@ TextureCache<P>::TextureCache(Runtime& runtime_, Tegra::MaxwellDeviceMemoryManag
 
 template <class P>
 void TextureCache<P>::RunGarbageCollector() {
+    // Eden's collection rules, unchanged. One Doris change: textures that have to be copied back
+    // to guest memory before they are removed are copied together, with a single wait for the GPU
+    // at the end of the pass, instead of one wait per texture (each wait stalls emulation until the
+    // GPU has finished everything queued). They are written back and removed in the same order
+    // and in the same pass as before.
+    using StagingRef = decltype(runtime.DownloadStagingBuffer(size_t{}));
+    struct PendingRemoval {
+        ImageId image_id;
+        // Only used when StagingRef is plain data (see below).
+        std::conditional_t<std::is_trivially_destructible_v<StagingRef>, StagingRef, int> staging;
+    };
+    std::vector<PendingRemoval> pending;
+    u64 pending_bytes = 0;
+    const auto is_pending = [&pending](ImageId image_id) {
+        return std::ranges::any_of(pending, [image_id](const PendingRemoval& removal) {
+            return removal.image_id == image_id;
+        });
+    };
+    // Memory use as the rules see it, counting removals that are still waiting for their copy.
+    const auto used_memory = [this, &pending_bytes] {
+        return total_used_memory > pending_bytes ? total_used_memory - pending_bytes : 0;
+    };
+
     bool high_priority_mode = false;
     bool aggressive_mode = false;
     u64 ticks_to_destroy = 0;
     size_t num_iterations = 0;
     const auto Configure = [&](bool allow_aggressive) {
-        high_priority_mode = total_used_memory >= expected_memory;
-        aggressive_mode = allow_aggressive && total_used_memory >= critical_memory;
+        high_priority_mode = used_memory() >= expected_memory;
+        aggressive_mode = allow_aggressive && used_memory() >= critical_memory;
         ticks_to_destroy = aggressive_mode ? 10ULL : high_priority_mode ? 25ULL : 50ULL;
         num_iterations = aggressive_mode ? 40 : (high_priority_mode ? 20 : 10);
     };
-    const auto Cleanup = [this, &num_iterations, &high_priority_mode, &aggressive_mode](ImageId image_id) {
+    const auto Cleanup = [this, &num_iterations, &high_priority_mode, &aggressive_mode, &pending,
+                          &pending_bytes, &is_pending, &used_memory](ImageId image_id) {
         if (num_iterations == 0) {
             return true;
         }
+        if (is_pending(image_id)) {
+            return false;
+        }
         --num_iterations;
         auto& image = slot_images[image_id];
         if (True(image.flags & ImageFlagBits::IsDecoding)) {
@@ -142,18 +172,38 @@ void TextureCache<P>::RunGarbageCollector() {
             auto map = runtime.DownloadStagingBuffer(image.unswizzled_size_bytes);
             const auto copies = FixSmallVectorADL(FullDownloadCopies(image.info));
             image.DownloadMemory(map, copies);
-            runtime.Finish();
-            SwizzleImage(*gpu_memory, image.gpu_addr, image.info, copies, map.mapped_span, swizzle_data_buffer);
-        }
-        if (True(image.flags & ImageFlagBits::Tracked)) {
-            UntrackImage(image, image_id);
+            if constexpr (std::is_trivially_destructible_v<StagingRef>) {
+                // The staging reference is plain data (Vulkan): keep it and copy back later.
+                u64 image_bytes = (std::max)(image.guest_size_bytes, image.unswizzled_size_bytes);
+                if (image.HasScaled()) {
+                    image_bytes += GetScaledImageSizeBytes(image);
+                }
+                pending_bytes += image_bytes;
+                pending.push_back(PendingRemoval{image_id, map});
+            } else {
+                // Eden's path, one wait per texture (backends whose staging maps own a resource).
+                static_cast<void>(pending);
+                static_cast<void>(pending_bytes);
+                runtime.Finish();
+                SwizzleImage(*gpu_memory, image.gpu_addr, image.info, copies, map.mapped_span,
+                             swizzle_data_buffer);
+                if (True(image.flags & ImageFlagBits::Tracked)) {
+                    UntrackImage(image, image_id);
+                }
+                UnregisterImage(image_id);
+                DeleteImage(image_id, image.scale_tick > frame_tick + 5);
+            }
+        } else {
+            if (True(image.flags & ImageFlagBits::Tracked)) {
+                UntrackImage(image, image_id);
+            }
+            UnregisterImage(image_id);
+            DeleteImage(image_id, image.scale_tick > frame_tick + 5);
         }
-        UnregisterImage(image_id);
-        DeleteImage(image_id, image.scale_tick > frame_tick + 5);
-        if (aggressive_mode && total_used_memory < critical_memory) {
+        if (aggressive_mode && used_memory() < critical_memory) {
             num_iterations >>= 2;
             aggressive_mode = false;
-        } else if (high_priority_mode && total_used_memory < expected_memory) {
+        } else if (high_priority_mode && used_memory() < expected_memory) {
             num_iterations >>= 1;
             high_priority_mode = false;
         }
@@ -161,10 +211,28 @@ void TextureCache<P>::RunGarbageCollector() {
     };
     Configure(false);
     lru_cache.ForEachItemBelow(frame_tick - ticks_to_destroy, Cleanup);
-    if (total_used_memory >= critical_memory) {
+    if (used_memory() >= critical_memory) {
         Configure(true);
         lru_cache.ForEachItemBelow(frame_tick - ticks_to_destroy, Cleanup);
     }
+    if (pending.empty()) {
+        return;
+    }
+    // One wait for all the copies, then write each texture back and remove it.
+    runtime.Finish();
+    if constexpr (std::is_trivially_destructible_v<StagingRef>) {
+        for (PendingRemoval& removal : pending) {
+            auto& image = slot_images[removal.image_id];
+            const auto copies = FixSmallVectorADL(FullDownloadCopies(image.info));
+            SwizzleImage(*gpu_memory, image.gpu_addr, image.info, copies,
+                         removal.staging.mapped_span, swizzle_data_buffer);
+            if (True(image.flags & ImageFlagBits::Tracked)) {
+                UntrackImage(image, removal.image_id);
+            }
+            UnregisterImage(removal.image_id);
+            DeleteImage(removal.image_id, image.scale_tick > frame_tick + 5);
+        }
+    }
 }
 
 template <class P>
