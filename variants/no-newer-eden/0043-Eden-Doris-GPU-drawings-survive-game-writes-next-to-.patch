+void RasterizerVulkan::DorisInvalidateFromFault(DAddr addr, u64 size) {
+    if (addr == 0 || size == 0) {
+        return;
+    }
+    {
+        std::scoped_lock lock{texture_cache.mutex};
+        // Eden (Doris): GPU-drawn images on the page keep their contents unless the write
+        // changes their own bytes (the game's write is still waiting, so the images' bytes are
+        // seen as they were before it).
+        texture_cache.DorisWriteMemoryFromFault(addr, size);
+    }
+    {
+        std::scoped_lock lock{buffer_cache.mutex};
+        buffer_cache.WriteMemory(addr, size);
+    }
+    pipeline_cache.InvalidateRegion(addr, size);
+}
