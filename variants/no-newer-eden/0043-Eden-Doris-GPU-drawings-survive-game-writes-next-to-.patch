+/// Eden (Doris): a texture's shape and format for the performance report.
+[[nodiscard]] inline std::string DorisDescribeImage(const ImageBase& image) {
+    const ImageInfo& info = image.info;
+    std::string text = info.type == ImageType::e3D
+                           ? fmt::format("{}x{}x{}", info.size.width, info.size.height,
+                                         info.size.depth)
+                           : fmt::format("{}x{}", info.size.width, info.size.height);
+    if (info.resources.layers > 1) {
+        text += fmt::format(" L{}", info.resources.layers);
+    }
+    if (info.resources.levels > 1) {
+        text += fmt::format(" M{}", info.resources.levels);
+    }
+    if (info.num_samples > 1) {
+        text += fmt::format(" MSAA{}", info.num_samples);
+    }
+    return fmt::format("{} {}", text, info.format);
+}
