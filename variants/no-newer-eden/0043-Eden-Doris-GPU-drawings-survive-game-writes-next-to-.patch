+template <class P>
+bool TextureCache<P>::DorisResolveTouched(ImageId image_id, ImageBase& image) {
+    if (image.doris_touched_pages.empty()) {
+        return false;
+    }
+    constexpr u64 PAGE = Core::DEVICE_PAGESIZE;
+    std::vector<DorisTouchedPage> pages = std::move(image.doris_touched_pages);
+    image.doris_touched_pages.clear();
+    // Track the pages again before looking: a write after this point faults (and waits for the
+    // texture cache lock), so none can slip through unseen.
+    for (const DorisTouchedPage& touched : pages) {
+        device_memory.UpdatePagesCachedCount(touched.page, PAGE, 1);
+    }
+    std::array<u8, PAGE> now;
+    bool changed = false;
+    for (const DorisTouchedPage& touched : pages) {
+        const VAddr bytes_begin = (std::max)(touched.page, image.cpu_addr);
+        device_memory.ReadBlockUnsafe(bytes_begin, now.data(), touched.before.size());
+        if (std::memcmp(now.data(), touched.before.data(), touched.before.size()) != 0) {
+            changed = true;
+            break;
+        }
+    }
+    if (!changed) {
+        // Only data next to the image was written: what the GPU drew stays.
+        Doris::Perf::Add(Doris::Perf::Count::TextureNeighbourKept);
+        return false;
+    }
+    Doris::Perf::Add(Doris::Perf::Count::TextureNeighbourChanged);
+    if (Doris::Perf::Enabled()) {
+        Doris::Perf::NoteTexture(Doris::Perf::Note::NeighbourChanged, DorisDescribeImage(image));
+    }
+    image.flags |= ImageFlagBits::CpuModified;
+    if (True(image.flags & ImageFlagBits::Tracked)) {
+        UntrackImage(image, image_id);
+    }
+    return true;
+}
+
+template <class P>
+void TextureCache<P>::DorisResolveAllTouched() {
+    if (doris_touched_images.empty()) {
+        return;
+    }
+    std::vector<ImageId> images = std::move(doris_touched_images);
+    doris_touched_images.clear();
+    for (const ImageId image_id : images) {
+        DorisResolveTouched(image_id, slot_images[image_id]);
+    }
+}
+
+template <class P>
+void TextureCache<P>::DorisDropTouched(ImageBase& image) {
+    for (const DorisTouchedPage& touched : image.doris_touched_pages) {
+        device_memory.UpdatePagesCachedCount(touched.page, Core::DEVICE_PAGESIZE, 1);
+    }
+    image.doris_touched_pages.clear();
+}
+
+template <class P>
+void TextureCache<P>::DorisUpdateImagePages(ImageBase& image, s32 delta) {
+    if (image.doris_touched_pages.empty()) {
+        device_memory.UpdatePagesCachedCount(image.cpu_addr, image.guest_size_bytes, delta);
+        return;
+    }
+    constexpr u64 PAGE = Core::DEVICE_PAGESIZE;
+    boost::container::small_vector<VAddr, 8> pages;
+    for (const DorisTouchedPage& touched : image.doris_touched_pages) {
+        pages.push_back(touched.page);
+    }
+    std::ranges::sort(pages);
+    const VAddr image_end = image.cpu_addr + image.guest_size_bytes;
+    VAddr cursor = image.cpu_addr;
+    for (const VAddr page : pages) {
+        if (page > cursor) {
+            device_memory.UpdatePagesCachedCount(cursor, page - cursor, delta);
+        }
+        cursor = (std::max)(cursor, page + PAGE);
+    }
+    if (cursor < image_end) {
+        device_memory.UpdatePagesCachedCount(cursor, image_end - cursor, delta);
+    }
+}
