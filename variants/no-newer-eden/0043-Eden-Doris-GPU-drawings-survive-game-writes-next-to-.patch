+template <class P>
+void TextureCache<P>::DorisWriteMemoryFromFault(DAddr cpu_addr, size_t size) {
+    // Eden (Doris): Eden marks every image on a written page as changed by the CPU, and at its
+    // next use uploads it again from guest memory. For an image the GPU drew into, guest memory
+    // holds old contents, so a write by the game's code anywhere on a page the image shares
+    // (with other data next to it) replaced what the GPU had drawn with those old contents
+    // (TotK: up to 40 times a second). Here the image's bytes on the page are kept as they were
+    // before the write, the page is released for the write, and the image's next use compares:
+    // only if its own bytes changed is it uploaded again, as in Eden.
+    constexpr u64 PAGE = Core::DEVICE_PAGESIZE;
+    constexpr size_t MAX_TOUCHED_PAGES = 8;
+    const DAddr write_begin = Common::AlignDown(cpu_addr, PAGE);
+    const DAddr write_end = Common::AlignUp(cpu_addr + size, PAGE);
+    ForEachImageInRegion(cpu_addr, size, [&](ImageId image_id, Image& image) {
+        if (True(image.flags & ImageFlagBits::CpuModified)) {
+            return;
+        }
+        const VAddr image_end = image.cpu_addr + image.guest_size_bytes;
+        const bool can_keep = True(image.flags & ImageFlagBits::GpuModified) &&
+                              True(image.flags & ImageFlagBits::Tracked) &&
+                              False(image.flags & ImageFlagBits::Sparse) &&
+                              image.cpu_addr < ~(1ULL << 40);
+        if (can_keep) {
+            const bool listed = !image.doris_touched_pages.empty();
+            bool overflow = false;
+            const DAddr begin = (std::max)(write_begin, Common::AlignDown(image.cpu_addr, PAGE));
+            const DAddr end = (std::min)(write_end, Common::AlignUp(image_end, PAGE));
+            for (DAddr page = begin; page < end; page += PAGE) {
+                if (std::ranges::any_of(image.doris_touched_pages, [page](const auto& touched) {
+                        return touched.page == page;
+                    })) {
+                    continue;
+                }
+                if (image.doris_touched_pages.size() >= MAX_TOUCHED_PAGES) {
+                    overflow = true;
+                    break;
+                }
+                const VAddr bytes_begin = (std::max)(page, image.cpu_addr);
+                const VAddr bytes_end = (std::min)(page + PAGE, image_end);
+                DorisTouchedPage touched{.page = page, .before = {}};
+                touched.before.resize(bytes_end - bytes_begin);
+                device_memory.ReadBlockUnsafe(bytes_begin, touched.before.data(),
+                                              touched.before.size());
+                image.doris_touched_pages.push_back(std::move(touched));
+                // Release the page for the write (this image no longer tracks it).
+                device_memory.UpdatePagesCachedCount(page, PAGE, -1);
+            }
+            if (!overflow) {
+                if (!listed && !image.doris_touched_pages.empty()) {
+                    doris_touched_images.push_back(image_id);
+                }
+                Doris::Perf::Add(Doris::Perf::Count::TextureNeighbourWrites);
+                return;
+            }
+        }
+        image.flags |= ImageFlagBits::CpuModified;
+        if (True(image.flags & ImageFlagBits::Tracked)) {
+            UntrackImage(image, image_id);
+        }
+    });
+}
