From 05339b50fa34066e0cc228158a4ebd531c0cbef4 Mon Sep 17 00:00:00 2001
From: "Eden (Doris) build" <doris@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:10:53 -0500
Subject: [PATCH 4/4] turnip (Doris): Eden draws every render pass in GMEM
 (Apex's TOTK rule)

Apex v2's "TOTK grass/blocky-ground fix" (#8) sets prefer_gmem and ignore_frag_depth_direction for
applications named like totk, so it never applied in Eden. Of the two, only prefer_gmem changes anything
for Eden (its fragment shaders that write depth declare no direction, so LRZ is already off for them),
and in Tears of the Kingdom it removes the black squares on the ground. Use it for the engine
"yuzu Emulator" instead of the measured render modes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014Ps8wnhVXtSU7d88gGtyHX
---
 src/freedreno/vulkan/00-turnip-defaults.conf | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/freedreno/vulkan/00-turnip-defaults.conf b/src/freedreno/vulkan/00-turnip-defaults.conf
index 19f06c13895..0116aec58b5 100644
--- a/src/freedreno/vulkan/00-turnip-defaults.conf
+++ b/src/freedreno/vulkan/00-turnip-defaults.conf
@@ -8,10 +8,11 @@
             <option name="tu_allow_oob_indirect_ubo_loads" value="true" />
             <option name="tu_dont_care_as_load" value="true" />
         </engine>
-        <!-- Eden (Doris): Eden reports the engine "yuzu Emulator". Pick SYSMEM or GMEM for each render pass by
-             measuring both on the GPU (the profiled autotuner) instead of estimating bandwidth. -->
+        <!-- Eden (Doris): Eden reports the engine "yuzu Emulator". Draw every render pass in GMEM (tile memory),
+             as Apex's TOTK rule (#8) does: in Tears of the Kingdom that keeps the ground free of black squares.
+             The GPU barriers for Eden keep the binning pass from reading unfinished compute results. -->
         <engine engine_name_match="yuzu Emulator">
-            <option name="tu_autotune_algorithm" value="profiled" />
+            <option name="tu_autotune_algorithm" value="prefer_gmem" />
         </engine>
         <engine engine_name_match="rpcsx|armsx|rpcs3">
             <option name="tu_restrict_subgroup_size_64" value="false" />
