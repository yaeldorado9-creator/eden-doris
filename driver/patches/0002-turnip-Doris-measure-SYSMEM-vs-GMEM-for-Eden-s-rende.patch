+/** Eden (Doris): render pass GPU time report **/
+
+/* Every 10 seconds, the GPU time of the render passes the autotuner timed (those with 5 or more draws), split
+ * into SYSMEM and GMEM, and the render passes that took the most, with both modes' averages as measured by the
+ * profiled algorithm. Written to <app files>/log/apex_doris.txt when the app is Eden. Only render passes have
+ * timestamps (with the profiled algorithm); copies, blits and compute work outside render passes are not in it.
+ */
+struct tu_autotune::doris_report {
+   struct rp_stats {
+      uint32_t width = 0, height = 0, draws = 0, bins = 0;
+      uint32_t sysmem_count = 0, gmem_count = 0;
+      uint64_t sysmem_ticks = 0, gmem_ticks = 0, binning_ticks = 0;
+      uint32_t probability = 50;
+      bool locked = false;
+   };
+
+   FILE *file = nullptr;
+   uint64_t start_ns = 0, window_start_ns = 0;
+   std::unordered_map<uint64_t, rp_stats> window;
+   std::unordered_map<uint64_t, rp_stats> session;
+
+   ~doris_report()
+   {
+      if (file)
+         fclose(file);
+   }
+};
+
+static std::string
+doris_process_name()
+{
+   char name[256] = {};
+   FILE *f = fopen("/proc/self/cmdline", "rb");
+   if (!f)
+      return {};
+   size_t n = fread(name, 1, sizeof(name) - 1, f);
+   fclose(f);
+   name[n] = 0;
+   std::string s(name);
+   size_t colon = s.find(':');
+   if (colon != std::string::npos)
+      s.resize(colon);
+   return s;
+}
+
+static void
+doris_open_report(tu_autotune &at);
+
+void
+tu_autotune::doris_note(const rp_history &history, const rp_entry &const_entry)
+{
+   rp_entry &entry = const_cast<rp_entry &>(const_entry);
+   uint64_t duration = entry.get_rp_duration();
+   uint64_t binning = entry.sysmem ? 0 : entry.doris_binning_duration();
+   for (auto *map : { &doris->window, &doris->session }) {
+      auto &st = (*map)[history.hash];
+      st.width = entry.doris_width;
+      st.height = entry.doris_height;
+      st.draws = entry.draw_count;
+      st.probability = history.profiled.doris_sysmem_probability();
+      st.locked = history.profiled.doris_locked();
+      if (entry.sysmem) {
+         st.sysmem_count++;
+         st.sysmem_ticks += duration;
+      } else {
+         st.gmem_count++;
+         st.gmem_ticks += duration;
+         st.binning_ticks += binning;
+         st.bins = entry.tile_count;
+      }
+   }
+}
+
+static void
+doris_write_table(FILE *f, const char *title, std::unordered_map<uint64_t, tu_autotune::doris_report::rp_stats> &map,
+                  double seconds, size_t top)
+{
+   uint64_t sysmem_ticks = 0, gmem_ticks = 0, binning_ticks = 0;
+   uint64_t sysmem_count = 0, gmem_count = 0;
+   std::vector<std::pair<uint64_t, const tu_autotune::doris_report::rp_stats *>> sorted;
+   for (auto &[hash, st] : map) {
+      sysmem_ticks += st.sysmem_ticks;
+      gmem_ticks += st.gmem_ticks;
+      binning_ticks += st.binning_ticks;
+      sysmem_count += st.sysmem_count;
+      gmem_count += st.gmem_count;
+      sorted.emplace_back(hash, &st);
+   }
+   std::sort(sorted.begin(), sorted.end(), [](auto &a, auto &b) {
+      return a.second->sysmem_ticks + a.second->gmem_ticks > b.second->sysmem_ticks + b.second->gmem_ticks;
+   });
+   auto ms_per_s = [&](uint64_t ticks) { return ticks / GPU_TICKS_PER_US / 1000.0 / MAX2(seconds, 0.001); };
+   fprintf(f,
+           "%s: %.1f s | timed render passes (5+ draws) %.1f ms of GPU per second: SYSMEM %" PRIu64 " passes "
+           "%.1f ms/s, GMEM %" PRIu64 " passes %.1f ms/s (binning %.1f ms/s) | %zu different passes\n",
+           title, seconds, ms_per_s(sysmem_ticks + gmem_ticks), sysmem_count, ms_per_s(sysmem_ticks), gmem_count,
+           ms_per_s(gmem_ticks), ms_per_s(binning_ticks), map.size());
+   for (size_t i = 0; i < sorted.size() && i < top; i++) {
+      const auto &st = *sorted[i].second;
+      double sys_avg = st.sysmem_count ? st.sysmem_ticks / GPU_TICKS_PER_US / st.sysmem_count : 0;
+      double gmem_avg = st.gmem_count ? st.gmem_ticks / GPU_TICKS_PER_US / st.gmem_count : 0;
+      fprintf(f,
+              "  %016" PRIx64 " %4ux%-4u %4u draws: %.1f ms/s | SYSMEM %5u x %7.0f us | GMEM %5u x %7.0f us "
+              "(%u bins, binning %.0f us) | now SYSMEM %u%%%s\n",
+              sorted[i].first, st.width, st.height, st.draws, ms_per_s(st.sysmem_ticks + st.gmem_ticks),
+              st.sysmem_count, sys_avg, st.gmem_count, gmem_avg, st.bins,
+              st.gmem_count ? st.binning_ticks / GPU_TICKS_PER_US / st.gmem_count : 0.0, st.probability,
+              st.locked ? " (locked)" : "");
+   }
+}
+
+void
+tu_autotune::doris_maybe_write()
+{
+   uint64_t now = os_time_get_nano();
+   if (now - doris->window_start_ns < 10'000'000'000ull)
+      return;
+   double window_s = (now - doris->window_start_ns) / 1e9;
+   double session_s = (now - doris->start_ns) / 1e9;
+   if (!doris->window.empty()) {
+      fprintf(doris->file, "== %.0f s, algorithm %s\n", session_s, active_config.load().to_string().c_str());
+      doris_write_table(doris->file, "last window", doris->window, window_s, 12);
+      /* The whole session every minute. */
+      if ((uint64_t) session_s / 60 != (uint64_t) (session_s - window_s) / 60)
+         doris_write_table(doris->file, "session", doris->session, session_s, 25);
+      fflush(doris->file);
+   }
+   doris->window.clear();
+   doris->window_start_ns = now;
+}
+
+static void
+doris_open_report(tu_autotune &at)
+{
+   std::string name = doris_process_name();
+   if (name.find("eden") == std::string::npos)
+      return;
+   std::string path = "/storage/emulated/0/Android/data/" + name + "/files/log/apex_doris.txt";
+   struct stat st;
+   const char *mode = (stat(path.c_str(), &st) == 0 && st.st_size > 4 * 1024 * 1024) ? "w" : "a";
+   FILE *f = fopen(path.c_str(), mode);
+   if (!f)
+      return;
+   at.doris = std::make_unique<tu_autotune::doris_report>();
+   at.doris->file = f;
+   at.doris->start_ns = at.doris->window_start_ns = os_time_get_nano();
+   fprintf(f, "\n#### Apex Doris render pass report (" PACKAGE_VERSION MESA_GIT_SHA1 "), device opened\n");
+   fflush(f);
+}
