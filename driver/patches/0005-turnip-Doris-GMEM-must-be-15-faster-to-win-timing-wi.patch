+void
+tu_doris_note_view(struct tu_device *device, VkFormat image_format, VkImageCreateFlags image_flags,
+                   VkFormat view_format)
+{
+   if (!tu_doris_enabled() || view_format == image_format ||
+       !(image_flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT) || vk_format_is_depth_or_stencil(image_format))
+      return;
+   const struct fd_dev_info *info = device->physical_device->info;
+   enum pipe_format ipf = vk_format_to_pipe_format(image_format);
+   enum pipe_format vpf = vk_format_to_pipe_format(view_format);
+   bool same = fd6_ubwc_compat_mode(info, ipf) == fd6_ubwc_compat_mode(info, vpf) &&
+               fd6_ubwc_compat_mode(info, ipf) != FD6_UBWC_UNKNOWN_COMPAT;
+   bool swapped = (tu6_format_texture(ipf, TILE6_LINEAR, false).swap != 0) !=
+                  (tu6_format_texture(vpf, TILE6_LINEAR, false).swap != 0);
+   char key[160];
+   snprintf(key, sizeof(key), "%s viewed as %s%s", format_name(image_format), format_name(view_format),
+            swapped ? " (swapped)" : same ? "" : " (other compression type)");
+   std::scoped_lock lock(views.mutex);
+   views.total++;
+   if (same)
+      views.same_ubwc++;
+   else
+      views.other_ubwc++;
+   if (swapped)
+      views.swapped++;
+   views.pairs[key]++;
+}
+
 bool
