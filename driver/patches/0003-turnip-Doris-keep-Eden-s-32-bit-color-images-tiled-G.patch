diff --git a/src/freedreno/vulkan/tu_doris.cc b/src/freedreno/vulkan/tu_doris.cc
new file mode 100644
index 00000000000..8f595d45c37
--- /dev/null
+++ b/src/freedreno/vulkan/tu_doris.cc
@@ -0,0 +1,259 @@
+/*
+ * Copyright © 2026 Eden (Doris)
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "tu_doris.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+#include <sys/stat.h>
+
+#include "util/os_time.h"
+
+#include "tu_device.h"
+
+#include "git_sha1.h"
+
+namespace {
+
+/** The report file **/
+
+std::once_flag open_once;
+std::mutex file_mutex;
+FILE *report = nullptr;
+
+std::string
+process_name()
+{
+   char name[256] = {};
+   FILE *f = fopen("/proc/self/cmdline", "rb");
+   if (!f)
+      return {};
+   size_t n = fread(name, 1, sizeof(name) - 1, f);
+   fclose(f);
+   name[n] = 0;
+   std::string s(name);
+   size_t colon = s.find(':');
+   if (colon != std::string::npos)
+      s.resize(colon);
+   return s;
+}
+
+void
+open_report()
+{
+   std::string name = process_name();
+   if (name.find("eden") == std::string::npos)
+      return;
+   std::string path = "/storage/emulated/0/Android/data/" + name + "/files/log/apex_doris.txt";
+   struct stat st;
+   const char *mode = (stat(path.c_str(), &st) == 0 && st.st_size > 4 * 1024 * 1024) ? "w" : "a";
+   report = fopen(path.c_str(), mode);
+}
+
+std::string
+read_first_line(const char *path)
+{
+   char line[256] = {};
+   FILE *f = fopen(path, "r");
+   if (!f)
+      return {};
+   if (!fgets(line, sizeof(line), f))
+      line[0] = 0;
+   fclose(f);
+   std::string s(line);
+   while (!s.empty() && (s.back() == '\n' || s.back() == '\r' || s.back() == ' '))
+      s.pop_back();
+   return s;
+}
+
+/** System state: GPU clock and load every second, temperatures every 10 seconds **/
+
+struct thermal_zone {
+   std::string temp_path;
+   bool cpu, gpu;
+};
+
+constexpr uint64_t WINDOW_NS = 10'000'000'000ull;
+
+struct system_state {
+   std::mutex mutex;
+   uint64_t last_sample_ns = 0, window_start_ns = 0;
+   double clock_sum = 0, busy_sum = 0;
+   unsigned clock_min = ~0u, clock_max = 0, samples = 0, busy_samples = 0;
+   bool zones_scanned = false;
+   std::vector<thermal_zone> zones;
+} sys;
+
+double
+to_celsius(const std::string &text)
+{
+   double value = atof(text.c_str());
+   return value > 1000.0 ? value / 1000.0 : value;
+}
+
+void
+scan_zones()
+{
+   sys.zones_scanned = true;
+   for (int zone = 0; zone < 160; zone++) {
+      char base[96];
+      snprintf(base, sizeof(base), "/sys/class/thermal/thermal_zone%d/", zone);
+      std::string type = read_first_line((std::string(base) + "type").c_str());
+      if (type.empty()) {
+         if (zone > 8)
+            break;
+         continue;
+      }
+      bool cpu = type.find("cpu") != std::string::npos;
+      bool gpu = type.find("gpu") != std::string::npos;
+      if (cpu || gpu)
+         sys.zones.push_back({ std::string(base) + "temp", cpu, gpu });
+   }
+}
+
+void
+write_system_line(double window_s)
+{
+   std::string temps;
+   std::string battery = read_first_line("/sys/class/power_supply/battery/temp");
+   if (!battery.empty()) {
+      char buf[48];
+      snprintf(buf, sizeof(buf), "battery %.1f C", atof(battery.c_str()) / 10.0);
+      temps += buf;
+   }
+   if (!sys.zones_scanned)
+      scan_zones();
+   double hottest_cpu = 0, hottest_gpu = 0;
+   for (auto &z : sys.zones) {
+      std::string t = read_first_line(z.temp_path.c_str());
+      if (t.empty())
+         continue;
+      double c = to_celsius(t);
+      if (c <= 0 || c > 150)
+         continue;
+      if (z.gpu)
+         hottest_gpu = MAX2(hottest_gpu, c);
+      else
+         hottest_cpu = MAX2(hottest_cpu, c);
+   }
+   char buf[160];
+   if (hottest_gpu > 0) {
+      snprintf(buf, sizeof(buf), "%sGPU %.1f C", temps.empty() ? "" : ", ", hottest_gpu);
+      temps += buf;
+   }
+   if (hottest_cpu > 0) {
+      snprintf(buf, sizeof(buf), "%sCPU %.1f C", temps.empty() ? "" : ", ", hottest_cpu);
+      temps += buf;
+   }
+
+   std::string gpu;
+   if (sys.samples) {
+      snprintf(buf, sizeof(buf), "GPU clock avg %.0f MHz (%u-%u)", sys.clock_sum / sys.samples, sys.clock_min,
+               sys.clock_max);
+      gpu += buf;
+   }
+   if (sys.busy_samples) {
+      snprintf(buf, sizeof(buf), "%sbusy avg %.0f%%", gpu.empty() ? "GPU " : ", ", sys.busy_sum / sys.busy_samples);
+      gpu += buf;
+   }
+   tu_doris_printf("system (%.0f s): %s | %s\n", window_s, gpu.empty() ? "GPU clock n/a" : gpu.c_str(),
+                   temps.empty() ? "temperatures n/a" : temps.c_str());
+}
+
+void
+sample_gpu()
+{
+   std::string clock = read_first_line("/sys/class/kgsl/kgsl-3d0/gpuclk");
+   if (clock.empty())
+      clock = read_first_line("/sys/class/kgsl/kgsl-3d0/devfreq/cur_freq");
+   if (!clock.empty()) {
+      unsigned mhz = (unsigned) (atof(clock.c_str()) / 1e6);
+      sys.clock_sum += mhz;
+      sys.clock_min = MIN2(sys.clock_min, mhz);
+      sys.clock_max = MAX2(sys.clock_max, mhz);
+      sys.samples++;
+   }
+   std::string busy = read_first_line("/sys/class/kgsl/kgsl-3d0/gpu_busy_percentage");
+   if (!busy.empty()) {
+      sys.busy_sum += atof(busy.c_str());
+      sys.busy_samples++;
+   } else {
+      unsigned long long busy_time = 0, total_time = 0;
+      std::string raw = read_first_line("/sys/class/kgsl/kgsl-3d0/gpubusy");
+      if (sscanf(raw.c_str(), "%llu %llu", &busy_time, &total_time) == 2 && total_time) {
+         sys.busy_sum += busy_time * 100.0 / total_time;
+         sys.busy_samples++;
+      }
+   }
+}
+
+} /* namespace */
+
+bool
+tu_doris_enabled(void)
+{
+   std::call_once(open_once, open_report);
+   return report != nullptr;
+}
+
+void
+tu_doris_printf(const char *format, ...)
+{
+   if (!tu_doris_enabled())
+      return;
+   std::scoped_lock lock(file_mutex);
+   va_list args;
+   va_start(args, format);
+   vfprintf(report, format, args);
+   va_end(args);
+   fflush(report);
+}
+
+void
+tu_doris_device_init(struct tu_device *device)
+{
+   if (!tu_doris_enabled())
+      return;
+   tu_doris_printf("\n#### Apex Doris GPU report (Mesa " PACKAGE_VERSION MESA_GIT_SHA1 "), device opened\n");
+}
+
+bool
+tu_doris_is_eden_engine(const char *engine_name)
+{
+   return engine_name && !strcmp(engine_name, "yuzu Emulator");
+}
+
+void
+tu_doris_tick(void)
+{
+   if (!tu_doris_enabled())
+      return;
+   std::unique_lock lock(sys.mutex, std::try_to_lock);
+   if (!lock.owns_lock())
+      return;
+   uint64_t now = os_time_get_nano();
+   if (!sys.window_start_ns)
+      sys.window_start_ns = now;
+   if (now - sys.last_sample_ns >= 1'000'000'000ull) {
+      sys.last_sample_ns = now;
+      sample_gpu();
+   }
+   if (now - sys.window_start_ns >= WINDOW_NS) {
+      write_system_line((now - sys.window_start_ns) / 1e9);
+      sys.clock_sum = sys.busy_sum = 0;
+      sys.clock_min = ~0u;
+      sys.clock_max = 0;
+      sys.samples = sys.busy_samples = 0;
+      sys.window_start_ns = now;
+   }
+}
diff --git a/src/freedreno/vulkan/tu_doris.h b/src/freedreno/vulkan/tu_doris.h
new file mode 100644
index 00000000000..6303de03059
--- /dev/null
+++ b/src/freedreno/vulkan/tu_doris.h
@@ -0,0 +1,34 @@
+/*
+ * Copyright © 2026 Eden (Doris)
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Eden (Doris): a report for Tears of the Kingdom on Eden, written to apex_doris.txt in Eden's
+ * log folder (off in every other app): every 10 seconds the GPU clock and load and temperatures
+ * (from the kernel's files that apps may read), and the autotuner's render pass report.
+ */
+
+#ifndef TU_DORIS_H
+#define TU_DORIS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct tu_device;
+
+/* True when the process is Eden; the report file is open. */
+bool tu_doris_enabled(void);
+
+/* Opens the report (once per process) and writes a header for a new device. */
+void tu_doris_device_init(struct tu_device *device);
+
+/* Eden reports the engine "yuzu Emulator". */
+bool tu_doris_is_eden_engine(const char *engine_name);
+
+/* Appends to the report (thread safe). */
+void tu_doris_printf(const char *format, ...) __attribute__((format(printf, 1, 2)));
+
+/* Called on every queue submit: GPU clock/load sampling and the 10-second system line. */
+void tu_doris_tick(void);
+
+#endif /* TU_DORIS_H */
