+                tu_doris_is_eden_engine(device->instance->vk.app_info.engine_name))
+               fmt_list_has_swaps = false;
+
             if (r8g8_r16 || fmt_list_has_swaps) {
                ubwc_enabled = false;
                force_linear_tile = true;
