+/** GPU operation timing (from the GPU tracepoints) **/
+
+/* One second of every 30 is timed (about 30 frames); the cost is negligible outside it. */
+constexpr uint64_t OPS_WINDOW_NS = 30'000'000'000ull;
+constexpr unsigned SAMPLE_PERIOD_S = 30, SAMPLE_LENGTH_S = 1;
+
+struct total {
+   uint64_t ns = 0;
+   uint64_t count = 0;
+};
+
+struct open_range {
+   const char *name; /* without "start_" */
+   uint64_t ns;
+   const void *payload;
+   uint64_t child_ns;
+};
+
+struct op_state {
+   std::vector<open_range> stack;
+   std::unordered_map<std::string, total> categories, groups, inside_rp, lrz, gmem_off;
+   uint64_t cmdbuf_ns = 0, cmdbuf_count = 0, gap_ns = 0;
+   uint64_t frames = 0;
+   uint32_t last_frame = ~0u;
+   uint64_t window_start_ns = 0;
+} ops;
+
+const char *
+format_name(VkFormat format)
+{
+   const struct util_format_description *desc = vk_format_description(format);
+   return desc ? desc->short_name : "?";
+}
+
+const char *
+draws_bucket(uint32_t draws)
+{
+   if (draws == 0)
+      return "0";
+   if (draws == 1)
+      return "1";
+   if (draws < 5)
+      return "2-4";
+   if (draws < 20)
+      return "5-19";
+   if (draws < 100)
+      return "20-99";
+   return "100+";
+}
+
+void
+add(std::unordered_map<std::string, total> &map, const std::string &key, uint64_t ns)
+{
+   total &t = map[key];
+   t.ns += ns;
+   t.count++;
+}
+
+void
+note_top_level(const open_range &r, const char *name, const void *end_payload, uint64_t ns)
+{
+   char key[200];
+   const char *category;
+   if (!strcmp(name, "render_pass")) {
+      auto *s = (const struct trace_start_render_pass *) r.payload;
+      auto *e = (const struct trace_end_render_pass *) end_payload;
+      uint32_t draws = e->drawCount;
+      category = draws >= 5 ? "render passes, 5+ draws" : draws ? "render passes, 1-4 draws"
+                                                                : "render passes, no draws";
+      snprintf(key, sizeof(key), "render pass %ux%u %s, %u attachment%s%s, %s draws", s->width, s->height,
+               e->tiledRender ? "GMEM" : "SYSMEM", s->attachment_count, s->attachment_count == 1 ? "" : "s",
+               s->hasDepth ? " incl. depth" : "", draws_bucket(draws));
+      /* Depth culling (LRZ) for the passes that draw a lot, and why it was off. */
+      if (s->hasDepth && draws >= 5) {
+         char lrz[200];
+         if (e->lrz && !(e->lrzWriteDisableReason && e->lrzWriteDisableReason[0]))
+            snprintf(lrz, sizeof(lrz), "LRZ on");
+         else if (e->lrz)
+            snprintf(lrz, sizeof(lrz), "LRZ on, writes off: %s", e->lrzWriteDisableReason);
+         else
+            snprintf(lrz, sizeof(lrz), "LRZ off: %s",
+                     e->lrzDisableReason && e->lrzDisableReason[0] ? e->lrzDisableReason : "(no reason given)");
+         add(ops.lrz, lrz, ns);
+      }
+      if (draws >= 5 && !e->tiledRender && e->tilingDisableReason && e->tilingDisableReason[0])
+         add(ops.gmem_off, e->tilingDisableReason, ns);
+   } else if (!strcmp(name, "copy_buffer_to_image")) {
+      category = "uploads (buffer to image)";
+      snprintf(key, sizeof(key), "upload to %s image",
+               format_name(((const struct trace_start_copy_buffer_to_image *) r.payload)->format));
+   } else if (!strcmp(name, "copy_image_to_buffer")) {
+      category = "downloads (image to buffer)";
+      snprintf(key, sizeof(key), "download of %s image",
+               format_name(((const struct trace_start_copy_image_to_buffer *) r.payload)->format));
+   } else if (!strcmp(name, "copy_image")) {
+      auto *s = (const struct trace_start_copy_image *) r.payload;
+      category = "image copies";
+      snprintf(key, sizeof(key), "copy %s -> %s", format_name(s->src_format), format_name(s->dst_format));
+   } else if (!strcmp(name, "blit_image")) {
+      auto *s = (const struct trace_start_blit_image *) r.payload;
+      category = "blits";
+      snprintf(key, sizeof(key), "blit %s -> %s%s", format_name(s->src_format), format_name(s->dst_format),
+               s->uses_3d_blit ? " (3D)" : "");
+   } else if (!strcmp(name, "clear_color_image")) {
+      category = "image clears";
+      snprintf(key, sizeof(key), "clear %s image",
+               format_name(((const struct trace_start_clear_color_image *) r.payload)->format));
+   } else if (!strcmp(name, "clear_depth_stencil_image")) {
+      category = "image clears";
+      snprintf(key, sizeof(key), "clear %s image",
+               format_name(((const struct trace_start_clear_depth_stencil_image *) r.payload)->format));
+   } else if (!strcmp(name, "resolve_image")) {
+      category = "resolves";
+      snprintf(key, sizeof(key), "resolve");
+   } else if (!strcmp(name, "fill_buffer") || !strcmp(name, "copy_buffer") || !strcmp(name, "update_buffer")) {
+      category = "buffer copies and fills";
+      snprintf(key, sizeof(key), "%s", name);
+   } else if (!strcmp(name, "compute")) {
+      auto *s = (const struct trace_start_compute *) r.payload;
+      category = "compute";
+      snprintf(key, sizeof(key), "compute %ux%ux%u groups of %ux%ux%u, shader %.8s", s->num_groups_x,
+               s->num_groups_y, s->num_groups_z, s->local_size_x, s->local_size_y, s->local_size_z, s->cs_sha1);
+   } else if (!strcmp(name, "compute_indirect")) {
+      category = "compute";
+      snprintf(key, sizeof(key), "compute (indirect), shader %.8s",
+               ((const struct trace_start_compute_indirect *) r.payload)->cs_sha1);
+   } else if (!strcmp(name, "slow_clear_lrz") || !strcmp(name, "disable_lrz")) {
+      category = "LRZ (depth culling buffer)";
+      snprintf(key, sizeof(key), "%s", name);
+   } else {
+      category = "other";
+      snprintf(key, sizeof(key), "%s", name);
+   }
+   add(ops.categories, category, ns);
+   add(ops.groups, key, ns);
+}
+
+void
+write_ops(double window_s)
+{
+   if (!ops.cmdbuf_count)
+      return;
+   double frames = MAX2(ops.frames, (uint64_t) 1);
+   auto ms = [&](uint64_t ns) { return ns / 1e6 / frames; };
+   double all = MAX2(ops.cmdbuf_ns, (uint64_t) 1);
+   tu_doris_printf("GPU time by operation (%" PRIu64 " frames timed in the last %.0f s): command buffers %.2f ms "
+                   "per frame (%" PRIu64 " per frame)\n",
+                   ops.frames, window_s, ms(ops.cmdbuf_ns), (uint64_t) (ops.cmdbuf_count / frames));
+   std::vector<std::pair<std::string, total>> sorted(ops.categories.begin(), ops.categories.end());
+   sorted.emplace_back("between operations (barriers, flushes, waits)", total { ops.gap_ns, 0 });
+   std::sort(sorted.begin(), sorted.end(), [](auto &a, auto &b) { return a.second.ns > b.second.ns; });
+   for (auto &[name, t] : sorted) {
+      if (t.count)
+         tu_doris_printf("  %6.2f ms %5.1f%%  %-48s %6.1f per frame\n", ms(t.ns), 100.0 * t.ns / all, name.c_str(),
+                         t.count / frames);
+      else
+         tu_doris_printf("  %6.2f ms %5.1f%%  %s\n", ms(t.ns), 100.0 * t.ns / all, name.c_str());
+   }
+   uint64_t inside = 0;
+   for (auto &[name, t] : ops.inside_rp)
+      inside += t.ns;
+   if (inside) {
+      std::string line;
+      std::vector<std::pair<std::string, total>> parts(ops.inside_rp.begin(), ops.inside_rp.end());
+      std::sort(parts.begin(), parts.end(), [](auto &a, auto &b) { return a.second.ns > b.second.ns; });
+      for (auto &[name, t] : parts) {
+         char buf[96];
+         snprintf(buf, sizeof(buf), "%s%s %.2f ms", line.empty() ? "" : ", ", name.c_str(), ms(t.ns));
+         line += buf;
+      }
+      tu_doris_printf("  inside render passes: %s\n", line.c_str());
+   }
+   auto write_reasons = [&](const char *title, std::unordered_map<std::string, total> &map) {
+      if (map.empty())
+         return;
+      std::vector<std::pair<std::string, total>> v(map.begin(), map.end());
+      std::sort(v.begin(), v.end(), [](auto &a, auto &b) { return a.second.ns > b.second.ns; });
+      tu_doris_printf("  %s:\n", title);
+      for (size_t i = 0; i < v.size() && i < 8; i++)
+         tu_doris_printf("  %6.2f ms %6.1f per frame  %s\n", ms(v[i].second.ns), v[i].second.count / frames,
+                         v[i].first.c_str());
+   };
+   write_reasons("render passes with depth and 5+ draws, by depth culling (LRZ)", ops.lrz);
+   write_reasons("render passes with 5+ draws that could not use GMEM, why", ops.gmem_off);
+   std::vector<std::pair<std::string, total>> groups(ops.groups.begin(), ops.groups.end());
+   std::sort(groups.begin(), groups.end(), [](auto &a, auto &b) { return a.second.ns > b.second.ns; });
+   tu_doris_printf("  biggest:\n");
+   for (size_t i = 0; i < groups.size() && i < 20; i++) {
+      auto &[name, t] = groups[i];
+      tu_doris_printf("  %6.2f ms %5.1f%%  %6.1f per frame x %6.0f us  %s\n", ms(t.ns), 100.0 * t.ns / all,
+                      t.count / frames, t.count ? t.ns / 1e3 / t.count : 0.0, name.c_str());
+   }
+}
+
+void
+doris_event(struct u_trace_context *utctx, const char *name, bool is_begin, const void *payload, uint64_t ns)
+{
+   if (is_begin) {
+      ops.stack.push_back({ name + 6, ns, payload, 0 });
+      return;
+   }
+   if (strncmp(name, "end_", 4))
+      return; /* a single-point marker (perf warnings and the like) */
+   if (ops.stack.empty() || strcmp(ops.stack.back().name, name + 4)) {
+      ops.stack.clear(); /* unmatched: start over at the next command buffer */
+      return;
+   }
+   open_range r = ops.stack.back();
+   ops.stack.pop_back();
+   uint64_t dur = ns > r.ns ? ns - r.ns : 0;
+   if (!strcmp(r.name, "cmd_buffer")) {
+      ops.cmdbuf_ns += dur;
+      ops.cmdbuf_count++;
+      ops.gap_ns += dur > r.child_ns ? dur - r.child_ns : 0;
+      return;
+   }
+   open_range *parent = ops.stack.empty() ? nullptr : &ops.stack.back();
+   if (parent)
+      parent->child_ns += dur;
+   if (!parent || !strcmp(parent->name, "cmd_buffer")) {
+      note_top_level(r, r.name, payload, dur);
+      if (!strcmp(r.name, "render_pass")) {
+         total &t = ops.inside_rp["setup and other"];
+         t.ns += dur > r.child_ns ? dur - r.child_ns : 0;
+         t.count++;
+      }
+   } else if (!strcmp(parent->name, "render_pass")) {
+      add(ops.inside_rp, r.name, dur);
+   }
+}
+
+void
+doris_end_of_batch(struct u_trace_context *utctx, uint32_t frame_nr)
+{
+   ops.stack.clear();
+   if (frame_nr != U_TRACE_FRAME_UNKNOWN && frame_nr != ops.last_frame) {
+      ops.last_frame = frame_nr;
+      ops.frames++;
+   }
+   uint64_t now = os_time_get_nano();
+   if (!ops.window_start_ns)
+      ops.window_start_ns = now;
+   if (now - ops.window_start_ns < OPS_WINDOW_NS)
+      return;
+   write_ops((now - ops.window_start_ns) / 1e9);
+   ops.categories.clear();
+   ops.groups.clear();
+   ops.inside_rp.clear();
+   ops.lrz.clear();
+   ops.gmem_off.clear();
+   ops.cmdbuf_ns = ops.cmdbuf_count = ops.gap_ns = ops.frames = 0;
+   ops.window_start_ns = now;
+}
+
 } /* namespace */
 
 bool
@@ -225,6 +482,23 @@ tu_doris_device_init(struct tu_device *device)
    if (!tu_doris_enabled())
       return;
    tu_doris_printf("\n#### Apex Doris GPU report (Mesa " PACKAGE_VERSION MESA_GIT_SHA1 "), device opened\n");
+   device->trace_context.doris_event = doris_event;
+   device->trace_context.doris_end_of_batch = doris_end_of_batch;
+}
+
+bool
+tu_doris_sample_now(void)
+{
+   if (!tu_doris_enabled())
+      return true;
+   uint64_t s = os_time_get_nano() / 1'000'000'000ull;
+   return (s % SAMPLE_PERIOD_S) < SAMPLE_LENGTH_S;
+}
+
+void
+tu_doris_set_trace_sampling(struct u_trace *trace, bool sample)
+{
+   trace->doris_off = !sample;
 }
 
 bool
