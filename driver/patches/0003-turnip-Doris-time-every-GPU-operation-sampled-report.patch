+/*
+ * Copyright © 2026 Eden (Doris)
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Eden (Doris): a GPU report for Tears of the Kingdom on Eden, written to apex_doris.txt in
+ * Eden's log folder. Off in every other app.
+ *
+ * - Every 10 seconds: the GPU clock and load, temperatures (from the kernel's files that apps may
+ *   read), and the render pass report of the autotuner (tu_autotune.cc).
+ * - For 3 seconds of every 10 (sampled, to keep the cost down), every GPU operation is timed with
+ *   Mesa's GPU tracepoints: render passes (by size, mode and draws, and what inside them takes the
+ *   time), copies and uploads, blits, clears, compute dispatches, and the gaps between operations.
+ */
+
+#ifndef TU_DORIS_H
+#define TU_DORIS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct tu_device;
+struct u_trace;
+struct u_trace_context;
+
+/* True when the process is Eden; the report file is open. */
+bool tu_doris_enabled(void);
+
+/* Opens the report (once per process) and writes a header for a new device. */
+void tu_doris_device_init(struct tu_device *device);
+
+/* Appends to the report (thread safe). */
+void tu_doris_printf(const char *format, ...) __attribute__((format(printf, 1, 2)));
+
+/* Whether the command buffer being (re)started now is in a timed sample. */
+bool tu_doris_sample_now(void);
+
+/* Sets the sampling choice on a command buffer's traces. */
+void tu_doris_set_trace_sampling(struct u_trace *trace, bool sample);
+
+/* Called on every queue submit: GPU clock/load sampling and the 10-second system line. */
+void tu_doris_tick(void);
+
+#endif /* TU_DORIS_H */
