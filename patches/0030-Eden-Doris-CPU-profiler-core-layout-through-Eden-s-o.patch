+    if ((logged.fetch_or(bit) & bit) == 0) {
+        LOG_INFO(Frontend, "Doris cores: {} threads placed on the {} cores",
+                 role == Role::Gpu ? "GPU" : "other emulator", role == Role::Gpu ? "prime" : "middle");
     }
-#else
-    (void)role;
-#endif
 }
 
