-    }
-    if (sched_setaffinity(0, sizeof(set), &set) != 0) {
-        LOG_WARNING(Frontend, "Doris cores: could not pin thread to cpu {}", Describe(cpus));
+    // Goes through Eden's own core groups, so its periodic policy refresh keeps the placement
+    // instead of undoing it.
+    Common::SetCurrentThreadToDorisCores(role == Role::Gpu);
+    static std::atomic<unsigned> logged{0};
