diff --git a/src/common/doris_profiler.cpp b/src/common/doris_profiler.cpp
new file mode 100644
index 000000000..e91d5a8b0
--- /dev/null
+++ b/src/common/doris_profiler.cpp
@@ -0,0 +1,222 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden (Doris)
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "common/doris_profiler.h"
+
+#if (defined(__linux__) || defined(__ANDROID__)) && defined(__aarch64__)
+#define DORIS_PROFILER_ENABLED 1
+#endif
+
+#ifdef DORIS_PROFILER_ENABLED
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <ctime>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#include <dlfcn.h>
+#include <pthread.h>
+#include <signal.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#include <fmt/format.h>
+
+#include "common/fs/path_util.h"
+#include "common/logging.h"
+#include "common/settings.h"
+#include "common/thread.h"
+
+namespace Doris::Profiler {
+namespace {
+
+constexpr int MAX_THREADS = 8;
+constexpr uint32_t CAPACITY = 1u << 15;             // samples per buffer
+constexpr long PERIOD_NS = 1'000'000;                // 1 ms of the thread's CPU time
+constexpr auto WRITE_INTERVAL = std::chrono::seconds{20};
+
+struct Sample {
+    uintptr_t pc;
+    uintptr_t lr;
+};
+
+struct Slot {
+    char label[32]{};
+    std::atomic<uint32_t> active{0};                 // buffer the signal handler writes to
+    std::array<std::atomic<uint32_t>, 2> count{};
+    std::array<std::array<Sample, CAPACITY>, 2> samples{};
+};
+
+std::array<Slot, MAX_THREADS> slots;
+std::atomic<int> slot_count{0};
+std::once_flag start_flag;
+
+void Handler(int, siginfo_t* info, void* raw_context) {
+    const int index = info->si_value.sival_int;
+    if (index < 0 || index >= MAX_THREADS) {
+        return;
+    }
+    const auto* context = static_cast<const ucontext_t*>(raw_context);
+    Slot& slot = slots[index];
+    const uint32_t buffer = slot.active.load(std::memory_order_relaxed) & 1;
+    const uint32_t position = slot.count[buffer].fetch_add(1, std::memory_order_relaxed);
+    if (position < CAPACITY) {
+        slot.samples[buffer][position] = {static_cast<uintptr_t>(context->uc_mcontext.pc),
+                                          static_cast<uintptr_t>(context->uc_mcontext.regs[30])};
+    }
+}
+
+struct Location {
+    std::string module;
+    uintptr_t offset;
+};
+
+Location Resolve(uintptr_t address, std::unordered_map<uintptr_t, Location>& cache) {
+    if (const auto it = cache.find(address); it != cache.end()) {
+        return it->second;
+    }
+    Location location{"?", address};
+    Dl_info info{};
+    if (address != 0 && dladdr(reinterpret_cast<void*>(address), &info) != 0 &&
+        info.dli_fname != nullptr) {
+        const std::string path = info.dli_fname;
+        location.module = path.substr(path.find_last_of('/') + 1);
+        location.offset = address - reinterpret_cast<uintptr_t>(info.dli_fbase);
+    }
+    cache.emplace(address, location);
+    return location;
+}
+
+void WriterLoop() {
+    Common::SetCurrentThreadName("DorisProfiler");
+    Common::SetCurrentThreadPriority(Common::ThreadPriority::Low);
+    const auto start = std::chrono::steady_clock::now();
+    // Totals since the profiler started, per thread: address -> count.
+    std::array<std::unordered_map<uintptr_t, uint64_t>, MAX_THREADS> pc_totals, lr_totals;
+    std::array<uint64_t, MAX_THREADS> sample_totals{};
+    std::unordered_map<uintptr_t, Location> cache;
+    const std::string path =
+        Common::FS::GetEdenPathString(Common::FS::EdenPath::LogDir) + "/doris_profile.txt";
+
+    while (true) {
+        std::this_thread::sleep_for(WRITE_INTERVAL);
+        const int threads = slot_count.load();
+        for (int index = 0; index < threads; ++index) {
+            Slot& slot = slots[index];
+            const uint32_t old = slot.active.fetch_xor(1) & 1;
+            std::this_thread::sleep_for(std::chrono::milliseconds{2});
+            const uint32_t taken = std::min(slot.count[old].load(), CAPACITY);
+            for (uint32_t i = 0; i < taken; ++i) {
+                ++pc_totals[index][slot.samples[old][i].pc];
+                ++lr_totals[index][slot.samples[old][i].lr];
+            }
+            sample_totals[index] += taken;
+            slot.count[old].store(0);
+        }
+
+        std::ofstream file(path, std::ios::trunc);
+        if (!file) {
+            LOG_WARNING(Frontend, "Doris profiler: could not write {}", path);
+            continue;
+        }
+        const auto seconds =
+            std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now() -
+                                                             start)
+                .count();
+        file << fmt::format("# Doris profile: {} s, one sample per ms of CPU time\n", seconds);
+        for (int index = 0; index < threads; ++index) {
+            const auto write_table = [&](const char* kind,
+                                         const std::unordered_map<uintptr_t, uint64_t>& totals) {
+                // Fold addresses into module + offset, then sort by count.
+                std::map<std::pair<std::string, uintptr_t>, uint64_t> folded;
+                for (const auto& [address, count] : totals) {
+                    const Location location = Resolve(address, cache);
+                    folded[{location.module, location.offset}] += count;
+                }
+                std::vector<std::pair<uint64_t, std::pair<std::string, uintptr_t>>> rows;
+                rows.reserve(folded.size());
+                for (const auto& [key, count] : folded) {
+                    rows.emplace_back(count, key);
+                }
+                std::ranges::sort(rows, [](const auto& a, const auto& b) { return a.first > b.first; });
+                file << fmt::format("[{} {}] samples {}\n", slots[index].label, kind,
+                                    sample_totals[index]);
+                for (size_t i = 0; i < rows.size() && i < 4000; ++i) {
+                    file << fmt::format("{} {:#x} {}\n", rows[i].second.first, rows[i].second.second,
+                                        rows[i].first);
+                }
+            };
+            write_table("pc", pc_totals[index]);
+            write_table("lr", lr_totals[index]);
+        }
+        LOG_INFO(Frontend, "Doris profiler: wrote {} ({} s)", path, seconds);
+    }
+}
+
+} // Anonymous namespace
+
+void RegisterCurrentThread(const char* label) {
+    if (!Settings::values.doris_profiler.GetValue()) {
+        return;
+    }
+    std::call_once(start_flag, [] {
+        struct sigaction action {};
+        action.sa_sigaction = Handler;
+        action.sa_flags = SA_SIGINFO | SA_RESTART;
+        sigemptyset(&action.sa_mask);
+        sigaction(SIGPROF, &action, nullptr);
+        std::thread(WriterLoop).detach();
+    });
+    const int index = slot_count.fetch_add(1);
+    if (index >= MAX_THREADS) {
+        return;
+    }
+    std::snprintf(slots[index].label, sizeof(slots[index].label), "%s", label);
+
+    clockid_t clock{};
+    if (pthread_getcpuclockid(pthread_self(), &clock) != 0) {
+        LOG_WARNING(Frontend, "Doris profiler: no CPU clock for {}", label);
+        return;
+    }
+    sigevent event{};
+    event.sigev_notify = SIGEV_THREAD_ID;
+    event.sigev_signo = SIGPROF;
+    event.sigev_value.sival_int = index;
+#ifdef sigev_notify_thread_id
+    event.sigev_notify_thread_id = static_cast<pid_t>(syscall(SYS_gettid));
+#else
+    event._sigev_un._tid = static_cast<pid_t>(syscall(SYS_gettid));
+#endif
+    timer_t timer{};
+    if (timer_create(clock, &event, &timer) != 0) {
+        LOG_WARNING(Frontend, "Doris profiler: could not create the timer for {}", label);
+        return;
+    }
+    itimerspec spec{};
+    spec.it_interval.tv_nsec = PERIOD_NS;
+    spec.it_value.tv_nsec = PERIOD_NS;
+    timer_settime(timer, 0, &spec, nullptr);
+    LOG_INFO(Frontend, "Doris profiler: sampling thread {}", label);
+}
+
+} // namespace Doris::Profiler
+
+#else
+
+namespace Doris::Profiler {
+void RegisterCurrentThread(const char*) {}
+} // namespace Doris::Profiler
+
+#endif
