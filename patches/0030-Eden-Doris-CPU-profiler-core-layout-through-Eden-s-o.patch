@@ -0,0 +1,15 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden (Doris)
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+namespace Doris::Profiler {
+
+/// Starts sampling the calling thread, if the "CPU profiler" setting is on: about once per
+/// millisecond of CPU time the thread uses (never while it sleeps), its program counter and return
+/// address are recorded. Every 20 seconds the totals so far are written to doris_profile.txt in the
+/// log folder, as module + offset, for symbolizing against the build's unstripped library.
+/// Only for host threads (GPU, Vulkan worker); never for threads that run guest code.
+void RegisterCurrentThread(const char* label);
+
+} // namespace Doris::Profiler
