-template <class P>
-u64 TextureCache<P>::DorisCollectionThreshold() const noexcept {
-    // Eden (Doris): Eden starts collecting at 40% of the GPU memory budget (1.6 GiB of the 4 GiB
-    // it allows on Snapdragon 8 Gen 2). Its "used memory" is everything the device reports for
-    // the app, and TotK's working set alone is around 2 GiB, so the collector never stopped:
-    // thousands of textures removed and re-uploaded every few seconds. Start at 2.4 GiB instead
-    // (always at least 512 MiB below the critical level, never below Eden's own threshold).
-    if (Settings::values.doris_texture_gc.GetValue() == 0) {
-        return expected_memory;
-    }
-    constexpr u64 DORIS_EXPECTED_MEMORY = 2_GiB + 400_MiB;
-    const u64 below_critical = critical_memory > 512_MiB ? critical_memory - 512_MiB : 0;
-    return (std::max)(expected_memory, (std::min)(DORIS_EXPECTED_MEMORY, below_critical));
-}
-
 template <class P>
 void TextureCache<P>::RunGarbageCollector() {
-    // Eden (Doris) collection: textures the GPU drew into are only removed when memory is
-    // critical. Eden also removed them under ordinary pressure, either copying each one back to
-    // guest memory first (which waits for the GPU to finish all its work: a hitch every time) or,
-    // when it can't be copied, throwing the drawing away (it comes back later from stale memory:
-    // flicker). Textures also have to sit unused for longer before they go.
-    const bool doris = Settings::values.doris_texture_gc.GetValue() != 0;
-    const u64 collection_threshold = DorisCollectionThreshold();
     bool high_priority_mode = false;
     bool aggressive_mode = false;
     u64 ticks_to_destroy = 0;
     size_t num_iterations = 0;
-    // Doris: textures the collector looks at but keeps, per pass (bounds the cost of a pass).
-    size_t num_skips = 0;
     const auto Configure = [&](bool allow_aggressive) {
-        high_priority_mode = total_used_memory >= collection_threshold;
+        high_priority_mode = total_used_memory >= expected_memory;
         aggressive_mode = allow_aggressive && total_used_memory >= critical_memory;
-        if (doris) {
-            ticks_to_destroy = aggressive_mode ? 20ULL : high_priority_mode ? 120ULL : 300ULL;
-        } else {
-            ticks_to_destroy = aggressive_mode ? 10ULL : high_priority_mode ? 25ULL : 50ULL;
-        }
+        ticks_to_destroy = aggressive_mode ? 10ULL : high_priority_mode ? 25ULL : 50ULL;
         num_iterations = aggressive_mode ? 40 : (high_priority_mode ? 20 : 10);
-        num_skips = 256;
     };
-    const auto Cleanup = [this, doris, collection_threshold, &num_iterations, &num_skips,
-                          &high_priority_mode, &aggressive_mode](ImageId image_id) {
+    const auto Cleanup = [this, &num_iterations, &high_priority_mode, &aggressive_mode](ImageId image_id) {
         if (num_iterations == 0) {
             return true;
         }
-        auto& image = slot_images[image_id];
-        if (doris && !aggressive_mode && True(image.flags & ImageFlagBits::GpuModified)) {
-            // Keep what the GPU drew; looking at it costs a little of a separate budget.
-            if (num_skips == 0) {
-                return true;
-            }
-            --num_skips;
-            return false;
-        }
         --num_iterations;
+        auto& image = slot_images[image_id];
         if (True(image.flags & ImageFlagBits::IsDecoding)) {
             return false;
         }
@@ -200,7 +162,7 @@ void TextureCache<P>::RunGarbageCollector() {
         if (aggressive_mode && total_used_memory < critical_memory) {
             num_iterations >>= 2;
             aggressive_mode = false;
-        } else if (high_priority_mode && total_used_memory < collection_threshold) {
+        } else if (high_priority_mode && total_used_memory < expected_memory) {
             num_iterations >>= 1;
             high_priority_mode = false;
         }
@@ -222,8 +184,7 @@ void TextureCache<P>::TickFrame() {
     }
     if (Doris::Perf::Enabled()) {
         Doris::Perf::SetGauge(Doris::Perf::Gauge::TextureCacheMemory, total_used_memory >> 20);
-        Doris::Perf::SetGauge(Doris::Perf::Gauge::TextureCacheExpected,
-                              DorisCollectionThreshold() >> 20);
+        Doris::Perf::SetGauge(Doris::Perf::Gauge::TextureCacheExpected, expected_memory >> 20);
         Doris::Perf::SetGauge(Doris::Perf::Gauge::TextureCacheCritical, critical_memory >> 20);
     }
     if (total_used_memory > minimum_memory) {
