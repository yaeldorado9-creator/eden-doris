+namespace {
+// Eden (Doris): a barrier that makes every earlier write visible to every later command.
+constexpr VkMemoryBarrier DORIS_FULL_BARRIER{
+    .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+    .pNext = nullptr,
+    .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+    .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+};
+} // Anonymous namespace
+
+void RasterizerVulkan::DorisAfterCompute() {
+    if (Settings::values.doris_gpu_barriers.GetValue() == 0) {
+        return;
+    }
+    // Eden (Doris): make what the compute shader wrote (culling results, indirect draw arguments,
+    // vertex and instance data, images) visible to whatever runs next. Eden only had a barrier
+    // before a dispatch, so draws right after it could read stale data on Adreno.
+    static constexpr VkMemoryBarrier AFTER_COMPUTE{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .pNext = nullptr,
+        .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_INDIRECT_COMMAND_READ_BIT | VK_ACCESS_INDEX_READ_BIT |
+                         VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT | VK_ACCESS_UNIFORM_READ_BIT |
+                         VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT |
+                         VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+    };
+    scheduler.Record([](vk::CommandBuffer cmdbuf) {
+        cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                               VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, AFTER_COMPUTE);
+    });
+}
+
+void RasterizerVulkan::DorisFullBarrier() {
+    scheduler.RequestOutsideRenderPassOperationContext();
+    scheduler.Record([](vk::CommandBuffer cmdbuf) {
+        cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                               VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, DORIS_FULL_BARRIER);
+    });
+}
+
 void RasterizerVulkan::WaitForIdle() {
+    if (Settings::values.doris_gpu_barriers.GetValue() != 0) {
+        // Eden (Doris): the event wait below has TOP_OF_PIPE as its destination and no memory
+        // barrier, so Vulkan guarantees neither ordering nor visibility of earlier writes. On
+        // Adreno (Turnip and Qualcomm) that lets later draws read stale data written before the
+        // game's barrier. Use a real full barrier instead.
+        query_cache.NotifyWFI();
+        DorisFullBarrier();
+        fence_manager.SignalOrdering();
+        return;
+    }
     // Everything but wait pixel operations. This intentionally includes FRAGMENT_SHADER_BIT because
     // fragment shaders can still write storage buffers.
     VkPipelineStageFlags flags =
@@ -879,6 +931,9 @@ void RasterizerVulkan::FragmentBarrier() {
 
 void RasterizerVulkan::TiledCacheBarrier() {
     // TODO: Implementing tiled barriers requires rewriting a good chunk of the Vulkan backend
+    if (Settings::values.doris_gpu_barriers.GetValue() >= 2) {
+        DorisFullBarrier();
+    }
 }
 
 void RasterizerVulkan::FlushCommands() {
