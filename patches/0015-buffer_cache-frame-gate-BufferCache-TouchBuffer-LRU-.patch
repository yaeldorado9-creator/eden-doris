From cfd92405c9d50a653968ea85f4f2c640b8cc2756 Mon Sep 17 00:00:00 2001
From: alvindimas05 <alvin.dimas.praditya@gmail.com>
Date: Fri, 23 Oct 2026 01:03:44 +0700
Subject: [PATCH 15/35] [buffer_cache] frame-gate BufferCache::TouchBuffer LRU
 updates

(cherry picked from commit 6999ef35e67f75dd2a0f4208f4d92ac4cd76d62c)
---
 src/video_core/buffer_cache/buffer_base.h  | 1 +
 src/video_core/buffer_cache/buffer_cache.h | 5 ++++-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/video_core/buffer_cache/buffer_base.h b/src/video_core/buffer_cache/buffer_base.h
index d7eb21612..c17fc989d 100644
--- a/src/video_core/buffer_cache/buffer_base.h
+++ b/src/video_core/buffer_cache/buffer_base.h
@@ -102,6 +102,7 @@ public:
     }
 
     DAddr cpu_addr_cached = 0;
+    u64 lru_touch_frame = 0;
 
     /// Returns the offset relative to the given CPU address
     /// @pre IsInBounds returns true
diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
index ce28f0f7f..57b05f826 100644
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -1750,7 +1750,10 @@ void BufferCache<P>::ChangeRegister(BufferId buffer_id) {
 template <class P>
 void BufferCache<P>::TouchBuffer(Buffer& buffer, BufferId buffer_id) noexcept {
     if (buffer_id != NULL_BUFFER_ID) {
-        lru_cache.Touch(buffer.getLRUID(), frame_tick);
+        if (buffer.lru_touch_frame != frame_tick) {
+            buffer.lru_touch_frame = frame_tick;
+            lru_cache.Touch(buffer.getLRUID(), frame_tick);
+        }
     }
 }
 
