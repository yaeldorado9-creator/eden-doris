diff --git a/src/common/settings.h b/src/common/settings.h
index 7ac4b1117..3038d4815 100644
--- a/src/common/settings.h
+++ b/src/common/settings.h
@@ -584,6 +584,15 @@ struct Values {
     SwitchableSetting<bool> barrier_feedback_loops{linkage, true, "barrier_feedback_loops",
                                                    Category::RendererAdvanced};
 
+    // Eden (Doris) experiments. Defaults reproduce the PR #4324 build exactly.
+    // Iterations each shader loop may run before it is cut short (0 = no cap).
+    // PR #4324 lowered Eden's 8192 to 256 for Monster Hunter Rise.
+    SwitchableSetting<u32> doris_shader_loop_limit{linkage, 256, "doris_shader_loop_limit",
+                                                   Category::RendererAdvanced};
+    // PR #4324's Monster Hunter Rise record fix: 0 = off, 1 = only in Monster Hunter Rise,
+    // 2 = always, in every game (as the PR #4324 build does).
+    SwitchableSetting<u32> doris_mhr_fix{linkage, 2, "doris_mhr_fix", Category::RendererAdvanced};
+
     SwitchableSetting<bool> enable_buffer_history{linkage,
                                                   false,
                                                   "enable_buffer_history",
diff --git a/src/shader_recompiler/backend/spirv/emit_spirv.cpp b/src/shader_recompiler/backend/spirv/emit_spirv.cpp
index 0a5bd1cfe..4d29df657 100644
--- a/src/shader_recompiler/backend/spirv/emit_spirv.cpp
+++ b/src/shader_recompiler/backend/spirv/emit_spirv.cpp
@@ -165,10 +165,11 @@ void Traverse(EmitContext& ctx, IR::Program& program) {
             break;
         case IR::AbstractSyntaxNode::Type::Repeat: {
             Id cond{ctx.Def(node.data.repeat.cond)};
-            if (!Settings::values.disable_shader_loop_safety_checks) {
+            const u32 loop_limit{Settings::values.doris_shader_loop_limit.GetValue()};
+            if (!Settings::values.disable_shader_loop_safety_checks && loop_limit != 0) {
                 const Id pointer_type{ctx.TypePointer(spv::StorageClass::Private, ctx.U32[1])};
                 const Id safety_counter{ctx.AddGlobalVariable(
-                    pointer_type, spv::StorageClass::Private, ctx.Const(0x100u))};
+                    pointer_type, spv::StorageClass::Private, ctx.Const(loop_limit))};
                 if (ctx.profile.supported_spirv >= 0x00010400) {
                     ctx.interfaces.push_back(safety_counter);
                 }
diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
index 4620f80a3..ce28f0f7f 100644
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -8,6 +8,7 @@
 
 #include <algorithm>
 #include <array>
+#include <atomic>
 #include <cstring>
 #include <memory>
 #include <mutex>
@@ -240,8 +241,14 @@ bool BufferCache<P>::DMACopy(GPUVAddr src_address, GPUVAddr dest_address, u64 am
         return amount == mhr_record_size && address >= slot &&
                address <= slot + mhr_slot_size - mhr_record_size;
     };
-    const bool mhr_source_a = in_mhr_slot(*cpu_src_address, mhr_slot_a);
-    const bool mhr_source_b = in_mhr_slot(*cpu_src_address, mhr_slot_b);
+    // Eden (Doris): 0 = off, 1 = only in Monster Hunter Rise, 2 = always (PR #4324 behaviour).
+    constexpr u64 mhr_program_id = 0x0100B04011742000ULL;
+    const u32 mhr_fix_mode{Settings::values.doris_mhr_fix.GetValue()};
+    const bool mhr_fix_enabled =
+        mhr_fix_mode == 2 ||
+        (mhr_fix_mode == 1 && Settings::GetCurrentProgramID() == mhr_program_id);
+    const bool mhr_source_a = mhr_fix_enabled && in_mhr_slot(*cpu_src_address, mhr_slot_a);
+    const bool mhr_source_b = mhr_fix_enabled && in_mhr_slot(*cpu_src_address, mhr_slot_b);
     bool mhr_override{};
     MhrRecord mhr_healthy_record{};
     if (mhr_source_a || mhr_source_b) {
@@ -341,6 +348,13 @@ bool BufferCache<P>::DMACopy(GPUVAddr src_address, GPUVAddr dest_address, u64 am
     }
 
     if (mhr_override) {
+        // Eden (Doris): say in the log when the record fix rewrites a copy, and in which game.
+        static std::atomic<u64> mhr_override_count{};
+        const u64 n = ++mhr_override_count;
+        if (n <= 20 || (n & (n - 1)) == 0) {
+            LOG_WARNING(HW_GPU, "Doris: MHR record fix replaced DMA copy #{} to {:#x} (program {:016X})",
+                        n, *cpu_dest_address, Settings::GetCurrentProgramID());
+        }
         device_memory.WriteBlockUnsafe(*cpu_dest_address, mhr_healthy_record.data(),
                                        mhr_healthy_record.size());
         InlineMemoryImplementation(*cpu_dest_address, mhr_healthy_record.size(),
