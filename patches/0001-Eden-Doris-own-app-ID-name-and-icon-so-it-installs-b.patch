From 9eafc6518582d8e47f86f63e7e842487001ee986 Mon Sep 17 00:00:00 2001
From: "Eden (Doris) build" <doris@users.noreply.github.com>
Date: Thu, 29 Oct 2026 09:04:53 -0500
Subject: [PATCH 1/2] Eden (Doris): own app ID, name and icon so it installs
 beside every other Eden

- new 'doris' product flavor: applicationId dev.eden.eden_doris, label 'Eden (Doris)'
- custom-config intent action is now per application ID (no chooser between Eden apps)
- original adaptive launcher icon (with a themed-icon layer)
---
 src/android/app/build.gradle.kts              | 16 ++++++++-
 .../res/drawable/ic_doris_background.xml      | 22 ++++++++++++
 .../res/drawable/ic_doris_foreground.xml      | 34 +++++++++++++++++++
 .../res/drawable/ic_doris_monochrome.xml      | 34 +++++++++++++++++++
 .../res/mipmap-anydpi-v26/ic_launcher.xml     |  6 ++++
 .../mipmap-anydpi-v26/ic_launcher_round.xml   |  6 ++++
 src/android/app/src/main/AndroidManifest.xml  |  2 +-
 .../yuzu_emu/utils/CustomSettingsHandler.kt   |  3 +-
 8 files changed, 120 insertions(+), 3 deletions(-)
 create mode 100644 src/android/app/src/doris/res/drawable/ic_doris_background.xml
 create mode 100644 src/android/app/src/doris/res/drawable/ic_doris_foreground.xml
 create mode 100644 src/android/app/src/doris/res/drawable/ic_doris_monochrome.xml
 create mode 100644 src/android/app/src/doris/res/mipmap-anydpi-v26/ic_launcher.xml
 create mode 100644 src/android/app/src/doris/res/mipmap-anydpi-v26/ic_launcher_round.xml

diff --git a/src/android/app/build.gradle.kts b/src/android/app/build.gradle.kts
index 0cef7e719..75ec07279 100644
--- a/src/android/app/build.gradle.kts
+++ b/src/android/app/build.gradle.kts
@@ -240,6 +240,20 @@ android {
             }
         }
 
+        // Eden (Doris): personal build. Its own application ID, name and icon, so it installs next to
+        // every other Eden (official, Nightly, PR builds) and only ever updates itself.
+        create("doris") {
+            dimension = "version"
+            minSdk = 33
+            applicationId = "dev.eden.eden_doris"
+            manifestPlaceholders += mapOf("appNameBase" to "Eden (Doris)")
+            resValue("string", "app_name_suffixed", "Eden (Doris)")
+
+            ndk {
+                abiFilters += listOf("arm64-v8a")
+            }
+        }
+
         create("chromeOS") {
             dimension = "version"
             manifestPlaceholders += mapOf("appNameBase" to "Eden ChromeOS")
@@ -270,7 +284,7 @@ android {
 
         // apply nightly suffix I/A
         resValue("string", "app_name_suffixed", "$currentName$suffix")
-        resValue("string", "app_name", "Eden$suffix")
+        resValue("string", "app_name", if (name == "doris") "$currentName$suffix" else "Eden$suffix")
     }
 }
 
