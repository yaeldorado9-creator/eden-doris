+namespace {
+
+/// Eden (Doris): where a mip level sits in guest memory and how it is laid out there, the way
+/// UnswizzleImage and SwizzleImage read and write it.
+struct DorisLevelPlacement {
+    u32 offset;       ///< From the image's start.
+    u32 size;         ///< Guest bytes of the level.
+    u32 gobs_in_x;    ///< Row pitch in GOBs.
+    u32 block_height; ///< log2 of the GOBs per block.
+    u32 width;        ///< Texels.
+    u32 height;       ///< Texels.
+};
+
+bool DorisLevelPlacements(const ImageInfo& info,
+                          std::array<DorisLevelPlacement, MAX_MIP_LEVELS>& placements) {
+    if (info.type != ImageType::e2D || info.tile_width_spacing != 0 || info.num_samples != 1 ||
+        info.size.depth != 1 || info.block.width != 0 || info.block.depth != 0 ||
+        info.resources.layers != 1) {
+        return false;
+    }
+    const Extent2D tile_size = DefaultBlockSize(info.format);
+    if (tile_size.width != 1 || tile_size.height != 1) {
+        return false;
+    }
+    const u32 num_levels = static_cast<u32>(info.resources.levels);
+    if (num_levels == 0 || num_levels > MAX_MIP_LEVELS) {
+        return false;
+    }
+    const u32 bpp_log2 = BytesPerBlockLog2(info.format);
+    const LevelInfo level_info = MakeLevelInfo(info);
+    const std::array level_sizes = CalculateLevelSizes(level_info, num_levels);
+    const Extent2D gob = GobSize(bpp_log2, info.block.height, info.tile_width_spacing);
+    u32 offset = 0;
+    for (u32 level = 0; level < num_levels; ++level) {
+        const Extent3D level_size = AdjustMipSize(info.size, static_cast<s32>(level));
+        const Extent3D num_tiles = AdjustTileSize(level_size, tile_size);
+        const Extent3D block =
+            AdjustMipBlockSize(num_tiles, level_info.block, level, level_info.num_levels);
+        const u32 stride_alignment = StrideAlignment(num_tiles, info.block, gob, bpp_log2);
+        const u32 stride = Common::AlignUpLog2(num_tiles.width, stride_alignment) << bpp_log2;
+        placements[level] = DorisLevelPlacement{
+            .offset = offset,
+            .size = level_sizes[level],
+            .gobs_in_x = Common::DivCeilLog2(stride, GOB_SIZE_X_SHIFT),
+            .block_height = block.height,
+            .width = level_size.width,
+            .height = level_size.height,
+        };
+        offset += level_sizes[level];
+    }
+    return true;
+}
