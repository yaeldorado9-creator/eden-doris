+std::vector<ImageCopy> DorisSameLayoutCopies(const ImageInfo& dst, GPUVAddr dst_addr,
+                                             const ImageInfo& src, GPUVAddr src_addr) {
+    std::vector<ImageCopy> copies;
+    if (BytesPerBlock(dst.format) != BytesPerBlock(src.format)) {
+        return copies;
+    }
+    std::array<DorisLevelPlacement, MAX_MIP_LEVELS> dst_levels{};
+    std::array<DorisLevelPlacement, MAX_MIP_LEVELS> src_levels{};
+    if (!DorisLevelPlacements(dst, dst_levels) || !DorisLevelPlacements(src, src_levels)) {
+        return copies;
+    }
+    for (s32 dst_level = 0; dst_level < dst.resources.levels; ++dst_level) {
+        const DorisLevelPlacement& d = dst_levels[dst_level];
+        const u64 d_begin = dst_addr + d.offset;
+        const u64 d_end = d_begin + d.size;
+        for (s32 src_level = 0; src_level < src.resources.levels; ++src_level) {
+            const DorisLevelPlacement& s = src_levels[src_level];
+            const u64 s_begin = src_addr + s.offset;
+            const u64 s_end = s_begin + s.size;
+            if (s_begin >= d_end || d_begin >= s_end || d.gobs_in_x != s.gobs_in_x) {
+                continue;
+            }
+            // One GOB wide, the GOBs simply follow each other downwards whatever the block
+            // height; wider, the blocks must be equally tall.
+            const bool one_column = d.gobs_in_x == 1;
+            if (!one_column && d.block_height != s.block_height) {
+                continue;
+            }
+            const s64 unit = one_column
+                                 ? static_cast<s64>(GOB_SIZE)
+                                 : static_cast<s64>(u64{d.gobs_in_x}
+                                                    << (GOB_SIZE_SHIFT + d.block_height));
+            const s64 rows_per_unit =
+                one_column ? s64{GOB_SIZE_Y} : (s64{GOB_SIZE_Y} << d.block_height);
+            const s64 delta = static_cast<s64>(s_begin) - static_cast<s64>(d_begin);
+            if (delta % unit != 0) {
+                continue;
+            }
+            // The source's row 0 is the destination's row dy.
+            const s64 dy = delta / unit * rows_per_unit;
+            const s64 y0 = (std::max)(s64{0}, dy);
+            const s64 y1 = (std::min)(static_cast<s64>(d.height), dy + static_cast<s64>(s.height));
+            const u32 width = (std::min)(d.width, s.width);
+            if (y0 >= y1 || width == 0) {
+                continue;
+            }
+            copies.push_back(ImageCopy{
+                .src_subresource = {.base_level = src_level, .base_layer = 0, .num_layers = 1},
+                .dst_subresource = {.base_level = dst_level, .base_layer = 0, .num_layers = 1},
+                .src_offset = {0, static_cast<s32>(y0 - dy), 0},
+                .dst_offset = {0, static_cast<s32>(y0), 0},
+                .extent = {width, static_cast<u32>(y1 - y0), 1},
+            });
+        }
+    }
+    return copies;
+}
+
+std::string DorisWhyNotSubresource(const ImageInfo& candidate, const ImageBase& image,
+                                   GPUVAddr candidate_addr, RelaxedOptions options) {
+    const ImageInfo& existing = image.info;
+    if (candidate_addr < image.gpu_addr) {
+        return "starts before it";
+    }
+    const u64 diff = candidate_addr - image.gpu_addr;
+    if (diff > image.guest_size_bytes) {
+        return fmt::format("starts {} bytes in, past its {}", diff, image.guest_size_bytes);
+    }
+    const std::optional<SubresourceBase> base = image.TryFindBase(candidate_addr);
+    if (!base) {
+        return fmt::format("+{} is no level or layer start (layer stride {})", diff,
+                           existing.layer_stride);
+    }
+    if (True(options & RelaxedOptions::Format)) {
+        if (BytesPerBlock(existing.format) != BytesPerBlock(candidate.format)) {
+            return fmt::format("bytes per texel {} vs {}", BytesPerBlock(existing.format),
+                               BytesPerBlock(candidate.format));
+        }
+    }
+    if (!IsLayerStrideCompatible(existing, candidate)) {
+        return fmt::format("layer stride {}/{} vs {}/{}", existing.layer_stride,
+                           existing.maybe_unaligned_layer_stride, candidate.layer_stride,
+                           candidate.maybe_unaligned_layer_stride);
+    }
+    if (existing.type != candidate.type) {
+        return fmt::format("type {} vs {}", static_cast<int>(existing.type),
+                           static_cast<int>(candidate.type));
+    }
+    if (False(options & RelaxedOptions::Samples) && existing.num_samples != candidate.num_samples) {
+        return fmt::format("samples {} vs {}", existing.num_samples, candidate.num_samples);
+    }
+    if (existing.resources.levels < candidate.resources.levels + base->level) {
+        return fmt::format("level {} + {} levels, has {}", base->level, candidate.resources.levels,
+                           existing.resources.levels);
+    }
+    if (existing.type == ImageType::e3D) {
+        const u32 mip_depth = AdjustMipSize(existing.size.depth, base->level);
+        if (mip_depth < candidate.size.depth + base->layer) {
+            return fmt::format("depth {} at slice {}, has {}", candidate.size.depth, base->layer,
+                               mip_depth);
+        }
+    } else if (existing.resources.layers < candidate.resources.layers + base->layer) {
+        return fmt::format("layer {} + {} layers, has {}", base->layer,
+                           candidate.resources.layers, existing.resources.layers);
+    }
+    const bool strict_size = False(options & RelaxedOptions::Size);
+    if (!IsBlockLinearSizeCompatible(existing, candidate, base->level, 0, strict_size)) {
+        const Extent3D lhs = strict_size ? AdjustMipSize(existing.size, base->level)
+                                         : BlockLinearAlignedSize(existing, base->level);
+        const Extent3D rhs =
+            strict_size ? AdjustMipSize(candidate.size, 0) : BlockLinearAlignedSize(candidate, 0);
+        return fmt::format("size at level {} {}x{} vs {}x{}", base->level, lhs.width, lhs.height,
+                           rhs.width, rhs.height);
+    }
+    return "ok";
+}
+
+const char* DorisFormatName(PixelFormat format) noexcept {
+    switch (format) {
+#define PIXEL_FORMAT_ELEM(name, ...)                                                               \
+    case PixelFormat::name:                                                                        \
+        return #name;
+        PIXEL_FORMAT_LIST
+#undef PIXEL_FORMAT_ELEM
+    default:
+        return "invalid";
+    }
+}
+
+std::string DorisDescribeLayout(const ImageInfo& info) {
+    return fmt::format("{} {}x{}x{} type {} levels {} layers {} samples {} block {}/{}/{} "
+                       "tile spacing {} layer stride {}/{} pitch {}",
+                       DorisFormatName(info.format), info.size.width, info.size.height,
+                       info.size.depth, static_cast<int>(info.type), info.resources.levels,
+                       info.resources.layers, info.num_samples, info.block.width,
+                       info.block.height, info.block.depth, info.tile_width_spacing,
+                       info.layer_stride, info.maybe_unaligned_layer_stride, info.pitch);
+}
