+template <class P>
+void TextureCache<P>::DorisNoteBadOverlap(const ImageInfo& new_info, GPUVAddr new_addr,
+                                          const ImageBase& new_image_base,
+                                          const ImageBase& overlap) {
+    Doris::Perf::Add(Doris::Perf::Count::TextureBadOverlaps);
+    if (!Doris::Perf::Enabled()) {
+        return;
+    }
+    constexpr auto options = RelaxedOptions::Size | RelaxedOptions::Format;
+    const std::string as_part_of_other =
+        DorisWhyNotSubresource(new_info, overlap, new_addr, options);
+    const std::string other_as_part =
+        DorisWhyNotSubresource(overlap.info, new_image_base, overlap.gpu_addr, options);
+    const bool same_layout = !DorisSameLayoutCopies(new_info, new_image_base.cpu_addr,
+                                                    overlap.info, overlap.cpu_addr)
+                                  .empty();
+    const s64 offset = static_cast<s64>(new_image_base.cpu_addr) -
+                       static_cast<s64>(overlap.cpu_addr);
+    std::string text = fmt::format(
+        "{} at {:+} of {}: {} / {}{}", DorisDescribeImage(new_image_base), offset,
+        DorisDescribeImage(overlap), as_part_of_other, other_as_part,
+        same_layout ? " (same layout where shared: kept in step)" : "");
+    // The first time a pair of shapes shows up, everything about both layouts goes to the log.
+    static std::set<std::string> logged;
+    if (logged.size() < 400 && logged.insert(text).second) {
+        LOG_INFO(HW_GPU, "Doris textures kept apart: new {} at {:#x} (guest {} bytes) / existing {} "
+                         "at {:#x} (guest {} bytes): {}",
+                 DorisDescribeLayout(new_info), new_addr, new_image_base.guest_size_bytes,
+                 DorisDescribeLayout(overlap.info), overlap.gpu_addr, overlap.guest_size_bytes,
+                 text);
+    }
+    Doris::Perf::NoteTexture(Doris::Perf::Note::NotJoined, std::move(text));
+}
