+template <class P>
+void TextureCache<P>::DorisSyncOverlaps(ImageId image_id) {
+    // Eden (Doris): images sharing memory that Eden can't join as one image or as aliases
+    // ("bad overlap") never exchange contents, so what the GPU draws through one never reaches
+    // the other (guest memory doesn't get it either). Where both lay the shared memory out the
+    // same way, the newer drawing is copied over, as the memory itself would show it.
+    Image& image = slot_images[image_id];
+    const u64 seen_tick = (std::max)(image.modification_tick, image.doris_overlaps_seen_tick);
+    boost::container::small_vector<ImageId, 8> sources;
+    u64 newest_tick = seen_tick;
+    for (const ImageId other_id : image.overlapping_images) {
+        const Image& other = slot_images[other_id];
+        if (other.modification_tick <= seen_tick) {
+            continue;
+        }
+        newest_tick = (std::max)(newest_tick, other.modification_tick);
+        if (other.IsSafeGpuCopy()) {
+            sources.push_back(other_id);
+        }
+    }
+    image.doris_overlaps_seen_tick = newest_tick;
+    if (sources.empty()) {
+        return;
+    }
+    // Converted images hold another host format than the guest's: left out.
+    constexpr auto SKIPPED = ImageFlagBits::Sparse | ImageFlagBits::Rescaled |
+                             ImageFlagBits::Converted;
+    if (GetFormatType(image.info.format) != SurfaceType::ColorTexture ||
+        True(image.flags & SKIPPED)) {
+        return;
+    }
+    std::ranges::sort(sources, [this](ImageId lhs, ImageId rhs) {
+        return slot_images[lhs].modification_tick < slot_images[rhs].modification_tick;
+    });
+    for (const ImageId source_id : sources) {
+        Image& source = slot_images[source_id];
+        if (GetFormatType(source.info.format) != SurfaceType::ColorTexture ||
+            True(source.flags & SKIPPED)) {
+            continue;
+        }
+        // The memory they share is what matters (both are contiguous: sparse ones are left out).
+        std::vector<ImageCopy> copies =
+            DorisSameLayoutCopies(image.info, image.cpu_addr, source.info, source.cpu_addr);
+        if (copies.empty()) {
+            continue;
+        }
+        // What the game's code wrote over the source since the GPU drew into it goes in first.
+        if (!source.doris_touched_pages.empty()) {
+            DorisResolveTouched(source_id, source);
+            if (True(source.flags & ImageFlagBits::CpuModified)) {
+                continue;
+            }
+        }
+        if (Doris::Perf::Enabled()) {
+            Doris::Perf::NoteTexture(Doris::Perf::Note::SameLayoutSynced,
+                                     fmt::format("{} from {}", DorisDescribeImage(image),
+                                                 DorisDescribeImage(source)));
+        }
+        Doris::Perf::Add(Doris::Perf::Count::TextureSameLayoutSyncs);
+        CopyImage(image_id, source_id, std::move(copies));
+        image.modification_tick = (std::max)(image.modification_tick, source.modification_tick);
+        image.flags |= ImageFlagBits::GpuModified;
+    }
+}
+
+template <class P>
+void TextureCache<P>::DorisBringUpToDate(ImageId image_id) {
+    Image& image = slot_images[image_id];
+    if (!image.aliased_images.empty()) {
+        SynchronizeAliases(image_id);
+    }
+    if (!image.overlapping_images.empty()) {
+        DorisSyncOverlaps(image_id);
+    }
+}
