@@ -7,6 +7,7 @@
 #pragma once
 
 #include <algorithm>
+#include <chrono>
 #include <array>
 #include <atomic>
 #include <condition_variable>
@@ -123,6 +124,13 @@ public:
         return is_built.load(std::memory_order::relaxed);
     }
 
+    /// Eden (Doris): wait up to `timeout` for the pipeline to finish building. True if it is built.
+    bool WaitBuiltFor(std::chrono::microseconds timeout) {
+        std::unique_lock lock{build_mutex};
+        return build_condvar.wait_for(
+            lock, timeout, [this] { return is_built.load(std::memory_order::relaxed); });
+    }
+
     template <typename Spec>
     static auto MakeConfigureSpecFunc() {
         return [](GraphicsPipeline* pl, bool is_indexed) { return pl->ConfigureImpl<Spec>(is_indexed); };
diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
index 6e6120d1b..c4474fd75 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -747,6 +747,24 @@ GraphicsPipeline* PipelineCache::BuiltPipeline(GraphicsPipeline* pipeline) const
     if (draw_state.index_buffer.count <= 6 || draw_state.vertex_buffer.count <= 6) {
         return pipeline;
     }
+    // Eden (Doris): before skipping the draw (which leaves the object invisible this frame), give
+    // the shader a little time to finish, from a budget shared by all draws in a ~33 ms window.
+    using namespace std::chrono;
+    const u32 wait_ms{Settings::values.doris_async_shader_wait_ms.GetValue()};
+    if (wait_ms != 0) {
+        const auto now = steady_clock::now();
+        if (now - doris_wait_window_start > milliseconds{33}) {
+            doris_wait_window_start = now;
+            doris_wait_left = milliseconds{wait_ms};
+        }
+        if (doris_wait_left > microseconds::zero()) {
+            const bool built = pipeline->WaitBuiltFor(doris_wait_left);
+            doris_wait_left -= duration_cast<microseconds>(steady_clock::now() - now);
+            if (built) {
+                return pipeline;
+            }
+        }
+    }
     return nullptr;
 }
 
