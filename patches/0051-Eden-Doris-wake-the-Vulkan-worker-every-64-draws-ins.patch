From a05cf3037b52f4162103a6fef500e3b4a430eda8 Mon Sep 17 00:00:00 2001
From: "Eden (Doris) build" <doris@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:01:23 -0500
Subject: [PATCH] Eden (Doris): wake the Vulkan worker every 64 draws instead
 of 16 (less CPU wake-ups, same GPU work)

Build 26 (with NCE reads off, i.e. build 19's code) still woke the Vulkan worker about 175 times
per frame. Each is a futex call and a context switch that keeps a middle core awake and at full
clock. Hand recorded work over every 64 draws instead; submits still happen every 512 draws as
before, so the GPU gets the same commands at the same points.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014Ps8wnhVXtSU7d88gGtyHX
---
 src/video_core/renderer_vulkan/vk_rasterizer.cpp | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index 773fe3667..5783fe63d 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -1105,11 +1105,13 @@ void RasterizerVulkan::LoadDiskResources(u64 title_id, std::stop_token stop_load
 void RasterizerVulkan::FlushWork() {
 #ifdef __ANDROID__
     static constexpr u32 DRAWS_TO_DISPATCH = 512;
-    // Eden (Doris): hand recorded work to the Vulkan worker every 16 draws instead of 4. The
-    // worker is usually asleep by then, and waking it is a futex system call: 500 to 780 per
-    // frame in build 15, several milliseconds of the GPU thread. Submits still happen every 512
-    // draws exactly as in Eden, so the GPU starts its work at the same moments.
-    static constexpr u32 CHECK_MASK = 15;
+    // Eden (Doris): hand recorded work to the Vulkan worker every 64 draws instead of 4. The
+    // worker is usually asleep by then, and waking it is a futex system call and a context
+    // switch: 500 to 780 per frame in build 15, still about 175 per frame at 16 draws (build 26),
+    // keeping the middle cores awake and at full clock. Submits still happen every 512 draws
+    // exactly as in Eden, so the GPU gets the same work at the same points; only how often the
+    // worker is woken changes.
+    static constexpr u32 CHECK_MASK = 63;
 #else
     static constexpr u32 DRAWS_TO_DISPATCH = 4096;
     static constexpr u32 CHECK_MASK = 7;
