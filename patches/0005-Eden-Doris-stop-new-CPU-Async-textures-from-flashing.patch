+template <class P>
+void TextureCache<P>::DorisWaitForDecode(ImageId image_id) {
+    using namespace std::chrono;
+    const u32 wait_ms{Settings::values.doris_texture_decode_wait_ms.GetValue()};
+    if (wait_ms == 0 || async_decodes.empty()) {
+        return;
+    }
+    if (doris_decode_budget_frame != frame_tick) {
+        doris_decode_budget_frame = frame_tick;
+        doris_decode_wait_left = milliseconds{wait_ms};
+    }
+    AsyncDecodeContext* const decode = async_decodes.back().get();
+    if (decode->image_id != image_id || doris_decode_wait_left <= microseconds::zero()) {
+        return;
+    }
+    const auto start = steady_clock::now();
+    const auto deadline = start + doris_decode_wait_left;
+    while (!decode->complete.load(std::memory_order_acquire) && steady_clock::now() < deadline) {
+        std::this_thread::sleep_for(microseconds{100});
+    }
+    doris_decode_wait_left -= duration_cast<microseconds>(steady_clock::now() - start);
+    if (!decode->complete.load(std::memory_order_acquire)) {
+        return; // still decoding: TickAsyncDecode uploads it at the end of the frame, as in Eden
+    }
+    {
+        std::unique_lock lock{decode->mutex};
+        Image& image = slot_images[image_id];
+        auto staging = runtime.UploadStagingBuffer(MapSizeBytes(image));
+        std::memcpy(staging.mapped_span.data(), decode->decoded_data.data(),
+                    decode->decoded_data.size());
+        image.UploadMemory(staging, FixSmallVectorADL(decode->copies));
+        image.flags &= ~ImageFlagBits::IsDecoding;
+    }
+    async_decodes.pop_back();
+    runtime.InsertUploadMemoryBarrier();
+}
