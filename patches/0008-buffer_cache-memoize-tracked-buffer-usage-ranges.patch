From 6ffb4c0c4c5ccdca14960f4d66c1826cc7a93137 Mon Sep 17 00:00:00 2001
From: alvindimas05 <alvin.dimas.praditya@gmail.com>
Date: Thu, 22 Oct 2026 23:24:36 +0700
Subject: [PATCH 08/49] [buffer_cache] memoize tracked buffer usage ranges

(cherry picked from commit b0ed7aa8a80e18ba8fc69f8b5ef986e842c22d91)
---
 src/video_core/renderer_vulkan/vk_buffer_cache.cpp | 11 +++++++++++
 src/video_core/renderer_vulkan/vk_buffer_cache.h   |  7 +++++++
 2 files changed, 18 insertions(+)

diff --git a/src/video_core/renderer_vulkan/vk_buffer_cache.cpp b/src/video_core/renderer_vulkan/vk_buffer_cache.cpp
index a734bd049..b8dda309a 100644
--- a/src/video_core/renderer_vulkan/vk_buffer_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_buffer_cache.cpp
@@ -112,7 +112,18 @@ Buffer::Buffer(BufferCacheRuntime& runtime, DAddr cpu_addr_, u64 size_bytes_)
 }
 
 void Buffer::MarkUsage(u64 offset, u64 size) noexcept {
+    for (u8 i = 0; i < tracked_count; ++i) {
+        if (tracked_ranges[i].offset == offset && tracked_ranges[i].size == size) {
+            last_usage_tick = scheduler->CurrentTick();
+            return;
+        }
+    }
     tracker.Track(offset, size);
+    if (tracked_count < 4) {
+        tracked_ranges[tracked_count++] = {offset, size};
+    } else {
+        tracked_ranges[0] = {offset, size};
+    }
     last_usage_tick = scheduler->CurrentTick();
 }
 
diff --git a/src/video_core/renderer_vulkan/vk_buffer_cache.h b/src/video_core/renderer_vulkan/vk_buffer_cache.h
index 9b3dd50ea..ff1f36946 100644
--- a/src/video_core/renderer_vulkan/vk_buffer_cache.h
+++ b/src/video_core/renderer_vulkan/vk_buffer_cache.h
@@ -51,6 +51,7 @@ public:
 
     void ResetUsageTracking() noexcept {
         tracker.Reset();
+        tracked_count = 0;
     }
 
     [[nodiscard]] u64 LastUsageTick() const noexcept {
@@ -76,6 +77,12 @@ private:
     VideoCommon::UsageTracker tracker;
     VkDeviceAddress device_address{};
     u64 last_usage_tick{};
+    struct TrackedRange {
+        u64 offset{};
+        u64 size{};
+    };
+    std::array<TrackedRange, 4> tracked_ranges{};
+    u8 tracked_count{};
     bool is_null{};
 };
 
