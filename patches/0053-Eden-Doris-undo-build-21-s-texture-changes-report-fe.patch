-    // The first time a pair of shapes shows up, everything about both layouts goes to the log.
+        same_layout ? " (same layout where shared)" : "");
+    // The first time a pair of shapes shows up, everything about both layouts goes to the log
+    // (by shapes: the offsets vary as the game reuses memory).
     static std::set<std::string> logged;
-    if (logged.size() < 400 && logged.insert(text).second) {
+    std::string shapes = fmt::format("{} / {}", DorisDescribeImage(new_image_base),
+                                     DorisDescribeImage(overlap));
+    if (logged.size() < 300 && logged.insert(std::move(shapes)).second) {
         LOG_INFO(HW_GPU, "Doris textures kept apart: new {} at {:#x} (guest {} bytes) / existing {} "
                          "at {:#x} (guest {} bytes): {}",
                  DorisDescribeLayout(new_info), new_addr, new_image_base.guest_size_bytes,
@@ -3361,9 +3279,6 @@ void TextureCache<P>::PrepareImage(ImageId image_id, bool is_modification, bool
         if (!image.aliased_images.empty()) {
             SynchronizeAliases(image_id);
         }
-        if (!image.overlapping_images.empty()) {
-            DorisSyncOverlaps(image_id);
-        }
     }
     if (is_modification) {
         MarkModification(image);
