 #include <mutex>
 #include <numeric>
 
+#include "common/doris_perf.h"
 #include "common/range_sets.inc"
 #include "video_core/buffer_cache/buffer_cache_base.h"
 #include "video_core/guest_memory.h"
@@ -762,6 +763,7 @@ void BufferCache<P>::CommitAsyncFlushesHigh() {
         async_buffers.emplace_back(std::optional<Async_Buffer>{});
         return;
     }
+    Doris::Perf::Add(Doris::Perf::Count::FenceCopyBackBytes, total_size_bytes);
     auto download_staging = runtime.DownloadStagingBuffer(total_size_bytes, true);
     boost::container::small_vector<BufferCopy, 4> normalized_copies;
     runtime.PreCopyBarrier();
diff --git a/src/video_core/fence_manager.h b/src/video_core/fence_manager.h
index 1a3a5435b..a0117a08f 100644
--- a/src/video_core/fence_manager.h
+++ b/src/video_core/fence_manager.h
@@ -76,6 +76,12 @@ public:
     void SignalFence(std::function<void()>&& func) {
         const bool delay_fence = Settings::IsGPUFenceBehaviorDefault() ? Settings::IsGPULevelHigh() : Settings::IsGPUFenceBehaviorBalanced() || Settings::IsGPUFenceBehaviorAccurate() || Settings::IsGPUFenceBehaviorStrict();
         const bool should_flush = ShouldFlush();
+        // Eden (Doris): for the report, how often the game is told the GPU is done while bytes
+        // the GPU wrote are still on their way back to guest memory.
+        Doris::Perf::Add(Doris::Perf::Count::Fences);
+        if (!delay_fence && should_flush) {
+            Doris::Perf::Add(Doris::Perf::Count::FencesBeforeCopyBack);
+        }
         if constexpr (!can_async_check) {
             TryReleasePendingFences<false>();
         }
