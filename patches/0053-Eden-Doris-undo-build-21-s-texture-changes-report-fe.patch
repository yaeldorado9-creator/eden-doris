                 Doris::Perf::Add(Doris::Perf::Count::GcDownloaded);
                 auto map = runtime.DownloadStagingBuffer(image.unswizzled_size_bytes, true);
                 const auto copies = FixSmallVectorADL(FullDownloadCopies(image.info));
@@ -2365,14 +2361,9 @@ ImageId TextureCache<P>::JoinImages(const ImageInfo& info, GPUVAddr gpu_addr, DA
             const AliasedImage& aliased = new_image.aliased_images[alias_pointer->second];
             CopyImage(new_image_id, aliased.id, aliased.copies);
             new_image.modification_tick = overlap.modification_tick;
-            // Eden (Doris): the new image now holds what the GPU drew into the alias (only
-            // GPU-drawn aliases are copied), which guest memory doesn't have. Eden left it
