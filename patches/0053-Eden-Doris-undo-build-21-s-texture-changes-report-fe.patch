@@ -606,12 +606,13 @@ void ReportLoop() {
                  gauge_of(Gauge::TextureCacheExpected), gauge_of(Gauge::TextureCacheCritical));
         LOG_INFO(Frontend,
                  "Doris perf: textures sharing memory: {} pairs kept apart as each new one was "
-                 "created, {} created with copies of GPU drawings (now kept as GPU-drawn), {} "
-                 "brought up to date from same-layout GPU drawings, {} uploaded again from guest "
-                 "memory next to GPU drawings",
+                 "created, {} created with copies of GPU drawings, {} uploaded again from guest "
+                 "memory next to GPU drawings | fences {}, {} of them released to the game before "
+                 "the GPU-written data they cover was copied back ({:.2f} MiB copied back at fences)",
                  count_of(Count::TextureBadOverlaps), count_of(Count::TextureCreatedFromGpuData),
-                 count_of(Count::TextureSameLayoutSyncs),
-                 count_of(Count::TextureUploadsBesideGpuData));
+                 count_of(Count::TextureUploadsBesideGpuData), count_of(Count::Fences),
+                 count_of(Count::FencesBeforeCopyBack),
+                 static_cast<double>(count_of(Count::FenceCopyBackBytes)) / (1024.0 * 1024.0));
 
         // Which textures lost GPU-drawn contents, and how.
         {
@@ -626,7 +627,7 @@ void ReportLoop() {
                 "removed with GPU-drawn contents lost",
                 "GPU-drawn, then marked as changed as a whole",
                 "created with copies of GPU drawings sharing their memory",
-                "brought up to date from GPU drawings sharing their memory",
+                "brought up to date from GPU drawings sharing their memory (build 21)",
                 "uploaded again from guest memory next to GPU drawings",
                 "sharing memory but kept apart (why: as part of the other / the other as part of "
                 "it)",
diff --git a/src/common/doris_perf.h b/src/common/doris_perf.h
index 2d7b177f7..090ad67f0 100644
--- a/src/common/doris_perf.h
+++ b/src/common/doris_perf.h
@@ -82,14 +82,19 @@ enum class Count : int {
     /// Textures created with contents copied from GPU drawings sharing their memory (now kept
     /// as GPU-drawn; Eden treated them as plain uploads).
     TextureCreatedFromGpuData,
-    /// Textures brought up to date from newer GPU drawings sharing their memory with the same
-    /// layout, which Eden keeps apart ("bad overlap").
-    TextureSameLayoutSyncs,
     /// Textures uploaded again from guest memory while another texture sharing their memory
     /// holds GPU drawings.
     TextureUploadsBesideGpuData,
     /// Textures sharing memory that Eden keeps apart ("bad overlap"), as each new one is created.
     TextureBadOverlaps,
+    /// Fences the GPU emulation thread signalled (syncpoints and other waits of the game).
+    Fences,
+    /// ... released to the game at once ("GPU fence behaviour: Immediate"), while the bytes the
+    /// GPU wrote into buffers before it were still to be copied back to guest memory: until the
+    /// copy lands the game reads what was there before.
+    FencesBeforeCopyBack,
+    /// Bytes the GPU wrote into buffers, copied back to guest memory at fences.
+    FenceCopyBackBytes,
     Max,
 };
 
