+// ---- Hitch sampler -------------------------------------------------------------------------
+
+constexpr auto HITCH_ARM_AFTER = std::chrono::milliseconds{40};
+constexpr auto HITCH_SAMPLE_EVERY = std::chrono::milliseconds{2};
+constexpr double HITCH_MIN_MS = 50.0;
+constexpr uint32_t HITCH_CAPACITY = 4096;   // samples in the ring (8 s of sampling)
+constexpr size_t HITCHES_KEPT = 60;
+constexpr auto HITCH_WRITE_INTERVAL = std::chrono::seconds{10};
+
+struct HitchSampler {
+    /// The sampled thread (the current GPU emulation thread) while active.
+    std::atomic<int> tid{0};
+    uintptr_t stack_low{};
+    uintptr_t stack_high{};
+    std::atomic<bool> active{false};
+    /// Start of the frame in progress (steady clock, ns) and its number.
+    std::atomic<int64_t> frame_start_ns{0};
+    std::atomic<uint32_t> frame_id{0};
+    /// Ring of samples; written only by the signal handler on the sampled thread.
+    std::array<Sample, HITCH_CAPACITY> samples{};
+    std::atomic<uint32_t> write_pos{0};
+    uint32_t frame_first_pos{0}; // sampled thread only
+};
+HitchSampler hitch;
+
+struct FinishedHitch {
+    double frame_ms;
+    std::chrono::steady_clock::time_point when;
+    std::vector<Sample> samples;
+};
+std::mutex finished_mutex;
+std::deque<FinishedHitch> finished_hitches;
+bool finished_dirty = false;
+
+int64_t NowNs() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+int CurrentTid() {
+    // bionic keeps the thread id in thread-local storage (no system call, signal safe).
+    return static_cast<int>(gettid());
+}
+
+void HitchHandler(const ucontext_t* context) {
+    // Only ever sample the thread the sampler was started on (its stack bounds are known).
+    if (!hitch.active.load(std::memory_order_acquire) ||
+        CurrentTid() != hitch.tid.load(std::memory_order_relaxed)) {
+        return;
+    }
+    const uint32_t position = hitch.write_pos.load(std::memory_order_relaxed);
+    Sample& sample = hitch.samples[position % HITCH_CAPACITY];
+    sample.pc = static_cast<uintptr_t>(context->uc_mcontext.pc);
+    sample.lr = static_cast<uintptr_t>(context->uc_mcontext.regs[30]);
+    uint32_t depth = 0;
+    uintptr_t fp = static_cast<uintptr_t>(context->uc_mcontext.regs[29]);
+    while (depth < sample.frames.size()) {
+        if ((fp & 15) != 0 || fp < hitch.stack_low || fp + 16 > hitch.stack_high) {
+            break;
+        }
+        const auto* record = reinterpret_cast<const uintptr_t*>(fp);
+        const uintptr_t next = record[0];
+        const uintptr_t ret = record[1];
+        if (ret == 0) {
+            break;
+        }
+        sample.frames[depth++] = ret;
+        if (next <= fp) {
+            break;
+        }
+        fp = next;
+    }
+    sample.depth = depth;
+    hitch.write_pos.store(position + 1, std::memory_order_release);
+}
+
+/// Wakes up when the current frame turns 40 ms old, then samples the thread every 2 ms until
+/// the frame ends. Between hitches it wakes about once per frame and does nothing else.
+void HitchWatchdogLoop() {
+    Common::SetCurrentThreadName("DorisHitches");
+    Common::SetCurrentThreadToEfficiencyCores();
+    std::unordered_map<uintptr_t, Location> cache;
+    const std::string path =
+        Common::FS::GetEdenPathString(Common::FS::EdenPath::LogDir) + "/doris_hitches.txt";
+    auto last_write = std::chrono::steady_clock::now();
+    std::deque<FinishedHitch> kept;
+    size_t total_hitches = 0;
+    const auto start = std::chrono::steady_clock::now();
+    std::vector<uintptr_t> stack;
+    while (true) {
+        if (!hitch.active.load(std::memory_order_acquire)) {
+            std::this_thread::sleep_for(std::chrono::milliseconds{100});
+            continue;
+        }
+        const uint32_t id = hitch.frame_id.load(std::memory_order_acquire);
+        const int64_t frame_start = hitch.frame_start_ns.load(std::memory_order_acquire);
+        const auto armed_at = std::chrono::steady_clock::time_point{
+            std::chrono::nanoseconds{frame_start}} + HITCH_ARM_AFTER;
+        if (std::chrono::steady_clock::now() < armed_at) {
+            std::this_thread::sleep_until(armed_at);
+        }
+        // Sample while the same frame is still running (for at most 2 seconds: longer means
+        // emulation is paused or loading, not a hitch).
+        constexpr int64_t SAMPLE_AT_MOST_NS = 2'000'000'000;
+        while (hitch.frame_id.load(std::memory_order_acquire) == id &&
+               hitch.active.load(std::memory_order_acquire)) {
+            if (NowNs() - frame_start > SAMPLE_AT_MOST_NS) {
+                std::this_thread::sleep_for(std::chrono::milliseconds{50});
+                continue;
+            }
+            // tgkill, not pthread_kill: if the thread has just exited this fails harmlessly.
+            syscall(SYS_tgkill, static_cast<int>(getpid()), hitch.tid.load(), SIGPROF);
+            std::this_thread::sleep_for(HITCH_SAMPLE_EVERY);
+        }
+        // Collect finished hitches and write them out now and then.
+        {
+            std::scoped_lock lock{finished_mutex};
+            while (!finished_hitches.empty()) {
+                kept.push_back(std::move(finished_hitches.front()));
+                finished_hitches.pop_front();
+                ++total_hitches;
+                if (kept.size() > HITCHES_KEPT) {
+                    kept.pop_front();
+                }
+            }
+            if (!finished_dirty ||
+                std::chrono::steady_clock::now() - last_write < HITCH_WRITE_INTERVAL) {
+                continue;
+            }
+            finished_dirty = false;
+        }
+        last_write = std::chrono::steady_clock::now();
