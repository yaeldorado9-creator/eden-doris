From 0985840de05b9e2736d9882c7424c223c3453771 Mon Sep 17 00:00:00 2001
From: "Eden (Doris) build" <doris@users.noreply.github.com>
Date: Thu, 29 Oct 2026 11:28:59 -0500
Subject: [PATCH 27/34] Eden (Doris): adapt eden-lun speed-ups to this base

- PushImageDescriptors: keep the per-image rescale check (the render targets' scale says nothing
  about a sampled image; compute passes use the same helper)
- ForEachImageInRegion single-page fast path: visit each image once, as the full path does
- DMA pusher run batching: not for IncreaseOnce, where only the first word advances the method
- port eden-lun 924f5904f: SynchronizeBuffer skips the upload scan when the CPU wrote nothing
---
 src/video_core/buffer_cache/buffer_cache.h       | 4 ++++
 src/video_core/dma_pusher.cpp                    | 3 ++-
 src/video_core/renderer_vulkan/pipeline_helper.h | 5 ++---
 src/video_core/texture_cache/texture_cache.h     | 7 +++++++
 4 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
index 57b05f826..6f3bd92f6 100644
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -1763,6 +1763,10 @@ bool BufferCache<P>::SynchronizeBuffer(Buffer& buffer, DAddr device_addr, u32 si
     u64 total_size_bytes = 0;
     u64 largest_copy = 0;
     const DAddr buffer_start = buffer.cpu_addr_cached;
+    // eden-lun 924f5904f: nothing to upload when the CPU wrote nothing in this range.
+    if (!memory_tracker.IsRegionCpuModified(device_addr, size)) {
+        return true;
+    }
     memory_tracker.ForEachUploadRange(device_addr, size, [&](u64 device_addr_out, u64 range_size) {
         upload_copies.push_back(BufferCopy{
             .src_offset = total_size_bytes,
