From e5df80dd2cfc14c42f16f73f557a44e85f614376 Mon Sep 17 00:00:00 2001
From: "Eden (Doris) build" <doris@users.noreply.github.com>
Date: Thu, 29 Oct 2026 13:38:15 -0500
Subject: [PATCH 31/35] Eden (Doris): undo eden-lun "decouple vertex buffer
 dirty from vertex input"

That change pointed the first word of each vertex stream (stride + enable) at
the VertexInput flag in the first dirty table, overwriting the per-stream
VertexBuffer0+i flag the buffer cache relies on. Turning a vertex stream on (or
changing its stride) without rewriting its address then kept the old binding,
often the null one, so the draw read no vertices and the object vanished until
the address was written again. Seen as water, puddles and rivers disappearing
for a moment. With dynamic vertex input off (as on Adreno here) the change had
no speed benefit at all.

This reverts commit 16eee4377ce8a07e73218f666c2065f55695754c.
---
 src/video_core/renderer_vulkan/vk_rasterizer.cpp    | 7 ++++---
 src/video_core/renderer_vulkan/vk_state_tracker.cpp | 3 +--
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index 678444586..fbc664915 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -1935,7 +1935,9 @@ void RasterizerVulkan::UpdateStencilTestEnable(Tegra::Engines::Maxwell3D::Regs&
 
 void RasterizerVulkan::UpdateVertexInput(Tegra::Engines::Maxwell3D::Regs& regs) {
     auto& dirty{maxwell3d->dirty.flags};
-    if (!dirty[Dirty::VertexInput]) {
+    const bool vertex_input_dirty = dirty[Dirty::VertexInput];
+    const bool vertex_buffers_dirty = dirty[VideoCommon::Dirty::VertexBuffers];
+    if (!vertex_input_dirty && !vertex_buffers_dirty) {
         return;
     }
     dirty[Dirty::VertexInput] = false;
@@ -1992,8 +1994,7 @@ void RasterizerVulkan::UpdateVertexInput(Tegra::Engines::Maxwell3D::Regs& regs)
         dirty[Dirty::VertexBinding0 + index] = false;
     }
 
-    scheduler.Record([bindings = std::move(bindings), attributes = std::move(attributes)](
-                         vk::CommandBuffer cmdbuf) {
+    scheduler.Record([bindings, attributes](vk::CommandBuffer cmdbuf) {
         cmdbuf.SetVertexInputEXT(bindings, attributes);
     });
 }
diff --git a/src/video_core/renderer_vulkan/vk_state_tracker.cpp b/src/video_core/renderer_vulkan/vk_state_tracker.cpp
index b523ae358..0b132c97d 100644
--- a/src/video_core/renderer_vulkan/vk_state_tracker.cpp
+++ b/src/video_core/renderer_vulkan/vk_state_tracker.cpp
@@ -214,13 +214,12 @@ void SetupDirtyVertexAttributes(Maxwell3D::DirtyState::Tables& tables) {
 }
 
 void SetupDirtyVertexBindings(Maxwell3D::DirtyState::Tables& tables) {
-    static constexpr size_t stride_offset = 0;
+    // Do NOT include stride here, it's implicit in VertexBuffer
     static constexpr size_t divisor_offset = 3;
     for (size_t i = 0; i < Regs::NumVertexArrays; ++i) {
         const u8 flag = static_cast<u8>(VertexBinding0 + i);
         tables[0][OFF(vertex_stream_instances) + i] = VertexInput;
         tables[1][OFF(vertex_stream_instances) + i] = flag;
-        tables[0][OFF(vertex_streams) + i * NUM(vertex_streams[0]) + stride_offset] = VertexInput;
         tables[0][OFF(vertex_streams) + i * NUM(vertex_streams[0]) + divisor_offset] = VertexInput;
         tables[1][OFF(vertex_streams) + i * NUM(vertex_streams[0]) + divisor_offset] = flag;
     }
