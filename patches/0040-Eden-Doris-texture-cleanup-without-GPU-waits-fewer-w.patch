+template <class P>
+void TextureCache<P>::DorisProcessPendingRemovals() {
+    if constexpr (DORIS_ASYNC_REMOVAL) {
+        // Entries are in the order their copies were recorded, so the first one whose copy is
+        // still running ends the scan (and the GPU's progress is read at most once).
+        while (!doris_pending_removals.empty() &&
+               runtime.DorisIsTickDone(doris_pending_removals.front().gpu_tick)) {
+            // Take the entry out first: DeleteImage below must not find it.
+            DorisPendingRemoval removal = doris_pending_removals.front();
+            doris_pending_removals.erase(doris_pending_removals.begin());
+            doris_pending_bytes -= (std::min)(doris_pending_bytes, removal.staging_bytes);
+
+            auto& image = slot_images[removal.image_id];
+            // When the copy was recorded the texture had not been used for at least 10 frames, so
+            // any use since then (this frame included) shows up here.
+            const bool used_since = image.lru_touch_frame >= removal.issue_frame;
+            const bool drawn_since = image.modification_tick != removal.modification_tick;
+            const bool written_by_cpu = True(image.flags & ImageFlagBits::CpuModified);
+            if (used_since || drawn_since || written_by_cpu) {
+                // Still in use, or its contents changed: keep it.
+                Doris::Perf::Add(Doris::Perf::Count::GcCancelled);
+                runtime.FreeDeferredStagingBuffer(removal.staging);
+                continue;
+            }
+            const auto copies = FixSmallVectorADL(FullDownloadCopies(image.info));
+            SwizzleImage(*gpu_memory, image.gpu_addr, image.info, copies,
+                         removal.staging.mapped_span, swizzle_data_buffer);
+            runtime.FreeDeferredStagingBuffer(removal.staging);
+            Doris::Perf::Add(Doris::Perf::Count::GcRemoved);
+            if (True(image.flags & ImageFlagBits::Tracked)) {
+                UntrackImage(image, removal.image_id);
+            }
+            UnregisterImage(removal.image_id);
+            DeleteImage(removal.image_id, image.scale_tick > frame_tick + 5);
+        }
+    }
+}
+
+template <class P>
+void TextureCache<P>::DorisForgetPendingRemoval(ImageId image_id) {
+    if constexpr (DORIS_ASYNC_REMOVAL) {
+        for (auto it = doris_pending_removals.begin(); it != doris_pending_removals.end(); ++it) {
+            if (it->image_id == image_id) {
+                doris_pending_bytes -= (std::min)(doris_pending_bytes, it->staging_bytes);
+                runtime.FreeDeferredStagingBuffer(it->staging);
+                doris_pending_removals.erase(it);
+                return;
+            }
+        }
+    }
+}
+
+template <class P>
+bool TextureCache<P>::DorisIsPendingRemoval(ImageId image_id) const noexcept {
+    return std::ranges::any_of(doris_pending_removals, [image_id](const auto& removal) {
+        return removal.image_id == image_id;
+    });
+}
