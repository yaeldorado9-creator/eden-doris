+                     "for presentation {:.1f} ms; Vulkan worker waited for shaders {:.1f} ms | "
+                     "{} new pipelines, {} texture uploads, {} textures removed ({} copies back "
+                     "started), {} draws, {} dispatches, {} render passes, {} submits, {} "
+                     "wait-for-idles, {} protection changes, {} worker wake-ups",
+                     hitch.frame_ms, std::chrono::duration<double>(now - hitch.end).count(),
+                     window_hitch_count, HITCH_MS, hitch.gpu_thread_cpu_ms, w(Wait::GpuFence),
+                     w(Wait::PresentFrame), w(Wait::Shaders), c(Count::NewPipelines),
+                     c(Count::TextureUploads), c(Count::GcRemoved), c(Count::GcDownloaded),
+                     c(Count::Draws), c(Count::Dispatches), c(Count::RenderPasses),
+                     c(Count::Submits), c(Count::WaitForIdle), c(Count::ProtectCalls),
