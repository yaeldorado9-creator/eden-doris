+template <class P>
+void TextureCache<P>::DorisRunGarbageCollector() {
+    // Eden (Doris) texture cleanup. Same rules as Eden's, except:
+    // - Textures the GPU drew into are copied back to guest memory without waiting for the GPU;
+    //   each one is removed only once its copy is done (a later frame), and not at all if it was
+    //   used, drawn into or written by the CPU in the meantime. Eden waited for the GPU to finish
+    //   all queued work for every such copy, a hitch each time (build 15: 63 to 1983 of them
+    //   every 10 seconds).
+    // - Below the pressure threshold, textures must be unused for 300 frames (Eden: 50) before
+    //   they go, GPU drawings included (Eden kept those until there was pressure, so they piled
+    //   up until it started removing everything older than 25 frames: TotK sat just above Eden's
+    //   threshold and re-uploaded 700 to 3500 textures every 10 seconds).
+    // - The pressure threshold is 2.2 GiB (Eden 1.6 GiB of the 4 GiB budget); critical stays.
+    const u64 pressure_threshold = DorisPressureThreshold();
+    constexpr size_t MAX_PENDING_REMOVALS = 64;
+    constexpr size_t MAX_PENDING_BYTES = 128_MiB;
+
+    bool high_priority_mode = false;
+    bool aggressive_mode = false;
+    u64 ticks_to_destroy = 0;
+    size_t num_iterations = 0;
+    const auto Configure = [&](bool allow_aggressive) {
+        high_priority_mode = total_used_memory >= pressure_threshold;
+        aggressive_mode = allow_aggressive && total_used_memory >= critical_memory;
+        ticks_to_destroy = aggressive_mode ? 10ULL : high_priority_mode ? 25ULL : 300ULL;
+        num_iterations = aggressive_mode ? 40 : (high_priority_mode ? 20 : 10);
+    };
+    const auto Cleanup = [&](ImageId image_id) {
+        if (num_iterations == 0) {
+            return true;
+        }
+        if (DorisIsPendingRemoval(image_id)) {
+            return false;
+        }
+        --num_iterations;
+        auto& image = slot_images[image_id];
+        if (True(image.flags & ImageFlagBits::IsDecoding)) {
+            return false;
+        }
+        if (!aggressive_mode && True(image.flags & ImageFlagBits::CostlyLoad)) {
+            return false;
+        }
+        const bool must_download =
+            IsDownloadable(image) && False(image.flags & ImageFlagBits::BadOverlap);
+        if (must_download) {
+            if constexpr (DORIS_ASYNC_REMOVAL) {
+                if (doris_pending_removals.size() >= MAX_PENDING_REMOVALS ||
+                    doris_pending_bytes >= MAX_PENDING_BYTES) {
+                    return false;
+                }
+                Doris::Perf::Add(Doris::Perf::Count::GcDownloaded);
+                auto map = runtime.DownloadStagingBuffer(image.unswizzled_size_bytes, true);
+                const auto copies = FixSmallVectorADL(FullDownloadCopies(image.info));
+                image.DownloadMemory(map, copies);
+                doris_pending_removals.push_back(DorisPendingRemoval{
+                    .image_id = image_id,
+                    .staging = map,
+                    .gpu_tick = runtime.DorisCurrentTick(),
+                    .issue_frame = frame_tick,
+                    .modification_tick = image.modification_tick,
+                    .staging_bytes = image.unswizzled_size_bytes,
+                });
+                doris_pending_bytes += image.unswizzled_size_bytes;
+            }
+            return false;
+        }
+        Doris::Perf::Add(Doris::Perf::Count::GcRemoved);
+        if (True(image.flags & ImageFlagBits::GpuModified)) {
+            Doris::Perf::Add(Doris::Perf::Count::GcDroppedGpuData);
+        }
+        if (True(image.flags & ImageFlagBits::Tracked)) {
+            UntrackImage(image, image_id);
+        }
+        UnregisterImage(image_id);
+        DeleteImage(image_id, image.scale_tick > frame_tick + 5);
+        if (aggressive_mode && total_used_memory < critical_memory) {
+            num_iterations >>= 2;
+            aggressive_mode = false;
+        } else if (high_priority_mode && total_used_memory < pressure_threshold) {
+            num_iterations >>= 1;
+            high_priority_mode = false;
+        }
+        return false;
+    };
+    Configure(false);
+    if (frame_tick >= ticks_to_destroy) {
+        lru_cache.ForEachItemBelow(frame_tick - ticks_to_destroy, Cleanup);
+    }
+    if (total_used_memory >= critical_memory) {
+        Configure(true);
+        if (frame_tick >= ticks_to_destroy) {
+            lru_cache.ForEachItemBelow(frame_tick - ticks_to_destroy, Cleanup);
+        }
+    }
+}
+
+template <class P>
+u64 TextureCache<P>::DorisPressureThreshold() const noexcept {
+    if (!DORIS_ASYNC_REMOVAL || Settings::values.doris_texture_cleanup.GetValue() == 0) {
+        return expected_memory;
+    }
+    constexpr u64 DORIS_EXPECTED_MEMORY = 2_GiB + 200_MiB;
+    const u64 below_critical = critical_memory > 1_GiB ? critical_memory - 1_GiB : 0;
+    return (std::max)(expected_memory, (std::min)(DORIS_EXPECTED_MEMORY, below_critical));
+}
