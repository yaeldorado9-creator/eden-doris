+    static u32 doris_sample = 0;
+    if ((++doris_sample & 7) != 0) {
+        return;
+    }
     constexpr auto options = RelaxedOptions::Size | RelaxedOptions::Format;
     const std::string as_part_of_other =
         DorisWhyNotSubresource(new_info, overlap, new_addr, options);
