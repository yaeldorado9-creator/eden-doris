     Doris::Perf::Add(Doris::Perf::Count::RenderPasses);
+    if (framebuffer_handle == doris_last_framebuffer) {
+        // The previous pass drew into the same targets: on a tiled GPU they were written out to
+        // memory when it ended and are read back in now.
+        Doris::Perf::Add(Doris::Perf::Count::RenderPassReopened);
+    }
     state.renderpass = renderpass;
     state.framebuffer = framebuffer_handle;
     state.render_area = render_area;
@@ -508,6 +513,8 @@ void Scheduler::EndRenderPass()
             }
         });
 
+        // Eden (Doris): remembered so the report can count passes reopened on the same targets.
+        doris_last_framebuffer = state.framebuffer;
         state.renderpass = VkRenderPass{};
         num_renderpass_images = 0;
     }
