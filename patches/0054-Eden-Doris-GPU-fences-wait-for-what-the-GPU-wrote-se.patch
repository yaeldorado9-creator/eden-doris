diff --git a/src/common/settings.cpp b/src/common/settings.cpp
index e2c5b532a..07a404021 100644
--- a/src/common/settings.cpp
+++ b/src/common/settings.cpp
@@ -166,12 +166,25 @@ bool IsDMALevelSafe() {
     return values.dma_accuracy.GetValue() == DmaAccuracy::Safe;
 }
 
+namespace {
+// Eden (Doris): "Immediate" fences (or "Default" below High GPU accuracy) behave as "Balanced"
+// while doris_fence_wait is on (see settings.h).
+bool DorisFencesWait() {
+    if (values.doris_fence_wait.GetValue() == 0) {
+        return false;
+    }
+    const GpuFenceBehavior behavior = values.gpu_fence_behavior.GetValue();
+    return behavior == GpuFenceBehavior::Immediate ||
+           (behavior == GpuFenceBehavior::Default && !IsGPULevelHigh());
+}
+} // namespace
+
 bool IsGPUFenceBehaviorDefault() {
-    return values.gpu_fence_behavior.GetValue() == GpuFenceBehavior::Default;
+    return values.gpu_fence_behavior.GetValue() == GpuFenceBehavior::Default && !DorisFencesWait();
 }
 
 bool IsGPUFenceBehaviorBalanced() {
-    return values.gpu_fence_behavior.GetValue() == GpuFenceBehavior::Balanced;
+    return values.gpu_fence_behavior.GetValue() == GpuFenceBehavior::Balanced || DorisFencesWait();
 }
 
 bool IsGPUFenceBehaviorAccurate() {
