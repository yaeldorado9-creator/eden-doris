+
+void Add(Count counter, std::uint64_t amount) {
+    if (!Enabled()) {
+        return;
+    }
+    counters[static_cast<size_t>(counter)].fetch_add(amount, std::memory_order_relaxed);
+}
+
+ScopedWait::ScopedWait(Wait kind_, bool any_thread)
+    : kind{kind_}, active{(any_thread || is_gpu_thread) && Enabled()} {
+    if (active) {
+        start = Clock::now();
+    }
+}
+
+ScopedWait::~ScopedWait() {
+    if (!active) {
+        return;
+    }
+    const auto ns =
+        std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count();
+    wait_ns[static_cast<size_t>(kind)].fetch_add(static_cast<std::uint64_t>(ns),
+                                                std::memory_order_relaxed);
+}
+
+void AddGpuTime(GpuPart part, std::uint64_t nanoseconds) {
+    gpu_ns[static_cast<size_t>(part)].fetch_add(nanoseconds, std::memory_order_relaxed);
+}
+
+void RegisterThread(const char* label) {
+    if (std::strcmp(label, "GPU") == 0) {
+        is_gpu_thread = true;
+    }
+#ifdef DORIS_PERF_PROCFS
+    const size_t index = registered_count.fetch_add(1);
+    if (index >= MAX_REGISTERED) {
+        return;
+    }
+    std::snprintf(registered[index].label, sizeof(registered[index].label), "%s", label);
+    registered[index].tid.store(static_cast<int>(syscall(SYS_gettid)));
+#endif
+}
