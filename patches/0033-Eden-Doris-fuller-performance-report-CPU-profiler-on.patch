+// SPDX-FileCopyrightText: Copyright 2026 Eden (Doris)
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+#include "common/doris_perf.h"
+#include "video_core/vulkan_common/vulkan_wrapper.h"
+
+namespace Vulkan {
+
+class Device;
+
+/// Eden (Doris): measures how long the GPU spends on each command buffer, and on marked parts of
+/// the work (frame generation, output scaling), with GPU timestamps. The results go to the
+/// performance report. Everything here runs on the Vulkan worker thread, where command buffers
+/// are recorded, so it needs no locking. Does nothing while the performance report is off or when
+/// the device can't write timestamps.
+class DorisGpuTimer {
+public:
+    explicit DorisGpuTimer(const Device& device);
+    ~DorisGpuTimer();
+
+    DorisGpuTimer(const DorisGpuTimer&) = delete;
+    DorisGpuTimer& operator=(const DorisGpuTimer&) = delete;
+
+    /// Right after a command buffer begins.
+    void BeginCommandBuffer(vk::CommandBuffer cmdbuf);
+    /// Right before a command buffer ends.
+    void EndCommandBuffer(vk::CommandBuffer cmdbuf);
+
+    /// Around a part of the work. Regions of one part must not nest.
+    void BeginRegion(vk::CommandBuffer cmdbuf, Doris::Perf::GpuPart part);
+    void EndRegion(vk::CommandBuffer cmdbuf, Doris::Perf::GpuPart part);
+
+private:
+    static constexpr std::uint32_t PAIRS = 128;
+
+    enum class PairState : std::uint8_t { Free, Recording, Pending };
+
+    struct Pair {
+        PairState state{PairState::Free};
+        Doris::Perf::GpuPart part{};
+    };
+
+    /// Returns a free pair (reset and ready to be written), or PAIRS if none is free.
+    std::uint32_t AcquirePair(Doris::Perf::GpuPart part);
+    /// Reads every finished pair, adds its time to the report, and frees it.
+    void Collect();
+
+    const Device& device;
+    vk::QueryPool pool;
+    double ns_per_tick{1.0};
+    std::uint64_t tick_mask{~std::uint64_t{0}};
+    bool supported{false};
+
+    std::array<Pair, PAIRS> pairs{};
+    std::uint32_t next_pair{0};
+    std::uint32_t pending{0};
+    std::uint32_t command_buffer_pair{PAIRS};
+    std::array<std::uint32_t, static_cast<size_t>(Doris::Perf::GpuPart::Max)> region_pairs{};
+};
+
+} // namespace Vulkan
