 #pragma once
 
+#include <chrono>
+#include <cstdint>
+
 namespace Doris::Perf {
 
 /// Called once for every frame the game renders. When the "Performance report" setting is on,
 /// the first call starts a low-priority thread that writes a summary to the log every 10 seconds:
 /// frame times, CPU time per emulator thread (and the core it last ran on), CPU cluster and GPU
-/// clocks, GPU load and battery temperature.
+/// clocks, GPU load and battery temperature, plus the counters and timers below.
 void OnGameFrame();
 
+/// True while the "Performance report" setting is on.
+bool Enabled();
+
+/// Work counted per game frame.
+enum class Count : int {
+    Draws,
+    Dispatches,
+    RenderPasses,
+    Submits,
+    NewPipelines,
+    Max,
+};
+
+/// Adds to a counter. Cheap (one relaxed atomic add); does nothing while the report is off.
+void Add(Count counter, std::uint64_t amount = 1);
+
+/// Places where the GPU emulation thread can be held up.
+enum class Wait : int {
+    /// Waiting for a free presentation frame (the display or frame generation is behind).
+    PresentFrame,
+    /// Vulkan worker waiting for a shader/pipeline the frame needs to finish building (the GPU
+    /// gets no new work meanwhile).
+    Shaders,
+    /// Waiting for the GPU to reach a point (fences, synchronization with the game).
+    GpuFence,
+    Max,
+};
+
+/// Measures wall time spent in a scope: on the GPU emulation thread only, or on any thread when
+/// any_thread is true.
+class ScopedWait {
+public:
+    explicit ScopedWait(Wait kind, bool any_thread = false);
+    ~ScopedWait();
+
+    ScopedWait(const ScopedWait&) = delete;
+    ScopedWait& operator=(const ScopedWait&) = delete;
+
+private:
+    Wait kind;
+    bool active;
+    std::chrono::steady_clock::time_point start;
+};
+
+/// Parts of the GPU's own work, measured with GPU timestamps.
+enum class GpuPart : int {
+    /// Every command buffer (all GPU work).
+    Total,
+    /// Scaling the game's image to the screen (FSR etc.).
+    Output,
+    /// Frame generation (Lossless Scaling).
+    FrameGen,
+    Max,
+};
+
+/// Adds measured GPU time.
+void AddGpuTime(GpuPart part, std::uint64_t nanoseconds);
+
+/// Remembers the calling thread (GPU emulation thread or Vulkan worker) so the report can say
+/// which kind of core it mostly ran on.
+void RegisterThread(const char* label);
+
 } // namespace Doris::Perf
