+DorisGpuTimer::DorisGpuTimer(const Device& device_) : device{device_} {
+    region_pairs.fill(PAIRS);
+    if (!device.IsHostQueryResetSupported()) {
+        LOG_INFO(Render_Vulkan, "Doris GPU timer: off (no host query reset)");
+        return;
+    }
+    const auto physical = device.GetPhysical();
+    const auto families = physical.GetQueueFamilyProperties();
+    const u32 family = device.GetGraphicsFamily();
+    if (family >= families.size() || families[family].timestampValidBits == 0) {
+        LOG_INFO(Render_Vulkan, "Doris GPU timer: off (no timestamps on the graphics queue)");
+        return;
+    }
+    const u32 valid_bits = families[family].timestampValidBits;
+    tick_mask = valid_bits >= 64 ? ~std::uint64_t{0} : ((std::uint64_t{1} << valid_bits) - 1);
+    ns_per_tick = static_cast<double>(physical.GetProperties().limits.timestampPeriod);
+    if (ns_per_tick <= 0.0) {
+        LOG_INFO(Render_Vulkan, "Doris GPU timer: off (no timestamp period)");
+        return;
+    }
+    pool = device.GetLogical().CreateQueryPool(VkQueryPoolCreateInfo{
+        .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .queryType = VK_QUERY_TYPE_TIMESTAMP,
+        .queryCount = PAIRS * 2,
+        .pipelineStatistics = 0,
+    });
+    device.GetLogical().ResetQueryPool(*pool, 0, PAIRS * 2);
+    supported = true;
+    LOG_INFO(Render_Vulkan, "Doris GPU timer: on ({} valid bits, {:.2f} ns per tick)", valid_bits,
+             ns_per_tick);
+}
+
+DorisGpuTimer::~DorisGpuTimer() = default;
+
+std::uint32_t DorisGpuTimer::AcquirePair(Doris::Perf::GpuPart part) {
+    if (pending > PAIRS / 2) {
+        Collect();
+    }
+    for (std::uint32_t tried = 0; tried < PAIRS; ++tried) {
+        const std::uint32_t index = next_pair;
+        next_pair = (next_pair + 1) % PAIRS;
+        if (pairs[index].state == PairState::Free) {
+            pairs[index] = Pair{PairState::Recording, part};
+            return index;
+        }
+    }
+    return PAIRS;
+}
+
+void DorisGpuTimer::Collect() {
+    for (std::uint32_t index = 0; index < PAIRS && pending > 0; ++index) {
+        Pair& pair = pairs[index];
+        if (pair.state != PairState::Pending) {
+            continue;
+        }
+        std::array<std::uint64_t, 2> ticks{};
+        const VkResult result = device.GetLogical().GetQueryResults(
+            *pool, index * 2, 2, sizeof(ticks), ticks.data(), sizeof(std::uint64_t),
+            VK_QUERY_RESULT_64_BIT);
+        if (result == VK_NOT_READY) {
+            continue;
+        }
+        if (result == VK_SUCCESS) {
+            const std::uint64_t begin = ticks[0] & tick_mask;
+            const std::uint64_t end = ticks[1] & tick_mask;
+            const std::uint64_t elapsed = (end - begin) & tick_mask;
+            const double ns = static_cast<double>(elapsed) * ns_per_tick;
+            // Ignore nonsense (wrapped counters, results from before a GPU reset).
+            if (ns < 1e9) {
+                Doris::Perf::AddGpuTime(pair.part, static_cast<std::uint64_t>(ns));
+            }
+        }
+        device.GetLogical().ResetQueryPool(*pool, index * 2, 2);
+        pair.state = PairState::Free;
+        --pending;
+    }
+}
+
+void DorisGpuTimer::BeginCommandBuffer(vk::CommandBuffer cmdbuf) {
+    command_buffer_pair = PAIRS;
+    if (!supported) {
+        return;
+    }
+    if (pending > 0) {
+        Collect();
+    }
+    if (!Doris::Perf::Enabled()) {
+        return;
+    }
+    command_buffer_pair = AcquirePair(Doris::Perf::GpuPart::Total);
+    if (command_buffer_pair < PAIRS) {
+        cmdbuf.WriteTimestamp(VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, *pool, command_buffer_pair * 2);
+    }
+}
+
+void DorisGpuTimer::EndCommandBuffer(vk::CommandBuffer cmdbuf) {
+    if (command_buffer_pair >= PAIRS) {
+        return;
+    }
+    // A region still open when the command buffer ends is closed here (its start was already
+    // written, so the queries can't simply be handed out again without a reset).
+    for (auto& region : region_pairs) {
+        if (region < PAIRS) {
+            cmdbuf.WriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, *pool, region * 2 + 1);
+            pairs[region].state = PairState::Pending;
+            ++pending;
+            region = PAIRS;
+        }
+    }
+    cmdbuf.WriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, *pool,
+                          command_buffer_pair * 2 + 1);
+    pairs[command_buffer_pair].state = PairState::Pending;
+    ++pending;
+    command_buffer_pair = PAIRS;
+}
+
+void DorisGpuTimer::BeginRegion(vk::CommandBuffer cmdbuf, Doris::Perf::GpuPart part) {
+    auto& region = region_pairs[static_cast<size_t>(part)];
+    if (command_buffer_pair >= PAIRS || region < PAIRS) {
+        return;
+    }
+    region = AcquirePair(part);
+    if (region < PAIRS) {
+        // Bottom of pipe: the region starts once the work recorded before it has finished.
+        cmdbuf.WriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, *pool, region * 2);
+    }
+}
+
+void DorisGpuTimer::EndRegion(vk::CommandBuffer cmdbuf, Doris::Perf::GpuPart part) {
+    auto& region = region_pairs[static_cast<size_t>(part)];
+    if (region >= PAIRS) {
+        return;
+    }
+    cmdbuf.WriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, *pool, region * 2 + 1);
+    pairs[region].state = PairState::Pending;
+    ++pending;
+    region = PAIRS;
+}
+
+} // namespace Vulkan
