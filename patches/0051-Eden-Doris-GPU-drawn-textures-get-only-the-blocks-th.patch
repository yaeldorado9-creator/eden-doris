+    // Unswizzle as Eden's upload does, then copy only the blocks in the ranges (all of it if
+    // that would take too many copies).
+    constexpr size_t MAX_COPIES = 8192;
+    auto staging = runtime.UploadStagingBuffer(MapSizeBytes(image));
+    Tegra::Memory::GpuGuestMemory<u8, Tegra::Memory::GuestMemoryFlags::UnsafeRead> swizzle_data(
+        *gpu_memory, image.gpu_addr, image.guest_size_bytes, &swizzle_data_buffer);
+    const auto level_copies = FixSmallVectorADL(
+        UnswizzleImage(*gpu_memory, image.gpu_addr, image.info, swizzle_data, staging.mapped_span));
+    const auto copies = DorisGobCopies(image.info, level_copies, ranges, MAX_COPIES);
+    if (!copies) {
+        image.UploadMemory(staging, level_copies);
+        Doris::Perf::Add(Doris::Perf::Count::TexturePartialUploads);
+    } else if (!copies->empty()) {
+        image.UploadMemory(staging, *copies);
+        Doris::Perf::Add(Doris::Perf::Count::TexturePartialUploads);
+        Doris::Perf::Add(Doris::Perf::Count::TexturePartialBlocks, copies->size());
+    }
