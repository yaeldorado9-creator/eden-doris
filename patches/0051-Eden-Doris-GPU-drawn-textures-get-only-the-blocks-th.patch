+std::optional<std::vector<BufferImageCopy>> DorisGobCopies(
+    const ImageInfo& info, std::span<const BufferImageCopy> level_copies,
+    std::span<const std::pair<u32, u32>> ranges, size_t max_copies) {
+    if (info.type != ImageType::e2D || info.tile_width_spacing != 0 || info.num_samples != 1 ||
+        info.size.depth != 1 || info.block.width != 0 || info.block.depth != 0) {
+        return std::nullopt;
+    }
+    const u32 bpp_log2 = BytesPerBlockLog2(info.format);
+    const Extent2D tile_size = DefaultBlockSize(info.format);
+    const LevelInfo level_info = MakeLevelInfo(info);
+    const u32 num_layers = static_cast<u32>(info.resources.layers);
+    const u32 num_levels = static_cast<u32>(info.resources.levels);
+    if (num_levels == 0 || num_levels > MAX_MIP_LEVELS || level_copies.size() != num_levels) {
+        return std::nullopt;
+    }
+    // The same per-level layout UnswizzleImage reads the guest data with.
+    const std::array level_sizes = CalculateLevelSizes(level_info, num_levels);
+    const Extent2D gob = GobSize(bpp_log2, info.block.height, info.tile_width_spacing);
+    const u32 layer_size = CalculateLevelBytes(level_sizes, num_levels);
+    const u32 layer_stride = AlignLayerSize(layer_size, info.size, level_info.block,
+                                            tile_size.height, info.tile_width_spacing);
+    struct Level {
+        u32 guest_offset;
+        u32 guest_size;
+        u32 tiles_width;
+        u32 tiles_height;
+        u32 block_height;
+        u32 block_size;
+        u32 host_bytes_per_layer;
+        u32 host_row_tiles;
+        Extent3D size;
+    };
+    std::array<Level, MAX_MIP_LEVELS> levels{};
+    u32 guest_offset = 0;
+    for (u32 level = 0; level < num_levels; ++level) {
+        const Extent3D level_size = AdjustMipSize(info.size, static_cast<s32>(level));
+        const Extent3D num_tiles = AdjustTileSize(level_size, tile_size);
+        const Extent3D block =
+            AdjustMipBlockSize(num_tiles, level_info.block, level, level_info.num_levels);
+        if (block.depth != 0 || num_tiles.depth != 1) {
+            return std::nullopt;
+        }
+        const u32 stride_alignment = StrideAlignment(num_tiles, info.block, gob, bpp_log2);
+        const u32 stride = Common::AlignUpLog2(num_tiles.width, stride_alignment) << bpp_log2;
+        const u32 gobs_in_x = Common::DivCeilLog2(stride, GOB_SIZE_X_SHIFT);
+        const BufferImageCopy& level_copy = level_copies[level];
+        if (level_copy.image_subresource.base_level != static_cast<s32>(level) ||
+            level_copy.buffer_row_length % tile_size.width != 0) {
+            return std::nullopt;
+        }
+        levels[level] = Level{
+            .guest_offset = guest_offset,
+            .guest_size = level_sizes[level],
+            .tiles_width = num_tiles.width,
+            .tiles_height = num_tiles.height,
+            .block_height = block.height,
+            .block_size = gobs_in_x << (GOB_SIZE_SHIFT + block.height),
+            .host_bytes_per_layer = NumBlocks(level_size, tile_size) << bpp_log2,
+            .host_row_tiles = level_copy.buffer_row_length / tile_size.width,
+            .size = level_size,
+        };
+        guest_offset += level_sizes[level];
+    }
+    // GOB-aligned, sorted and merged, so that no GOB is visited twice.
+    std::vector<std::pair<u64, u64>> merged;
+    merged.reserve(ranges.size());
+    for (const auto& [range_begin, range_end] : ranges) {
+        if (range_begin < range_end) {
+            merged.emplace_back(u64{range_begin} & ~u64{GOB_SIZE - 1},
+                                Common::AlignUp(u64{range_end}, u64{GOB_SIZE}));
+        }
+    }
+    std::ranges::sort(merged);
+    size_t merged_count = 0;
+    for (const auto& range : merged) {
+        if (merged_count > 0 && range.first <= merged[merged_count - 1].second) {
+            merged[merged_count - 1].second = (std::max)(merged[merged_count - 1].second, range.second);
+        } else {
+            merged[merged_count++] = range;
+        }
+    }
+    merged.resize(merged_count);
+    std::vector<BufferImageCopy> copies;
+    for (const auto& [range_begin, range_end] : merged) {
+        for (u64 offset = range_begin; offset < range_end; offset += GOB_SIZE) {
+            const u64 layer = offset / layer_stride;
+            if (layer >= num_layers) {
+                break;
+            }
+            const u32 in_layer = static_cast<u32>(offset % layer_stride);
+            u32 level = 0;
+            while (level < num_levels &&
+                   in_layer >= levels[level].guest_offset + levels[level].guest_size) {
+                ++level;
+            }
+            if (level == num_levels) {
+                continue; // Padding after the last level.
+            }
+            const Level& lv = levels[level];
+            const u32 in_level = in_layer - lv.guest_offset;
+            const u32 block_row = in_level / lv.block_size;
+            const u32 in_block_row = in_level % lv.block_size;
+            const u32 gob_x = in_block_row >> (GOB_SIZE_SHIFT + lv.block_height);
+            const u32 gob_in_block = (in_block_row >> GOB_SIZE_SHIFT) & ((1U << lv.block_height) - 1);
+            const u32 gob_y = (block_row << lv.block_height) + gob_in_block;
+            const u32 x0 = (gob_x << GOB_SIZE_X_SHIFT) >> bpp_log2;
+            const u32 y0 = gob_y << GOB_SIZE_Y_SHIFT;
+            if (x0 >= lv.tiles_width || y0 >= lv.tiles_height) {
+                continue; // Alignment padding of the level.
+            }
+            const u32 x1 = (std::min)(x0 + (GOB_SIZE_X >> bpp_log2), lv.tiles_width);
+            const u32 y1 = (std::min)(y0 + GOB_SIZE_Y, lv.tiles_height);
+            const BufferImageCopy& level_copy = level_copies[level];
+            const u32 texel_x = x0 * tile_size.width;
+            const u32 texel_y = y0 * tile_size.height;
+            // The GOBs of a block follow each other downwards: extend the previous copy.
+            if (!copies.empty()) {
+                BufferImageCopy& last = copies.back();
+                if (last.image_subresource.base_level == static_cast<s32>(level) &&
+                    last.image_subresource.base_layer == static_cast<s32>(layer) &&
+                    last.image_offset.x == static_cast<s32>(texel_x) &&
+                    last.image_offset.y + static_cast<s32>(last.image_extent.height) ==
+                        static_cast<s32>(texel_y) &&
+                    last.image_extent.width ==
+                        (std::min)(x1 * tile_size.width, lv.size.width) - texel_x) {
+                    last.image_extent.height =
+                        (std::min)(y1 * tile_size.height, lv.size.height) -
+                        static_cast<u32>(last.image_offset.y);
+                    const u32 last_y0 = static_cast<u32>(last.image_offset.y) / tile_size.height;
+                    last.buffer_size =
+                        (static_cast<size_t>(y1 - last_y0 - 1) * lv.host_row_tiles + (x1 - x0))
+                        << bpp_log2;
+                    continue;
+                }
+            }
+            if (copies.size() >= max_copies) {
+                return std::nullopt;
+            }
+            copies.push_back(BufferImageCopy{
+                .buffer_offset = level_copy.buffer_offset + layer * lv.host_bytes_per_layer +
+                                 ((static_cast<size_t>(y0) * lv.host_row_tiles + x0) << bpp_log2),
+                .buffer_size = (static_cast<size_t>(y1 - y0 - 1) * lv.host_row_tiles + (x1 - x0))
+                               << bpp_log2,
+                .buffer_row_length = level_copy.buffer_row_length,
+                .buffer_image_height = level_copy.buffer_image_height,
+                .image_subresource =
+                    {
+                        .base_level = static_cast<s32>(level),
+                        .base_layer = static_cast<s32>(layer),
+                        .num_layers = 1,
+                    },
+                .image_offset = {static_cast<s32>(texel_x), static_cast<s32>(texel_y), 0},
+                .image_extent =
+                    {
+                        (std::min)(x1 * tile_size.width, lv.size.width) - texel_x,
+                        (std::min)(y1 * tile_size.height, lv.size.height) - texel_y,
+                        1,
+                    },
+            });
+        }
+    }
+    return copies;
+}
