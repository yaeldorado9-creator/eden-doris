+// SPDX-FileCopyrightText: Copyright 2026 Eden (Doris)
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+namespace Doris::Cores {
+
+enum class Role {
+    /// Eden's main GPU emulation thread: the busiest single thread, gets the fastest core.
+    Gpu,
+    /// Other heavy emulator threads (emulated CPU cores, Vulkan worker, presentation, fences,
+    /// timing): the remaining big cores, so they don't share the fastest one with the GPU thread.
+    Worker,
+};
+
+/// Pins the calling thread according to the "Core layout" setting. Does nothing when the setting
+/// is off, on a single-cluster CPU, or on platforms without sched_setaffinity.
+void PinCurrentThread(Role role);
+
+} // namespace Doris::Cores
