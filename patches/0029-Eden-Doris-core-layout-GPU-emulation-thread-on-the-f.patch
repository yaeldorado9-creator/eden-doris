+// SPDX-FileCopyrightText: Copyright 2026 Eden (Doris)
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "common/doris_cores.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#if defined(__linux__) || defined(__ANDROID__)
+#include <sched.h>
+#define DORIS_CORES_AFFINITY 1
+#endif
+
+#include <fmt/format.h>
+
+#include "common/logging.h"
+#include "common/settings.h"
+
+namespace Doris::Cores {
+namespace {
+
+struct Layout {
+    std::vector<int> gpu;    // cores for Role::Gpu
+    std::vector<int> worker; // cores for Role::Worker
+    bool valid{};
+};
+
+std::string ReadFirstLine(const std::string& path) {
+    std::ifstream file(path);
+    std::string line;
+    if (file) {
+        std::getline(file, line);
+    }
+    return line;
+}
+
+/// "0 1 2" or "0-2" or "0-2,4" -> {0,1,2,(4)}
+std::vector<int> ParseCpuList(std::string text) {
+    std::replace(text.begin(), text.end(), ',', ' ');
+    std::vector<int> cpus;
+    std::istringstream stream(text);
+    for (std::string token; stream >> token;) {
+        const size_t dash = token.find('-');
+        if (dash == std::string::npos) {
+            cpus.push_back(std::atoi(token.c_str()));
+        } else {
+            const int first = std::atoi(token.substr(0, dash).c_str());
+            const int last = std::atoi(token.substr(dash + 1).c_str());
+            for (int cpu = first; cpu <= last; ++cpu) {
+                cpus.push_back(cpu);
+            }
+        }
+    }
+    return cpus;
+}
+
+std::string Describe(const std::vector<int>& cpus) {
+    std::string out;
+    for (const int cpu : cpus) {
+        out += fmt::format("{}{}", out.empty() ? "" : ",", cpu);
+    }
+    return out;
+}
+
+/// Groups the cores into clusters by maximum frequency (from cpufreq policies). With three or
+/// more clusters (prime / middle / little, as on Snapdragon 8 Gen 2) the GPU thread gets the
+/// fastest cluster and the workers get the middle ones. With two clusters, both roles share the
+/// big cluster. With one, there is nothing to do.
+Layout DetectLayout() {
+    struct Cluster {
+        long long max_freq{};
+        std::vector<int> cpus;
+    };
+    std::vector<Cluster> clusters;
+    for (int policy = 0; policy < 16; ++policy) {
+        const std::string base = fmt::format("/sys/devices/system/cpu/cpufreq/policy{}/", policy);
+        const std::string related = ReadFirstLine(base + "related_cpus");
+        if (related.empty()) {
+            continue;
+        }
+        Cluster cluster;
+        cluster.max_freq = std::atoll(ReadFirstLine(base + "cpuinfo_max_freq").c_str());
+        cluster.cpus = ParseCpuList(related);
+        if (!cluster.cpus.empty()) {
+            clusters.push_back(std::move(cluster));
+        }
+    }
+    Layout layout;
+    if (clusters.size() < 2) {
+        return layout;
+    }
+    std::ranges::sort(clusters, [](const Cluster& a, const Cluster& b) {
+        return a.max_freq > b.max_freq;
+    });
+    if (clusters.size() >= 3) {
+        layout.gpu = clusters.front().cpus;
+        for (size_t i = 1; i + 1 < clusters.size(); ++i) {
+            layout.worker.insert(layout.worker.end(), clusters[i].cpus.begin(),
+                                 clusters[i].cpus.end());
+        }
+    } else {
+        layout.gpu = clusters.front().cpus;
+        layout.worker = clusters.front().cpus;
+    }
+    layout.valid = !layout.gpu.empty() && !layout.worker.empty();
+    if (layout.valid) {
+        LOG_INFO(Frontend, "Doris cores: GPU thread on cpu {}, other emulator threads on cpu {}",
+                 Describe(layout.gpu), Describe(layout.worker));
+    }
+    return layout;
+}
+
+} // Anonymous namespace
+
+void PinCurrentThread(Role role) {
+#ifdef DORIS_CORES_AFFINITY
+    if (Settings::values.doris_core_layout.GetValue() == 0) {
+        return;
+    }
+    static std::once_flag detect_flag;
+    static Layout layout;
+    std::call_once(detect_flag, [] { layout = DetectLayout(); });
+    if (!layout.valid) {
+        return;
+    }
+    const std::vector<int>& cpus = role == Role::Gpu ? layout.gpu : layout.worker;
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    for (const int cpu : cpus) {
+        CPU_SET(cpu, &set);
+    }
+    if (sched_setaffinity(0, sizeof(set), &set) != 0) {
+        LOG_WARNING(Frontend, "Doris cores: could not pin thread to cpu {}", Describe(cpus));
+    }
+#else
+    (void)role;
+#endif
+}
+
+} // namespace Doris::Cores
