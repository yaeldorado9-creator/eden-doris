+            if (doris_read_protected.erase(page) == 0) {
+                return false;
+            }
+        }
+        Doris::Perf::Add(is_write ? Doris::Perf::Count::NceGpuPageWrites
+                                  : Doris::Perf::Count::NceGpuPageReads);
+        // Copy what the GPU drew there into guest memory (Eden's reactive flushing: the first
+        // time it waits for the GPU; afterwards the texture is copied at fences).
+        {
+            const Doris::Perf::ScopedWait doris_wait{Doris::Perf::Wait::NceGpuReads, true};
+            const u8* const pointer = GetPointerImpl(page << YUZU_PAGEBITS, [] {}, [] {});
+            if (pointer != nullptr) {
+                if (!gpu_device_memory) [[unlikely]] {
