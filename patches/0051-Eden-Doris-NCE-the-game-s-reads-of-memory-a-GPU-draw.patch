+    void DorisProtectFromReads(u64 vaddr, u64 size) {
+        if (size == 0 || !DorisReadsActive() ||
+            !AddressSpaceContains(*current_page_table, vaddr, size)) {
+            return;
+        }
+        std::scoped_lock lock{doris_reads_mutex};
+        u64 run_begin = 0;
+        u64 run_pages = 0;
+        const auto protect_run = [&] {
+            if (run_pages == 0) {
+                return;
+            }
+            host_buffer->Protect(run_begin << YUZU_PAGEBITS, run_pages << YUZU_PAGEBITS,
+                                 Common::MemoryPermission{});
+            Doris::Perf::Add(Doris::Perf::Count::ProtectCalls);
+            Doris::Perf::Add(Doris::Perf::Count::NceReadProtectedPages, run_pages);
+            run_pages = 0;
+        };
+        const u64 first = vaddr >> YUZU_PAGEBITS;
+        const u64 last = (vaddr + size - 1) >> YUZU_PAGEBITS;
+        for (u64 page = first; page <= last; ++page) {
+            // Only pages the GPU caches track (written to by the game they become plain memory,
+            // readable and writable, and the caches forget them).
+            const bool cached = current_page_table->entries[page].ptr.Type() ==
+                                Common::PageType::RasterizerCachedMemory;
+            if (!cached || !doris_read_protected.insert(page).second) {
+                protect_run();
+                continue;
+            }
+            if (run_pages != 0 && run_begin + run_pages != page) {
+                protect_run();
+            }
+            if (run_pages == 0) {
+                run_begin = page;
+            }
+            ++run_pages;
+        }
