+template <typename Traits>
+void DeviceMemoryManager<Traits>::DorisProtectFromReads(DAddr addr, size_t size) {
+    if (size == 0) {
+        return;
+    }
+    const auto Protect = &DeviceMemoryManager<Traits>::DeviceMethods::DorisProtectFromReads;
+    const size_t page_end = Common::DivCeil(addr + size, Memory::YUZU_PAGESIZE);
+    size_t page = addr >> Memory::YUZU_PAGEBITS;
+    auto [asid, base_vaddress] = ExtractCPUBacking(page);
+    auto* memory_device_inter = registered_processes[asid.id];
+    u64 run_begin = 0;
+    u64 run_pages = 0;
+    const auto release = [&] {
+        if (run_pages > 0 && memory_device_inter != nullptr) {
+            Protect(memory_device_inter, run_begin << Memory::YUZU_PAGEBITS,
+                    run_pages << Memory::YUZU_PAGEBITS);
+        }
+        run_pages = 0;
+    };
+    for (; page != page_end; ++page) {
+        auto [asid_2, vpage] = ExtractCPUBacking(page);
+        vpage >>= Memory::YUZU_PAGEBITS;
+        if (vpage == 0) [[unlikely]] {
+            release();
+            continue;
+        }
+        if (asid.id != asid_2.id) [[unlikely]] {
+            release();
+            asid = asid_2;
+            memory_device_inter = registered_processes[asid_2.id];
+        }
+        if (run_pages != 0 && run_begin + run_pages != vpage) {
+            release();
+        }
+        if (run_pages == 0) {
+            run_begin = vpage;
+        }
+        ++run_pages;
+    }
+    release();
+}
