+/// Eden (Doris): whether an access fault was a write, from the ESR the kernel puts in the signal
+/// frame (data abort: WnR bit). Unknown counts as a write (what Eden always assumed).
+bool DorisIsWriteFault(void* raw_context) {
+    // Records in the signal frame's reserved area: {magic, size} headers (Linux arm64).
+    struct Header {
+        u32 magic;
+        u32 size;
+    };
+    constexpr u32 ESR_RECORD_MAGIC = 0x45535201;
+    const auto* context = static_cast<const ucontext_t*>(raw_context);
+    const auto* begin = reinterpret_cast<const u8*>(&context->uc_mcontext.__reserved[0]);
+    const auto* end = begin + sizeof(context->uc_mcontext.__reserved);
+    for (const u8* record = begin; record + sizeof(Header) <= end;) {
+        Header header;
+        std::memcpy(&header, record, sizeof(header));
+        if (header.magic == 0 || header.size < sizeof(Header) ||
+            record + header.size > end) {
+            break;
+        }
+        if (header.magic == ESR_RECORD_MAGIC && header.size >= sizeof(Header) + sizeof(u64)) {
+            u64 esr;
+            std::memcpy(&esr, record + sizeof(Header), sizeof(esr));
+            const u64 exception_class = esr >> 26;
+            if (exception_class == 0x24 || exception_class == 0x25) {
+                return ((esr >> 6) & 1) != 0;
+            }
+            return true;
+        }
+        record += header.size;
+    }
+    return true;
+}
