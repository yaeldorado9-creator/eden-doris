+                }
+                thread_local Common::ScratchBuffer<u32> doris_scratch;
+                gpu_device_memory->ApplyOpOnPointer(pointer, doris_scratch, [&](DAddr address) {
+                    system.GPU().OnCPURead(address, YUZU_PAGESIZE);
