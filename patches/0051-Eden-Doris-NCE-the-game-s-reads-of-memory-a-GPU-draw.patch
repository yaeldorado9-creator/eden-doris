+    /// Called with doris_reads_mutex held, after the region's caching changed.
+    void DorisAfterCachingChange(u64 vaddr, u64 size, bool cached) {
+        const u64 first = vaddr >> YUZU_PAGEBITS;
+        const u64 last = (vaddr + size - 1) >> YUZU_PAGEBITS;
+        for (u64 page = first; page <= last; ++page) {
+            if (!doris_read_protected.contains(page)) {
+                continue;
+            }
+            if (!cached) {
+                // Not cached any more: readable and writable again, nothing to protect.
+                doris_read_protected.erase(page);
+            } else {
+                // Still holds a drawing that isn't in guest memory: keep it unreadable.
+                host_buffer->Protect(page << YUZU_PAGEBITS, YUZU_PAGESIZE,
+                                     Common::MemoryPermission{});
