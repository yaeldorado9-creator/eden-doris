From be468a184189857dbb255d4141c1259e72c11d79 Mon Sep 17 00:00:00 2001
From: alvindimas05 <alvin.dimas.praditya@gmail.com>
Date: Fri, 23 Oct 2026 11:10:26 +0700
Subject: [PATCH 22/49] [video_core] fast path single-page unsafe reads and
 descriptor compares

(cherry picked from commit f17510e6926d99fb9a4acf67a959432a2218a957)
---
 src/video_core/memory_manager.cpp               | 15 +++++++++++++++
 src/video_core/texture_cache/descriptor_table.h |  9 ++++++++-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/video_core/memory_manager.cpp b/src/video_core/memory_manager.cpp
index 6f3b064a0..77b15c158 100644
--- a/src/video_core/memory_manager.cpp
+++ b/src/video_core/memory_manager.cpp
@@ -452,6 +452,21 @@ void MemoryManager::ReadBlockImpl(GPUVAddr gpu_src_addr, void* dest_buffer, std:
         GPUVAddr base = (page_index << big_page_bits) + offset;
         MemoryOperation(base, copy_amount, false, mapped_normal, set_to_zero, set_to_zero);
     };
+    // Small single-big-page reads are the common case for descriptor tables; skip the
+    // page-walking machinery entirely when the whole range is inside one continuous big page.
+    if (unsafe && size != 0 && size <= page_size &&
+        (gpu_src_addr >> big_page_bits) == ((gpu_src_addr + size - 1) >> big_page_bits)) {
+        const size_t big_index = PageEntryIndex(gpu_src_addr, true);
+        if (GetEntry(gpu_src_addr, true) == EntryType::Mapped && IsBigPageContinuous(big_index)) {
+            const DAddr host_addr =
+                (DAddr(big_page_table_dev[big_index]) << cpu_page_bits) + (gpu_src_addr & big_page_mask);
+            const u8* physical = memory.GetPointer<u8>(host_addr);
+            if (physical != nullptr) {
+                std::memcpy(dest_buffer, physical, size);
+                return;
+            }
+        }
+    }
     MemoryOperation(gpu_src_addr, size, true, mapped_big, set_to_zero, read_short_pages);
 }
 
diff --git a/src/video_core/texture_cache/descriptor_table.h b/src/video_core/texture_cache/descriptor_table.h
index e40c128ab..80d25ad55 100644
--- a/src/video_core/texture_cache/descriptor_table.h
+++ b/src/video_core/texture_cache/descriptor_table.h
@@ -39,7 +39,14 @@ public:
         std::pair<T, bool> result;
         gpu_memory.ReadBlockUnsafe(gpu_addr, std::addressof(result.first), sizeof(T));
         if ((read_descriptors[index / 64] & (1ULL << (index % 64))) != 0) {
-            result.second = result.first != descriptors[index];
+            if constexpr (sizeof(T) == 32 && alignof(T) >= 8 && std::is_trivially_copyable_v<T>) {
+                const auto* lhs = reinterpret_cast<const u64*>(std::addressof(result.first));
+                const auto* rhs = reinterpret_cast<const u64*>(std::addressof(descriptors[index]));
+                result.second = ((lhs[0] ^ rhs[0]) | (lhs[1] ^ rhs[1]) |
+                                 (lhs[2] ^ rhs[2]) | (lhs[3] ^ rhs[3])) != 0;
+            } else {
+                result.second = result.first != descriptors[index];
+            }
         } else {
             read_descriptors[index / 64] |= 1ULL << (index % 64);
             result.second = true;
-- 
